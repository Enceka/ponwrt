@@ -539,6 +540,7 @@
 
 	/* Updated from RX path only, no locking requirements */
 	struct ieee80211_sta_rx_stats rx_stats;
+	unsigned long last_rx_hw;
 	struct {
 		struct ewma_signal signal;
 		struct ewma_signal chain_signal[IEEE80211_MAX_CHAINS];
