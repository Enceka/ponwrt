From: Enceka <enceka@yeah.net>
Subject: [PATCH] wifi: mt76: test HG5585F-CT slot 1 cold ownership

Prepare the two radio TX queues and WA0 with both HIFs stopped. Reserve
the stock high token range while the lease is held, request the exclusive
IRQ disabled, then release the unstarted lease and restore native TX.
Keep hardware activation gated on fabric drain and unbind isolation.

diff --git a/mt7915/Makefile b/mt7915/Makefile
index 3d393e5..1ab027c 100644
--- a/mt7915/Makefile
+++ b/mt7915/Makefile
@@ -7,6 +7,9 @@ mt7915e-y := pci.o init.o dma.o eeprom.o main.o mcu.o mac.o \
 	     debugfs.o mmio.o
 
 mt7915e-$(CONFIG_NL80211_TESTMODE) += testmode.o
-mt7915e-$(CONFIG_MT7915_NPU) += npu.o
+mt7915e-$(CONFIG_MT7915_NPU) += npu.o ct_wed.o
+obj-m += ct_wed_platform.o ct_wed_guard_v2.o
+ct_wed_platform-y := ct-wed/ct_wed_platform.o
+ct_wed_guard_v2-y := ct-wed/ct_wed_guard_v2.o
 mt7915e-$(CONFIG_MT798X_WMAC) += soc.o
 mt7915e-$(CONFIG_DEV_COREDUMP) += coredump.o
diff --git a/mt7915/ct-wed-provider-abi.h b/mt7915/ct-wed-provider-abi.h
new file mode 100644
index 0000000..96c382b
--- /dev/null
+++ b/mt7915/ct-wed-provider-abi.h
@@ -0,0 +1,47 @@
+#ifndef __AIROHA_CT_WED_PROVIDER_V1_H
+#define __AIROHA_CT_WED_PROVIDER_V1_H
+
+#include <linux/io.h>
+#include <linux/types.h>
+
+struct device;
+struct airoha_ct_wed;
+
+enum airoha_ct_wed_ring_id {
+	AIROHA_CT_WED_TX0,
+	AIROHA_CT_WED_TX1,
+	AIROHA_CT_WED_WA0,
+	AIROHA_CT_WED_RING_COUNT,
+};
+
+struct airoha_ct_wed_ring {
+	dma_addr_t desc;
+	u32 count, cidx, didx;
+};
+
+struct airoha_ct_wed_plan {
+	resource_size_t bar, bar_len;
+	u32 host_token_start, host_token_count;
+	struct airoha_ct_wed_ring ring[AIROHA_CT_WED_RING_COUNT];
+};
+
+struct airoha_ct_wed_view {
+	void __iomem *csr[AIROHA_CT_WED_RING_COUNT];
+	int irq;
+};
+
+struct airoha_ct_wed_ops {
+	struct airoha_ct_wed *(*get)(struct device *radio);
+	void (*put)(struct airoha_ct_wed *wed);
+	int (*acquire)(struct airoha_ct_wed *wed, const struct airoha_ct_wed_plan *plan,
+		       struct airoha_ct_wed_view *view);
+	int (*start)(struct airoha_ct_wed *wed);
+	void (*stop)(struct airoha_ct_wed *wed);
+	void (*release)(struct airoha_ct_wed *wed);
+	void (*irq_mask)(struct airoha_ct_wed *wed, u32 mask);
+	u32 (*irq_ack)(struct airoha_ct_wed *wed, u32 mask);
+};
+
+extern const struct airoha_ct_wed_ops airoha_ct_wed_ops_v1;
+
+#endif
diff --git a/mt7915/ct-wed-provider-v2.h b/mt7915/ct-wed-provider-v2.h
new file mode 100644
index 0000000..b134f4d
--- /dev/null
+++ b/mt7915/ct-wed-provider-v2.h
@@ -0,0 +1,39 @@
+#ifndef __AIROHA_CT_WED_PROVIDER_V2_H
+#define __AIROHA_CT_WED_PROVIDER_V2_H
+
+#include "ct-wed-provider-abi.h"
+
+struct airoha_ct_wed_lease_v2;
+
+enum airoha_ct_wed_fence_v2 {
+	AIROHA_CT_WED_INGRESS_BLOCKED = 1U << 0,
+	AIROHA_CT_WED_WDMA_IDLE = 1U << 1,
+	AIROHA_CT_WED_WPDMA_IDLE = 1U << 2,
+	AIROHA_CT_WED_TXFREE_IDLE = 1U << 3,
+	AIROHA_CT_WED_BUS_DRAINED = 1U << 4,
+};
+
+#define AIROHA_CT_WED_REQUIRED_FENCES_V2 \
+	(AIROHA_CT_WED_INGRESS_BLOCKED | AIROHA_CT_WED_WDMA_IDLE | \
+	 AIROHA_CT_WED_WPDMA_IDLE | AIROHA_CT_WED_TXFREE_IDLE | AIROHA_CT_WED_BUS_DRAINED)
+
+struct airoha_ct_wed_drain_v2 {
+	u32 fences;
+};
+
+struct airoha_ct_wed_ops_v2 {
+	struct airoha_ct_wed *(*get)(struct device *radio);
+	void (*put)(struct airoha_ct_wed *wed);
+	int (*acquire)(struct airoha_ct_wed *wed, const struct airoha_ct_wed_plan *plan,
+		       struct airoha_ct_wed_view *view, struct airoha_ct_wed_lease_v2 **lease);
+	int (*start_masked)(struct airoha_ct_wed_lease_v2 *lease);
+	int (*quiesce)(struct airoha_ct_wed_lease_v2 *lease,
+		       struct airoha_ct_wed_drain_v2 *result);
+	int (*release)(struct airoha_ct_wed_lease_v2 *lease);
+	void (*irq_mask)(struct airoha_ct_wed_lease_v2 *lease, u32 mask);
+	u32 (*irq_ack)(struct airoha_ct_wed_lease_v2 *lease, u32 mask);
+};
+
+extern const struct airoha_ct_wed_ops_v2 airoha_ct_wed_ops_v2;
+
+#endif
diff --git a/mt7915/ct_wed.c b/mt7915/ct_wed.c
new file mode 100644
index 0000000..cad0ad5
--- /dev/null
+++ b/mt7915/ct_wed.c
@@ -0,0 +1,326 @@
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pci.h>
+#include "mt7915.h"
+#include "../dma.h"
+#include "ct-wed-provider-v2.h"
+
+enum mt7915_ct_owner { CT_PREPARED, CT_SWITCHING, CT_WED, CT_QUIESCING, CT_RETAINED };
+
+struct mt7915_ct_wed {
+	struct mt7915_dev *dev;
+	const struct airoha_ct_wed_ops_v2 *ops;
+	struct airoha_ct_wed *handle;
+	struct airoha_ct_wed_lease_v2 *lease;
+	enum mt7915_ct_owner owner;
+	u32 token_start, token_count;
+	bool tokens_split;
+	struct airoha_ct_wed_view view;
+	struct mt76_queue *queue[AIROHA_CT_WED_RING_COUNT];
+	struct mt76_queue_regs __iomem *native[AIROHA_CT_WED_RING_COUNT];
+};
+
+static const struct {
+	u32 native, wed;
+} mt7916_ct_irq_bits[] = {
+	{ MT_INT_TX_DONE_BAND0, MT_INT_WED_TX_DONE_BAND0 },
+	{ MT_INT_TX_DONE_BAND1, MT_INT_WED_TX_DONE_BAND1 },
+	{ MT_INT_RX_DONE_WA_MAIN_MT7916, MT_INT_WED_RX_DONE_WA_MAIN_MT7916 },
+	{ MT_INT_RX_DONE_WA, MT_INT_WED_RX_DONE_WA_MT7916 },
+	{ MT_INT_RX_DONE_BAND0_MT7916, MT_INT_WED_RX_DONE_BAND0_MT7916 },
+	{ MT_INT_RX_DONE_BAND1_MT7916, MT_INT_WED_RX_DONE_BAND1_MT7916 },
+};
+
+static u32 mt7915_ct_irq_translate(u32 mask, bool to_wed)
+{
+	u32 mapped = 0, used = MT_INT_RX_DONE_WA_EXT_MT7916;
+	unsigned int index;
+
+	for (index = 0; index < ARRAY_SIZE(mt7916_ct_irq_bits); index++) {
+		u32 native = mt7916_ct_irq_bits[index].native;
+		u32 wed = mt7916_ct_irq_bits[index].wed;
+
+		used |= native | wed;
+		if (mask & (to_wed ? native : wed))
+			mapped |= to_wed ? wed : native;
+	}
+	return (mask & ~used) | mapped;
+}
+
+bool mt7915_ct_wed_mask(struct mt7915_dev *dev, u32 mask)
+{
+	struct mt7915_ct_wed *bridge;
+
+	lockdep_assert_held(&dev->mt76.mmio.irq_lock);
+	bridge = rcu_dereference_protected(dev->ct_wed, lockdep_is_held(&dev->mt76.mmio.irq_lock));
+	if (!bridge || bridge->owner == CT_PREPARED)
+		return false;
+	if (bridge->owner == CT_WED)
+		bridge->ops->irq_mask(bridge->lease, mt7915_ct_irq_translate(mask, true));
+	return true;
+}
+
+bool mt7915_ct_wed_ack(struct mt7915_dev *dev, u32 mask, u32 *pending)
+{
+	struct mt7915_ct_wed *bridge;
+
+	lockdep_assert_held(&dev->mt76.mmio.irq_lock);
+	bridge = rcu_dereference_protected(dev->ct_wed, lockdep_is_held(&dev->mt76.mmio.irq_lock));
+	if (!bridge || bridge->owner == CT_PREPARED)
+		return false;
+	*pending = 0;
+	if (bridge->owner == CT_WED) {
+		u32 irq;
+
+		bridge->ops->irq_mask(bridge->lease, 0);
+		irq = bridge->ops->irq_ack(bridge->lease, mt7915_ct_irq_translate(mask, true));
+		*pending = mt7915_ct_irq_translate(irq, false) & mask;
+	}
+	return true;
+}
+
+bool mt7915_ct_wed_primary_native(struct mt7915_dev *dev)
+{
+	struct mt7915_ct_wed *bridge;
+
+	lockdep_assert_held(&dev->mt76.mmio.irq_lock);
+	bridge = rcu_dereference_protected(dev->ct_wed, lockdep_is_held(&dev->mt76.mmio.irq_lock));
+	return !bridge || bridge->owner == CT_PREPARED;
+}
+
+static void mt7915_ct_wed_put(struct mt7915_ct_wed *bridge)
+{
+	bridge->ops->put(bridge->handle);
+	symbol_put(airoha_ct_wed_ops_v2);
+	kfree(bridge);
+}
+
+static int mt7915_ct_wed_tokens(struct mt7915_ct_wed *bridge, bool split)
+{
+	struct mt76_dev *mdev = &bridge->dev->mt76;
+	int err = 0;
+
+	spin_lock_bh(&mdev->token_lock);
+	if (mdev->token_count || !idr_is_empty(&mdev->token)) {
+		err = -EBUSY;
+		goto out;
+	}
+	if (split) {
+		if (mdev->token_start != 0 || mdev->token_size != MT7915_TOKEN_SIZE) {
+			err = -EINVAL;
+			goto out;
+		}
+		bridge->token_start = mdev->token_start;
+		bridge->token_count = mdev->token_size;
+		mdev->token_start = 8192;
+		mdev->token_size = 4096;
+	} else {
+		if (!bridge->tokens_split || mdev->token_start != 8192 || mdev->token_size != 4096) {
+			err = -ESTALE;
+			goto out;
+		}
+		mdev->token_start = bridge->token_start;
+		mdev->token_size = bridge->token_count;
+	}
+	bridge->tokens_split = split;
+out:
+	spin_unlock_bh(&mdev->token_lock);
+	return err;
+}
+
+static int mt7915_ct_wed_cold(struct mt7915_dev *dev)
+{
+	u32 disabled = MT_WFDMA0_GLO_CFG_TX_DMA_EN | MT_WFDMA0_GLO_CFG_RX_DMA_EN;
+	u32 hif1 = MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0);
+	u16 status;
+	unsigned int index;
+	struct pci_dev *peers[] = { to_pci_dev(dev->mt76.dev), to_pci_dev(dev->hif2->dev) };
+
+	if ((mt76_rr(dev, MT_WFDMA0_GLO_CFG) | mt76_rr(dev, MT_WFDMA0_GLO_CFG + hif1)) & disabled ||
+	    !mt76_poll(dev, MT_WFDMA_EXT_CSR_HIF_MISC, MT_WFDMA_EXT_CSR_HIF_MISC_BUSY, 0, 1000) ||
+	    READ_ONCE(dev->mt76.token_count))
+		return -EBUSY;
+	for (index = 0; index < ARRAY_SIZE(peers); index++) {
+		if (!pci_is_pcie(peers[index]) || pcie_capability_read_word(peers[index], PCI_EXP_DEVSTA, &status) ||
+		    status == 0xffff)
+			return -EIO;
+		if (status & PCI_EXP_DEVSTA_TRPND)
+			return -EAGAIN;
+	}
+	return 0;
+}
+
+int mt7915_ct_wed_verify_drain(struct mt7915_dev *dev)
+{
+	struct mt7915_ct_wed *bridge = rcu_access_pointer(dev->ct_wed);
+	struct airoha_ct_wed_drain_v2 result = {};
+	struct mt76_queue *queue;
+	unsigned int index;
+	u32 producer, consumer;
+	int err;
+
+	if (!bridge || READ_ONCE(bridge->owner) != CT_QUIESCING)
+		return -EINVAL;
+	err = bridge->ops->quiesce(bridge->lease, &result);
+	if (err)
+		return err;
+	if ((result.fences & AIROHA_CT_WED_REQUIRED_FENCES_V2) != AIROHA_CT_WED_REQUIRED_FENCES_V2)
+		return -EUCLEAN;
+	err = mt7915_ct_wed_cold(dev);
+	if (err)
+		return err;
+	for (index = 0; index < AIROHA_CT_WED_WA0; index++) {
+		queue = bridge->queue[index];
+		producer = readl(&queue->regs->cpu_idx);
+		consumer = readl(&queue->regs->dma_idx);
+		if (producer >= queue->ndesc || producer != consumer || producer != queue->head ||
+		    consumer != queue->tail || READ_ONCE(queue->queued))
+			return -EBUSY;
+	}
+	queue = bridge->queue[AIROHA_CT_WED_WA0];
+	consumer = readl(&queue->regs->dma_idx);
+	if (consumer >= queue->ndesc || consumer != queue->tail)
+		return -EBUSY;
+	dma_rmb();
+	if (le32_to_cpu(READ_ONCE(queue->desc[consumer].ctrl)) & MT_DMA_CTL_DMA_DONE)
+		return -EBUSY;
+	return 0;
+}
+
+void mt7915_ct_wed_attach(struct mt7915_dev *dev, struct mt7915_phy *phy2)
+{
+	struct device *device = dev->mt76.dev;
+	struct airoha_ct_wed_plan plan = {};
+	struct mt7915_ct_wed *bridge;
+	struct pci_dev *pdev;
+	unsigned long flags;
+	const char *gate = "native rings";
+	unsigned int index;
+	int err = -EINVAL;
+
+	if (!of_find_property(device->of_node, "airoha,wed-provider", NULL))
+		return;
+	if (!dev->ct_path || !dev->hif2 || !phy2 || !is_mt7916(&dev->mt76) ||
+	    !dev_is_pci(device) || !dev_is_pci(dev->hif2->dev) ||
+	    test_bit(MT76_STATE_INITIALIZED, &dev->mphy.state)) {
+		dev_info(device, "CT WED v2 cold topology unavailable: rx=%u hif2=%u phy2=%u\n",
+			 !!dev->ct_path, !!dev->hif2, !!phy2);
+		return;
+	}
+	pdev = to_pci_dev(device);
+	err = mt7915_ct_wed_cold(dev);
+	if (err || pdev->irq == dev->hif2->irq || phy2->mt76->band_idx != 1 || dev->mphy.band_idx) {
+		dev_info(device, "CT WED v2 cold gate=%d irq=%d/%d bands=%u/%u; native\n", err,
+			 pdev->irq, dev->hif2->irq, dev->mphy.band_idx, phy2->mt76->band_idx);
+		return;
+	}
+	bridge = kzalloc(sizeof(*bridge), GFP_KERNEL);
+	if (!bridge)
+		return;
+	bridge->ops = symbol_get(airoha_ct_wed_ops_v2);
+	if (!bridge->ops) {
+		kfree(bridge);
+		dev_info(device, "CT WED provider absent; native TX\n");
+		return;
+	}
+	if (!bridge->ops->get || !bridge->ops->put || !bridge->ops->acquire ||
+	    !bridge->ops->start_masked || !bridge->ops->quiesce || !bridge->ops->release ||
+	    !bridge->ops->irq_mask || !bridge->ops->irq_ack) {
+		symbol_put(airoha_ct_wed_ops_v2);
+		kfree(bridge);
+		return;
+	}
+	bridge->handle = bridge->ops->get(device);
+	if (IS_ERR_OR_NULL(bridge->handle)) {
+		dev_info(device, "CT WED provider unavailable (%ld); native TX\n",
+			 bridge->handle ? PTR_ERR(bridge->handle) : -ENODEV);
+		symbol_put(airoha_ct_wed_ops_v2);
+		kfree(bridge);
+		return;
+	}
+	bridge->dev = dev;
+	bridge->queue[AIROHA_CT_WED_TX0] = dev->mphy.q_tx[0];
+	bridge->queue[AIROHA_CT_WED_TX1] = phy2->mt76->q_tx[0];
+	bridge->queue[AIROHA_CT_WED_WA0] = &dev->mt76.q_rx[MT_RXQ_MAIN_WA];
+	plan.bar = pci_resource_start(pdev, 0);
+	plan.bar_len = pci_resource_len(pdev, 0);
+	err = -EINVAL;
+	for (index = 0; index < ARRAY_SIZE(bridge->queue); index++) {
+		struct mt76_queue *queue = bridge->queue[index];
+		struct airoha_ct_wed_ring *ring = &plan.ring[index];
+
+		if (!queue || !queue->regs || !queue->desc || !queue->desc_dma ||
+		    upper_32_bits(queue->desc_dma) || queue->ndesc < 2 ||
+		    queue->hw_idx != (index == AIROHA_CT_WED_WA0 ? 2 : 18 + index) ||
+		    mt76_queue_is_npu(queue) || mt76_queue_is_emi(queue) || queue->wed)
+			goto put;
+		bridge->native[index] = queue->regs;
+		ring->desc = queue->desc_dma;
+		ring->count = queue->ndesc;
+		ring->cidx = readl(&queue->regs->cpu_idx);
+		ring->didx = readl(&queue->regs->dma_idx);
+		if (ring->cidx >= ring->count || ring->didx >= ring->count ||
+		    readl(&queue->regs->desc_base) != ring->desc ||
+		    readl(&queue->regs->ring_size) != ring->count ||
+		    (index != AIROHA_CT_WED_WA0 && (ring->cidx != ring->didx || queue->queued)))
+			goto put;
+	}
+	gate = "token partition";
+	err = mt7915_ct_wed_tokens(bridge, true);
+	if (err)
+		goto put;
+	plan.host_token_start = dev->mt76.token_start;
+	plan.host_token_count = dev->mt76.token_size;
+	gate = "acquire";
+	err = bridge->ops->acquire(bridge->handle, &plan, &bridge->view, &bridge->lease);
+	if (err)
+		goto put;
+	if (WARN_ON_ONCE(!bridge->lease))
+		goto put;
+	gate = "view";
+	err = -EINVAL;
+	if (bridge->view.irq <= 0 || bridge->view.irq == pdev->irq || bridge->view.irq == dev->hif2->irq)
+		goto release;
+	for (index = 0; index < ARRAY_SIZE(bridge->queue); index++) {
+		unsigned int prev;
+
+		if (IS_ERR_OR_NULL(bridge->view.csr[index]))
+			goto release;
+		for (prev = 0; prev < index; prev++)
+			if (bridge->view.csr[index] == bridge->view.csr[prev])
+				goto release;
+	}
+	gate = "fabric fence / unbind isolation missing";
+	err = -EOPNOTSUPP;
+release:
+	if (bridge->ops->release(bridge->lease)) {
+		spin_lock_irqsave(&dev->mt76.mmio.irq_lock, flags);
+		bridge->owner = CT_PREPARED;
+		rcu_assign_pointer(dev->ct_wed, bridge);
+		spin_unlock_irqrestore(&dev->mt76.mmio.irq_lock, flags);
+		dev_err(device, "CT WED v2 unstarted lease retained after release refusal; native IRQ\n");
+		return;
+	}
+put:
+	if (bridge->tokens_split && mt7915_ct_wed_tokens(bridge, false))
+		dev_err(device, "CT WED v2 host tokens remain in high partition\n");
+	dev_info(device, "CT WED v2 cold gate: %s (%d); native TX/WA/IRQ\n", gate, err);
+	mt7915_ct_wed_put(bridge);
+}
+
+void mt7915_ct_wed_detach(struct mt7915_dev *dev)
+{
+	struct mt7915_ct_wed *bridge = rcu_access_pointer(dev->ct_wed);
+	unsigned long flags;
+
+	if (!bridge)
+		return;
+	if (bridge->owner != CT_PREPARED || bridge->ops->release(bridge->lease))
+		return;
+	if (mt7915_ct_wed_tokens(bridge, false))
+		dev_err(dev->mt76.dev, "CT WED v2 host tokens remain in high partition\n");
+	spin_lock_irqsave(&dev->mt76.mmio.irq_lock, flags);
+	RCU_INIT_POINTER(dev->ct_wed, NULL);
+	spin_unlock_irqrestore(&dev->mt76.mmio.irq_lock, flags);
+	mt7915_ct_wed_put(bridge);
+}
diff --git a/mt7915/dma.c b/mt7915/dma.c
index 0ed81c5..4934dc6 100644
--- a/mt7915/dma.c
+++ b/mt7915/dma.c
@@ -176,6 +176,7 @@ void mt7915_dma_disable(struct mt7915_dev *dev, bool rst)
 
 	if (dev->hif2)
 		hif1_ofs = MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0);
+	mt7915_ct_wed_detach(dev);
 
 	/* reset */
 	if (rst) {
@@ -331,7 +332,7 @@ int mt7915_dma_start(struct mt7915_dev *dev, bool reset, bool wed_reset)
 	return 0;
 }
 
-static int mt7915_dma_enable(struct mt7915_dev *dev, bool reset)
+static int mt7915_dma_enable(struct mt7915_dev *dev, bool reset, struct mt7915_phy *phy2)
 {
 	struct mt76_dev *mdev = &dev->mt76;
 	u32 hif1_ofs = 0;
@@ -399,8 +400,9 @@ static int mt7915_dma_enable(struct mt7915_dev *dev, bool reset)
 				 MT_WFDMA1_PCIE1_BUSY_ENA_RX_FIFO);
 	}
 
-	mt76_poll(dev, MT_WFDMA_EXT_CSR_HIF_MISC,
-		  MT_WFDMA_EXT_CSR_HIF_MISC_BUSY, 0, 1000);
+	mt76_poll(dev, MT_WFDMA_EXT_CSR_HIF_MISC, MT_WFDMA_EXT_CSR_HIF_MISC_BUSY, 0, 1000);
+	if (phy2)
+		mt7915_ct_wed_attach(dev, phy2);
 
 	return mt7915_dma_start(dev, reset, true);
 }
@@ -596,7 +598,7 @@ int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 		return ret;
 	}
 
-	mt7915_dma_enable(dev, false);
+	mt7915_dma_enable(dev, false, phy2);
 
 	return 0;
 }
@@ -607,6 +609,8 @@ int mt7915_dma_reset(struct mt7915_dev *dev, bool force)
 	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
 	int i;
 
+	mt7915_ct_wed_detach(dev);
+
 	/* clean up hw queues */
 	for (i = 0; i < ARRAY_SIZE(dev->mt76.phy.q_tx); i++) {
 		mt76_queue_tx_cleanup(dev, dev->mphy.q_tx[i], true);
@@ -656,7 +660,7 @@ int mt7915_dma_reset(struct mt7915_dev *dev, bool force)
 		mt76_rmw(dev, MT_WFDMA0_EXT0_CFG, MT_WFDMA0_EXT0_RXWB_KEEP,
 			 MT_WFDMA0_EXT0_RXWB_KEEP);
 
