+
+bool mt76_dma_capsule_retained(struct mt76_dev *dev)
+{
+	return dev->dma_capsule && READ_ONCE(dev->dma_capsule->retained);
+}
+EXPORT_SYMBOL_GPL(mt76_dma_capsule_retained);
