+{
+	if (!dev->dma_capsule)
+		return -EINVAL;
+	WRITE_ONCE(dev->dma_capsule->retained, true);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt76_dma_capsule_retain);
 
