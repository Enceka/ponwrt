+
+bool mt7915_ct_wed_retained(struct mt7915_dev *dev)
 {
 	struct mt7915_ct_wed *bridge = rcu_access_pointer(dev->ct_wed);
+
+	return bridge && READ_ONCE(bridge->ever_exposed);
+}
+
+int mt7915_ct_wed_expose(struct mt7915_dev *dev, struct mt7915_phy *phy2)
+{
+	struct mt7915_ct_wed *bridge = rcu_access_pointer(dev->ct_wed);
+	int err;
+
+	if (!bridge || bridge->dev != dev || !bridge->lease || bridge->owner != CT_SWITCHING ||
+	    bridge->ever_exposed || !bridge->irq_requested || !phy2 || !phy2->mt76)
+		return -EINVAL;
+	if (!try_module_get(THIS_MODULE))
+		return -ENODEV;
+	err = mt76_dma_capsule_retain(&dev->mt76);
+	if (err) {
+		module_put(THIS_MODULE);
+		return err;
+	}
+	bridge->module_pinned = true;
+	bridge->retained_phy2 = phy2->mt76;
+	WRITE_ONCE(bridge->ever_exposed, true);
+	return 0;
+}
+
+void mt7915_ct_wed_park(struct mt7915_dev *dev, bool from_reset)
+{
+	struct mt7915_ct_wed *bridge = rcu_access_pointer(dev->ct_wed);
+	struct mt76_dev *mdev = &dev->mt76;
+	struct mt76_phy *phy2;
+	unsigned int index;
+
+	if (!bridge || !bridge->ever_exposed || xchg(&bridge->software_parked, true))
+		return;
+	phy2 = bridge->retained_phy2;
+	dev->recovery.hw_init_done = false;
+	set_bit(MT76_REMOVED, &dev->mphy.state);
+	set_bit(MT76_RESET, &dev->mphy.state);
+	set_bit(MT76_MCU_RESET, &dev->mphy.state);
+	clear_bit(MT76_STATE_INITIALIZED, &dev->mphy.state);
+	clear_bit(MT76_STATE_RUNNING, &dev->mphy.state);
+	if (test_bit(MT76_STATE_REGISTERED, &dev->mphy.state))
+		ieee80211_stop_queues(dev->mphy.hw);
+	if (phy2) {
+		set_bit(MT76_REMOVED, &phy2->state);
+		set_bit(MT76_RESET, &phy2->state);
+		set_bit(MT76_MCU_RESET, &phy2->state);
+		clear_bit(MT76_STATE_RUNNING, &phy2->state);
+		if (test_bit(MT76_STATE_REGISTERED, &phy2->state))
+			ieee80211_stop_queues(phy2->hw);
+	}
+	wake_up(&mdev->mcu.wait);
+	wake_up(&dev->reset_wait);
+	devm_free_irq(mdev->dev, to_pci_dev(mdev->dev)->irq, dev);
+	if (dev->hif2)
+		devm_free_irq(mdev->dev, dev->hif2->irq, dev);
+	mt7915_ct_stop(dev);
+	tasklet_kill(&mdev->irq_tasklet);
+	cancel_work_sync(&dev->init_work);
+	if (!from_reset)
+		cancel_work_sync(&dev->reset_work);
+	cancel_work_sync(&dev->dump_work);
+	cancel_work_sync(&dev->rc_work);
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	if (phy2)
+		cancel_delayed_work_sync(&phy2->mac_work);
+	if (mdev->tx_worker.task)
+		mt76_worker_disable(&mdev->tx_worker);
+	mt76_for_each_q_rx(mdev, index)
+		if (mdev->q_rx[index].ndesc)
+			napi_disable(&mdev->napi[index]);
+	napi_disable(&mdev->tx_napi);
+	mt7915_mmio_park(dev);
+	dev_warn(mdev->dev, "CT WED radio parked; DMA allocations and module retained until reboot\n");
+}
+
+int mt7915_ct_wed_detach(struct mt7915_dev *dev)
+{
+	struct mt7915_ct_wed *bridge = rcu_access_pointer(dev->ct_wed);
+	struct airoha_ct_wed_drain_v2 result = {};
 	unsigned long flags;
+	int err;
 
 	if (!bridge)
-		return;
-	if (bridge->owner != CT_PREPARED || bridge->ops->release(bridge->lease))
-		return;
+		return 0;
+	if (bridge->ever_exposed) {
+		if (READ_ONCE(bridge->owner) == CT_RETAINED)
+			return -EUCLEAN;
+		spin_lock_irqsave(&dev->mt76.mmio.irq_lock, flags);
+		bridge->owner = CT_QUIESCING;
+		bridge->ops->irq_mask(bridge->lease, 0);
+		spin_unlock_irqrestore(&dev->mt76.mmio.irq_lock, flags);
+		err = bridge->ops->quiesce(bridge->lease, &result);
+		spin_lock_irqsave(&dev->mt76.mmio.irq_lock, flags);
+		bridge->owner = CT_RETAINED;
+		spin_unlock_irqrestore(&dev->mt76.mmio.irq_lock, flags);
+		if (bridge->irq_requested) {
+			free_irq(bridge->view.irq, bridge);
+			bridge->irq_requested = false;
+		}
+		return err ?: -EUCLEAN;
+	}
+	if (bridge->owner != CT_PREPARED)
+		return -EBUSY;
+	err = bridge->ops->release(bridge->lease);
+	if (err)
+		return err;
 	if (mt7915_ct_wed_tokens(bridge, false))
 		dev_err(dev->mt76.dev, "CT WED v2 host tokens remain in high partition\n");
 	spin_lock_irqsave(&dev->mt76.mmio.irq_lock, flags);
 	RCU_INIT_POINTER(dev->ct_wed, NULL);
 	spin_unlock_irqrestore(&dev->mt76.mmio.irq_lock, flags);
 	mt7915_ct_wed_put(bridge);
-}
+	return 0;
+}
