From: Enceka <enceka@yeah.net>
Subject: [PATCH] wifi: mt76: map the cold CT radio CSR aliases before WED startup

--- a/mt7915/ct_wed.c
+++ b/mt7915/ct_wed.c
@@ -215,6 +215,41 @@
 	return 0;
 }
 
+static int mt7915_ct_wed_radio_alias(struct mt7915_ct_wed *bridge)
+{
+	struct mt7915_dev *dev = bridge->dev;
+	u32 host, rings, desired, actual;
+	u32 fields = MT_WFDMA_WED_RING_CONTROL_TX0 | MT_WFDMA_WED_RING_CONTROL_TX1 |
+		     MT_WFDMA_WED_RING_CONTROL_RX1;
+	int err;
+
+	if (!bridge->ever_exposed || bridge->owner != CT_SWITCHING)
+		return -EINVAL;
+	err = mt7915_ct_wed_cold(dev);
+	if (err)
+		return err;
+	host = mt76_rr(dev, MT_WFDMA_HOST_CONFIG);
+	rings = mt76_rr(dev, MT_WFDMA_WED_RING_CONTROL);
+	if (host == U32_MAX || rings == U32_MAX)
+		return -EIO;
+	desired = host | MT_WFDMA_HOST_CONFIG_WED;
+	mt76_wr(dev, MT_WFDMA_HOST_CONFIG, desired);
+	actual = mt76_rr(dev, MT_WFDMA_HOST_CONFIG);
+	if (actual != desired)
+		return -EIO;
+	desired = (rings & ~fields) |
+		FIELD_PREP(MT_WFDMA_WED_RING_CONTROL_TX0, 18) |
+		FIELD_PREP(MT_WFDMA_WED_RING_CONTROL_TX1, 19) |
+		FIELD_PREP(MT_WFDMA_WED_RING_CONTROL_RX1, 2);
+	mt76_wr(dev, MT_WFDMA_WED_RING_CONTROL, desired);
+	actual = mt76_rr(dev, MT_WFDMA_WED_RING_CONTROL);
+	if (actual != desired)
+		return -EIO;
+	dev_info(dev->mt76.dev, "CT WED radio aliases: HOST_CONFIG %08x->%08x RING_CONTROL %08x->%08x; DMA parked\n",
+		 host, (u32)(host | MT_WFDMA_HOST_CONFIG_WED), rings, desired);
+	return 0;
+}
+
 static int mt7915_ct_wed_activate_bridge(struct mt7915_ct_wed *bridge,
 					 struct mt7915_phy *phy2)
 {
@@ -240,7 +275,9 @@
 		spin_unlock_irqrestore(&dev->mt76.mmio.irq_lock, flags);
 		return err;
 	}
-	err = bridge->ops->start_masked(bridge->lease, CT_START_REQUIRED);
+	err = mt7915_ct_wed_radio_alias(bridge);
+	if (!err)
+		err = bridge->ops->start_masked(bridge->lease, CT_START_REQUIRED);
 	if (err) {
 		dev_err(dev->mt76.dev, "CT WED activation failed (%d); exposed rings retained for software park\n", err);
 		return err;
