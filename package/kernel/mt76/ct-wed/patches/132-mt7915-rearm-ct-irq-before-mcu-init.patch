From: Enceka <enceka@yeah.net>
Subject: [PATCH] wifi: mt76: rearm the exposed CT IRQ before MCU initialization

--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -914,6 +914,10 @@ mt7915_init_hardware(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 		return ret;
 
 	set_bit(MT76_STATE_INITIALIZED, &dev->mphy.state);
+	if (mt7915_ct_wed_retained(dev)) {
+		mt7915_irq_enable(dev, 0);
+		mt7915_irq_disable(dev, 0);
+	}
 
 	ret = mt7915_mcu_init(dev);
 	if (ret)
