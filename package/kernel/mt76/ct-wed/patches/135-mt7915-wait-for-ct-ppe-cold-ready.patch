From: Enceka <enceka@yeah.net>
Subject: [PATCH] wifi: mt76: prepare CT PPE before cold WED activation

Acquire the CT PPE cold ownership before switching the primary IRQ or
exposing WED DMA rings. Use the existing unstarted lease release path if
PPE preparation fails, preserving native TX and the independent Connac2
receive path. Leave the default non-activated path and TC setup unchanged.

--- a/mt7915/npu.c
+++ b/mt7915/npu.c
@@ -110,6 +110,17 @@ bool mt7915_ct_ppe_enabled(struct mt7915_dev *dev)
 	return dev->ct_path && dev->ct_path->ppe;
 }
 
+int mt7915_ct_ppe_ready(struct mt7915_dev *dev)
+{
+	struct mt7915_ct_path *path = dev->ct_path;
+
+	if (!path || !path->ppe)
+		return -EOPNOTSUPP;
+	if (READ_ONCE(path->stopping))
+		return -ESHUTDOWN;
+	return airoha_ppe_ct_prepare_dev(path->ppe);
+}
+
 static bool mt7915_ct_flow_ingress(struct flow_rule *rule, int ifindex)
 {
 	struct flow_match_basic basic;
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -510,6 +510,7 @@ int mt7915_ct_prepare(struct mt7915_dev *dev);
 int mt7915_ct_bind(struct mt7915_dev *dev);
 void mt7915_ct_stop(struct mt7915_dev *dev);
 bool mt7915_ct_ppe_enabled(struct mt7915_dev *dev);
+int mt7915_ct_ppe_ready(struct mt7915_dev *dev);
 void mt7915_ct_check_ppe(struct mt7915_dev *dev, struct mt7915_sta *msta,
 			 struct sk_buff *skb, u32 info);
 int mt7915_ct_setup_tc(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
@@ -521,6 +522,7 @@ int mt7915_ct_set_ba(struct mt7915_dev *dev, u8 band, u16 wcid,
 		     u8 tid, u16 size, u16 ssn);
 #else
 static inline bool mt7915_ct_ppe_enabled(struct mt7915_dev *dev) { return false; }
+static inline int mt7915_ct_ppe_ready(struct mt7915_dev *dev) { return -EOPNOTSUPP; }
 static inline int mt7915_ct_clear_sta(struct mt7915_dev *dev, u8 band, u16 wcid)
 {
 	return 0;
--- a/mt7915/ct_wed.c
+++ b/mt7915/ct_wed.c
@@ -429,6 +429,10 @@ int mt7915_ct_wed_attach(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 	dev_info(device, "CT WED v2 IRQ %d reserved disabled; no DMA or IRQ routing change\n",
 		 bridge->view.irq);
 	if (ct_wed_activate) {
+		gate = "PPE cold readiness";
+		err = mt7915_ct_ppe_ready(dev);
+		if (err)
+			goto release;
 		gate = "cold activation";
 		err = mt7915_ct_wed_activate_bridge(bridge, phy2);
 		if (!err)
