+			    (!!act->dev->ieee80211_ptr != bridge))
 				return false;
+			outdev = act->dev;
 			redirect = true;
 			break;
 		case FLOW_ACTION_MANGLE:
+			if (bridge) {
+				if (!mt7915_ct_bridge_mangle(act, eth.key))
+					return false;
+				break;
+			}
 			if (act->mangle.htype == FLOW_ACT_MANGLE_HDR_TYPE_ETH)
 				break;
 			if (ipv6 || (act->mangle.htype != FLOW_ACT_MANGLE_HDR_TYPE_IP4 &&
@@ -214,13 +304,16 @@
 				return false;
 			break;
 		case FLOW_ACTION_CSUM:
+			if (bridge)
+				return false;
+			break;
 		case FLOW_ACTION_PRIORITY:
 			break;
 		default:
 			return false;
 		}
 	}
-	return redirect;
+	return redirect && (!bridge || mt7915_ct_bridge_peers(block, outdev, eth.key));
 }
 
