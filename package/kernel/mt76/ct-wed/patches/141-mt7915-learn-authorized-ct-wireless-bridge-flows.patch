-static bool mt7915_ct_flow_ingress(struct flow_rule *rule, int ifindex)
+static bool mt7915_ct_bridge_peer(struct mt7915_dev *dev,
+				 struct net_device *netdev, const u8 *addr,
+				 struct net_device_path *peer)
+{
+	struct mt7915_phy *ext_phy = mt7915_ext_phy(dev);
+	struct net_device_path_ctx ctx = { .dev = netdev, .bridge = true };
+	struct net_device_path_stack stack;
+	struct wireless_dev *wdev = netdev->ieee80211_ptr;
+
+	if (!wdev || wdev->iftype != NL80211_IFTYPE_AP ||
+	    (wdev->wiphy != dev->mphy.hw->wiphy &&
+	     (!ext_phy || wdev->wiphy != ext_phy->mt76->hw->wiphy)) ||
+	    !netif_is_bridge_port(netdev) ||
+	    br_port_get_stp_state(netdev) != BR_STATE_FORWARDING)
+		return false;
+	ether_addr_copy(ctx.daddr, addr);
+	if (dev_fill_forward_path(&ctx, &stack) || stack.num_paths != 1 ||
+	    stack.path[0].type != DEV_PATH_MTK_WDMA || stack.path[0].dev != netdev)
+		return false;
+	*peer = stack.path[0];
+	return peer->mtk_wdma.wdma_idx <= 1 &&
+	       peer->mtk_wdma.queue == peer->mtk_wdma.wdma_idx &&
+	       peer->mtk_wdma.wcid && peer->mtk_wdma.wcid <= MT7916_CT_MAX_WCID;
+}
+
+static bool mt7915_ct_bridge_peers(struct mt7915_ct_block *block,
+				  struct net_device *outdev,
+				  const struct flow_dissector_key_eth_addrs *eth)
+{
+	struct net_device *indev = block->netdev;
+	struct net_device_path source, dest;
+	bool valid = false;
+
+	rcu_read_lock();
+	if (netdev_master_upper_dev_get_rcu(indev) !=
+	    netdev_master_upper_dev_get_rcu(outdev) ||
+	    (indev == outdev && !br_port_flag_is_set(indev, BR_HAIRPIN_MODE)) ||
+	    (br_port_flag_is_set(indev, BR_ISOLATED) &&
+	     br_port_flag_is_set(outdev, BR_ISOLATED)))
+		goto out;
+	if (!mt7915_ct_bridge_peer(block->path->dev, indev, eth->src, &source) ||
+	    !mt7915_ct_bridge_peer(block->path->dev, outdev, eth->dst, &dest))
+		goto out;
+	valid = source.mtk_wdma.wdma_idx != dest.mtk_wdma.wdma_idx ||
+		source.mtk_wdma.wcid != dest.mtk_wdma.wcid;
+out:
+	rcu_read_unlock();
+	return valid;
+}
+
+static bool mt7915_ct_bridge_mangle(const struct flow_action_entry *act,
+				    const struct flow_dissector_key_eth_addrs *eth)
+{
+	u8 addresses[2 * ETH_ALEN];
+	u32 original;
+
+	if (act->mangle.htype != FLOW_ACT_MANGLE_HDR_TYPE_ETH ||
+	    act->mangle.offset > 2 * ETH_ALEN - sizeof(u32) ||
+	    !IS_ALIGNED(act->mangle.offset, sizeof(u32)))
+		return false;
+	ether_addr_copy(addresses, eth->dst);
+	ether_addr_copy(addresses + ETH_ALEN, eth->src);
+	original = get_unaligned((u32 *)(addresses + act->mangle.offset));
+	return ((original & act->mangle.mask) |
+		(act->mangle.val & ~act->mangle.mask)) == original;
+}
