 	 * station mode uses BSSID to map the wlan entry to a peer,
@@ -808,8 +821,40 @@
 	int err;
 
 	WRITE_ONCE(msta->ct_authorized, false);
+	WRITE_ONCE(msta->ct_epoch, 0);
 	err = mt7915_ct_flush_sta(dev, msta->vif->phy->mt76->band_idx, msta->wcid.idx);
 	mt7915_ct_ba_error(dev, msta->wcid.idx, err);
+}
+
+static void mt7915_ct_isolate_changed(struct ieee80211_hw *hw,
+				      struct ieee80211_vif *vif)
+{
+	struct mt7915_dev *dev = mt7915_hw_dev(hw);
+	struct ieee80211_sta *sta;
+
+	/* The wiphy mutex pins stations. mac80211 blocks bridge forward paths
+	 * across this callback, so no peer can relearn while another is flushed.
+	 */
+	for_each_station(sta, hw) {
+		struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+		bool authorized;
+		u32 epoch;
+		int err;
+
+		if (msta->vif != (struct mt7915_vif *)vif->drv_priv)
+			continue;
+		authorized = READ_ONCE(msta->ct_authorized);
+		WRITE_ONCE(msta->ct_authorized, false);
+		WRITE_ONCE(msta->ct_epoch, 0);
+		err = mt7915_ct_flush_sta(dev, msta->vif->phy->mt76->band_idx,
+					msta->wcid.idx);
+		mt7915_ct_ba_error(dev, msta->wcid.idx, err);
+		if (err || !authorized)
+			continue;
+		epoch = mt7915_ct_sta_epoch(dev, msta);
+		WRITE_ONCE(msta->ct_epoch, epoch);
+		WRITE_ONCE(msta->ct_authorized, true);
+	}
 }
 #endif
 
@@ -1932,8 +1977,12 @@
 	if (old == IEEE80211_STA_AUTHORIZED)
 		mt7915_ct_revoke_sta(mt7915_hw_dev(hw), msta);
 	err = mt76_sta_state(hw, vif, sta, old, new);
-	if (!err && new == IEEE80211_STA_AUTHORIZED && vif->type == NL80211_IFTYPE_AP)
+	if (!err && new == IEEE80211_STA_AUTHORIZED && vif->type == NL80211_IFTYPE_AP) {
+		u32 epoch = mt7915_ct_sta_epoch(mt7915_hw_dev(hw), msta);
+
+		WRITE_ONCE(msta->ct_epoch, epoch);
 		WRITE_ONCE(msta->ct_authorized, true);
+	}
 	return err;
 }
 #endif
