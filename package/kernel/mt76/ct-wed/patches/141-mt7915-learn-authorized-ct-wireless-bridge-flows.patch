+u32 mt7915_ct_sta_epoch(struct mt7915_dev *dev, struct mt7915_sta *msta)
+{
+	struct mt7915_ct_path *path = dev->ct_path;
+
+	if (!path || !path->ppe || READ_ONCE(path->stopping))
+		return 0;
+	return airoha_ppe_ct_wlan_epoch(path->ppe, msta->vif->phy->mt76->band_idx,
+				       msta->wcid.idx);
 }
 
