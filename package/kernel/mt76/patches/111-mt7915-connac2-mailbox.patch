diff --git a/mt7915/npu.c b/mt7915/npu.c
new file mode 100644
index 0000000..742d403
--- /dev/null
+++ b/mt7915/npu.c
@@ -0,0 +1,65 @@
+#include "mt7915.h"
+
+int mt7915_npu_prepare_ct(struct airoha_npu *npu, u8 band, phys_addr_t ba,
+			  const phys_addr_t rx_csr[2])
+{
+	u32 counter_base;
+	int selector, err;
+
+	if (!npu || band > 1 || !ba || upper_32_bits(ba) || !rx_csr)
+		return -EINVAL;
+	for (selector = 0; selector < 2; selector++)
+		if (!rx_csr[selector] || upper_32_bits(rx_csr[selector]))
+			return -EINVAL;
+
+	err = mt76_npu_send_msg(npu, band, WLAN_FUNC_SET_WAIT_DRIVER_MODEL,
+				2, GFP_KERNEL);
+	if (err)
+		return err;
+
+	for (selector = 0; selector < 3; selector++) {
+		err = mt76_npu_get_msg(npu, selector, WLAN_FUNC_GET_WAIT_DBG_COUNTER,
+				       &counter_base, GFP_KERNEL);
+		if (err)
+			return err;
+	}
+
+	err = mt76_npu_send_msg(npu, band, WLAN_FUNC_SET_WAIT_DRAM_BA_NODE_ADDR,
+				ba, GFP_KERNEL);
+	if (err)
+		return err;
+	err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE,
+				3, GFP_KERNEL);
+	if (err)
+		return err;
+	for (selector = 0; selector < 2; selector++) {
+		err = mt76_npu_send_msg(npu, selector, WLAN_FUNC_SET_WAIT_PCIE_ADDR,
+					rx_csr[selector], GFP_KERNEL);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
+int mt7915_npu_rx_ring_ct(struct airoha_npu *npu, u8 selector, u32 *base)
+{
+	u32 reply;
+	int err;
+
+	if (!base || !npu || selector > 1)
+		return -EINVAL;
+	*base = 0;
+	err = mt76_npu_send_msg(npu, selector, WLAN_FUNC_SET_WAIT_DESC,
+				768, GFP_KERNEL);
+	if (err)
+		return err;
+	err = mt76_npu_get_msg(npu, selector, WLAN_FUNC_GET_WAIT_RXDESC_BASE,
+			       &reply, GFP_KERNEL);
+	if (err)
+		return err;
+	if (!reply || !IS_ALIGNED(reply, 16))
+		return -EIO;
+	*base = reply;
+	return 0;
+}
