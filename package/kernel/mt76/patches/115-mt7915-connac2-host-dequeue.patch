+int mt7915_npu_host_rx_ct(struct mt7915_npu_host_ct *ring, struct airoha_npu *npu,
+			  struct napi_struct *napi, struct sk_buff **skb, u32 *info)
+{
+	u16 lengths[7];
+	struct airoha_npu_rx_dma_desc __iomem *desc;
+	unsigned int total, count, pos, index, copied = 0, consumed = 0;
+	u32 ctrl;
+
+	*skb = NULL;
+	desc = &ring->desc[ring->tail];
+	ctrl = readl(&desc->ctrl);
+	if (!(ctrl & NPU_RX_DMA_DESC_DONE_MASK))
+		return 0;
+	rmb();
+	*info = readl(&desc->info);
+	total = FIELD_GET(NPU_RX_DMA_DESC_LEN_MASK, ctrl);
+	count = FIELD_GET(NPU_RX_DMA_DESC_CUR_LEN_MASK, ctrl) == total ?
+		1 : FIELD_GET(MT7916_CT_FRAG_COUNT, *info);
+	if (!total || !count) {
+		consumed = 1;
+		goto release;
+	}
+	for (pos = 0; pos < count; pos++) {
+		u32 metadata;
+
+		index = (ring->tail + pos) % MT7916_CT_HOST_COUNT;
+		desc = &ring->desc[index];
+		ctrl = readl(&desc->ctrl);
+		if (!(ctrl & NPU_RX_DMA_DESC_DONE_MASK))
+			return 0;
+		rmb();
+		metadata = readl(&desc->info);
+		lengths[pos] = FIELD_GET(NPU_RX_DMA_DESC_CUR_LEN_MASK, ctrl);
+		if (count > 1 && (FIELD_GET(MT7916_CT_FRAG_ID, metadata) != pos + 1 ||
+				  FIELD_GET(NPU_RX_DMA_DESC_LEN_MASK, ctrl) != total ||
+				  !!(ctrl & NPU_RX_DMA_DESC_LAST_MASK) != (pos + 1 == count))) {
+			consumed = max(pos, 1U);
+			goto release;
+		}
+		consumed++;
+		if (!lengths[pos] || lengths[pos] > MT7916_CT_HOST_LEN || copied + lengths[pos] > total)
+			goto release;
+		copied += lengths[pos];
+	}
+	if (copied != total)
+		goto release;
+	*skb = napi_alloc_skb(napi, total);
+	if (*skb) {
+		for (pos = 0; pos < count; pos++) {
+			index = (ring->tail + pos) % MT7916_CT_HOST_COUNT;
+			memcpy_fromio(skb_put(*skb, lengths[pos]),
+				      ring->buffers + index * MT7916_CT_HOST_STRIDE, lengths[pos]);
+		}
+	}
+release:
+	for (pos = 0; pos < consumed; pos++) {
+		desc = &ring->desc[ring->tail];
+		writel_relaxed(0, &desc->info);
+		writel(0, &desc->ctrl);
+		ring->tail = (ring->tail + 1) % MT7916_CT_HOST_COUNT;
+	}
+	return 1;
+}
+
+int mt7915_npu_host_rx_flush_ct(struct mt7915_npu_host_ct *ring, struct airoha_npu *npu)
+{
+	wmb();
+	return regmap_write(npu->regmap, ring->regs + offsetof(struct mt76_queue_regs, dma_idx),
+			    ring->tail);
+}
