+int mt7915_ct_prepare(struct mt7915_dev *dev)
+{
+	struct device *device = dev->mt76.dev;
+	struct mt7915_ct_path *path;
+	struct resource pool;
+	const char *firmware;
+	unsigned int queue, index;
+	int err;
+
+	if (!of_property_read_bool(device->of_node, "airoha,connac2-rx"))
+		return 0;
+	if (!is_mt7916(&dev->mt76) || !dev->hif2 || !dev->dbdc_support ||
+	    mtk_wed_device_active(&dev->mt76.mmio.wed) ||
+	    !of_machine_is_compatible("fiberhome,hg5585f-ct"))
+		return -ENODEV;
+	path = devm_kzalloc(device, sizeof(*path), GFP_KERNEL);
+	if (!path)
+		return -ENOMEM;
+	path->dev = dev;
+	path->npu = airoha_npu_get(device);
+	if (IS_ERR(path->npu))
+		return PTR_ERR(path->npu);
+	err = devm_add_action_or_reset(device, mt7915_npu_release, path->npu);
+	if (err)
+		return err;
+	if (of_property_read_string_index(path->npu->dev->of_node, "firmware-name", 0,
+					  &firmware) ||
+	    strcmp(firmware, "airoha/hg5585f-ct/npu_rv32.bin"))
+		return -EINVAL;
+	err = of_reserved_mem_region_to_resource_byname(path->npu->dev->of_node, "connac2-pkt", &pool);
+	if (err)
+		return err;
+	if (resource_size(&pool) != 6 * SZ_1M || upper_32_bits(pool.end))
+		return -ERANGE;
+	err = mt7915_npu_host_init_ct(dev, path->npu, path->rings);
+	if (err)
+		return err;
+	err = mt7915_npu_request_rx_ct(dev, path->npu, path->bases);
+	if (err)
+		return err;
+	for (queue = 0; queue < ARRAY_SIZE(path->bases); queue++) {
+		struct mt76_desc __iomem *desc = ioremap(path->bases[queue], MT7916_CT_RX_BYTES);
+
+		if (!desc)
+			return -ENOMEM;
+		for (index = 0; index < MT7916_CT_RX_COUNT; index++) {
+			u32 addr = readl(&desc[index].buf0);
+			u32 ctrl = readl(&desc[index].ctrl);
+			u32 len = FIELD_GET(MT_DMA_CTL_SD_LEN0, ctrl);
+
+			if (addr < pool.start || addr > pool.end || !len ||
+			    len - 1 > pool.end - addr || (ctrl & MT_DMA_CTL_DMA_DONE)) {
+				dev_err(device, "invalid Connac2 RX descriptor %u:%u ctrl=%08x addr=%08x\n",
+					queue, index, ctrl, addr);
+				err = -ERANGE;
+				break;
+			}
+		}
+		iounmap(desc);
+		if (err)
+			return err;
+	}
+	dev->q_int_mask[__RXQ(MT_RXQ_MAIN)] = 0;
+	dev->q_int_mask[__RXQ(MT_RXQ_BAND1)] = 0;
+	dev->ct_path = path;
+	return 0;
+}
+
+void mt7915_ct_stop(struct mt7915_dev *dev)
+{
+	struct mt7915_ct_path *path = dev->ct_path;
+	unsigned int index;
+
+	if (!path || READ_ONCE(path->stopping))
+		return;
+	WRITE_ONCE(path->stopping, true);
+	for (index = 0; index < ARRAY_SIZE(path->poll); index++) {
+		struct mt7915_ct_poll *poll = &path->poll[index];
+
+		airoha_npu_wlan_disable_irq(path->npu, index);
+		if (poll->irq_requested) {
+			devm_free_irq(dev->mt76.dev, path->npu->irqs[index], poll);
+			poll->irq_requested = false;
+		}
+		if (poll->attached) {
+			napi_disable(&poll->napi);
+			synchronize_net();
+			netif_napi_del(&poll->napi);
+			poll->attached = false;
+		}
+		airoha_npu_wlan_disable_irq(path->npu, index);
+	}
+}
+
+int mt7915_ct_bind(struct mt7915_dev *dev)
+{
+	struct mt7915_ct_path *path = dev->ct_path;
+	unsigned int index;
+	int err;
+
+	if (!path)
+		return 0;
+	for (index = 0; index < ARRAY_SIZE(path->poll); index++) {
+		struct mt7915_ct_poll *poll = &path->poll[index];
+
+		poll->path = path;
+		poll->index = index;
+		netif_napi_add(dev->mt76.napi_dev, &poll->napi, mt7915_ct_poll_rx);
+		napi_enable(&poll->napi);
+		poll->attached = true;
+		err = devm_request_irq(dev->mt76.dev, path->npu->irqs[index], mt7915_ct_irq,
+				       IRQF_SHARED, "mt7915-connac2-rx", poll);
+		if (err)
+			goto fail;
+		poll->irq_requested = true;
+	}
+	for (index = 0; index < ARRAY_SIZE(path->bases); index++) {
+		u32 reg = index ? MT_WFDMA0(0x500) + MT7916_RXQ_BAND0 * MT_RING_SIZE :
+				  MT_WFDMA0_PCIE1(0x500) + MT7916_RXQ_BAND1 * MT_RING_SIZE;
+
+		mt76_wr(dev, reg, path->bases[index]);
+		mt76_wr(dev, reg + offsetof(struct mt76_queue_regs, ring_size), MT7916_CT_RX_COUNT);
+		mt76_wr(dev, reg + offsetof(struct mt76_queue_regs, cpu_idx), MT7916_CT_RX_COUNT - 1);
+		if (mt76_rr(dev, reg) != path->bases[index]) {
+			err = -EIO;
+			goto fail;
+		}
+		airoha_npu_wlan_enable_irq(path->npu, index);
+	}
+	dev_info(dev->mt76.dev, "Connac2 WFDMA and Hostadpt RX enabled\n");
+	return 0;
+fail:
+	mt7915_ct_stop(dev);
+	return err;
+}
