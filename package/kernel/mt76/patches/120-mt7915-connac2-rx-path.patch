+static bool mt7915_ct_normal_frame(struct sk_buff *skb)
+{
+	const __le32 *rxd = (void *)skb->data;
+	u32 flags, hdr, len, payload;
+	u32 minimum;
+
+	if (skb->len < 24 || le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE) != PKT_TYPE_NORMAL)
+		return false;
+	len = le32_get_bits(rxd[0], MT_RXD0_LENGTH);
+	flags = le32_to_cpu(rxd[1]);
+	if ((flags & MT_RXD1_NORMAL_GROUP_5) && !(flags & MT_RXD1_NORMAL_GROUP_3))
+		return false;
+	hdr = 24 + 16 * !!(flags & MT_RXD1_NORMAL_GROUP_4) +
+	      16 * !!(flags & MT_RXD1_NORMAL_GROUP_1) + 8 * !!(flags & MT_RXD1_NORMAL_GROUP_2);
+	if (flags & MT_RXD1_NORMAL_GROUP_3)
+		hdr += 8 + 72 * !!(flags & MT_RXD1_NORMAL_GROUP_5);
+	hdr += 2 * le32_get_bits(rxd[2], MT_RXD2_NORMAL_HDR_OFFSET);
+	if (len > skb->len || len < hdr + sizeof(__le16))
+		return false;
+	payload = len - hdr;
+	if (le32_to_cpu(rxd[2]) & MT_RXD2_NORMAL_HDR_TRANS) {
+		minimum = ETH_HLEN;
+		if (payload >= ETH_HLEN &&
+		    (le32_to_cpu(rxd[2]) & MT_RXD2_NORMAL_HDR_TRANS_ERROR) &&
+		    get_unaligned_be16(skb->data + hdr + 2 * ETH_ALEN) == ETH_P_8021Q)
+			minimum += VLAN_HLEN + sizeof(__be16);
+	} else {
+		__le16 fc = get_unaligned((const __le16 *)(skb->data + hdr));
+
+		minimum = ieee80211_hdrlen(fc);
+		if (le32_get_bits(rxd[4], MT_RXD4_NORMAL_PAYLOAD_FORMAT))
+			minimum += 2;
+	}
+	if (payload < minimum)
+		return false;
+	skb_trim(skb, len);
+	return true;
+}
+
+static int mt7915_ct_poll_rx(struct napi_struct *napi, int budget)
+{
+	struct mt7915_ct_poll *poll = container_of(napi, struct mt7915_ct_poll, napi);
+	struct mt7915_ct_path *path = poll->path;
+	struct mt76_dev *mdev = &path->dev->mt76;
+	enum mt76_rxq_id qid = poll->index ? MT_RXQ_NPU1 : MT_RXQ_NPU0;
+	int done = 0, ret = 0;
+
+	rcu_read_lock();
+	while (done < budget && !READ_ONCE(path->stopping)) {
+		struct sk_buff *skb;
+		u32 info;
+
+		ret = mt7915_npu_host_rx_ct(&path->rings[poll->index], path->npu, napi, &skb, &info);
+		if (ret <= 0)
+			break;
+		done++;
+		if (!skb)
+			continue;
+		if (!mt7915_ct_normal_frame(skb)) {
+			dev_kfree_skb_any(skb);
+			continue;
+		}
+		memset(skb->cb, 0, sizeof(skb->cb));
+		*(u32 *)skb->cb = BIT(0) | BIT(2) | BIT(3);
+		mt7915_queue_rx_skb(mdev, qid, skb, &info);
+	}
+	mt76_rx_poll_complete(mdev, qid, napi);
+	if (ret < 0)
+		dev_err_ratelimited(mdev->dev, "Connac2 RX queue %u stopped: %d\n",
+				    poll->index, ret);
+	if (done < budget && napi_complete_done(napi, done) && ret >= 0 &&
+	    !READ_ONCE(path->stopping))
+		airoha_npu_wlan_enable_irq(path->npu, poll->index);
+	rcu_read_unlock();
+	return done;
+}
+
+static irqreturn_t mt7915_ct_irq(int irq, void *data)
+{
+	struct mt7915_ct_poll *poll = data;
+	struct airoha_npu *npu = poll->path->npu;
+	u32 mask = BIT(16 + poll->index);
+
+	if (!(airoha_npu_wlan_get_irq_status(npu, poll->index) & mask))
+		return IRQ_NONE;
+	airoha_npu_wlan_disable_irq(npu, poll->index);
+	airoha_npu_wlan_set_irq_status(npu, mask);
+	if (!READ_ONCE(poll->path->stopping))
+		napi_schedule_irqoff(&poll->napi);
+	return IRQ_HANDLED;
+}
