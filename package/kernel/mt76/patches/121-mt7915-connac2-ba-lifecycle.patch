diff --git a/mt7915/npu.c b/mt7915/npu.c
index 654d3de..f7f2247 100644
--- a/mt7915/npu.c
+++ b/mt7915/npu.c
@@ -73,6 +73,10 @@ DEFINE_DEBUGFS_ATTRIBUTE(mt7915_ct_count_fops, mt7915_ct_count_get,
 			mt7915_ct_count_set, "%llu\n");
 #define MT7916_CT_FRAG_COUNT	GENMASK(31, 29)
 #define MT7916_CT_FRAG_ID	GENMASK(28, 26)
+#define MT7916_CT_BA_TID	GENMASK(2, 0)
+#define MT7916_CT_BA_WCID	GENMASK(10, 3)
+#define MT7916_CT_BA_SIZE	GENMASK(19, 11)
+#define MT7916_CT_BA_LAST_SEQ	GENMASK(31, 20)
 
 struct mt7915_ct_poll {
 	struct napi_struct napi;
@@ -91,6 +95,43 @@ struct mt7915_ct_path {
 	bool stopping;
 };
 
+int mt7915_ct_clear_sta(struct mt7915_dev *dev, u8 band, u16 wcid)
+{
+	struct mt7915_ct_path *path = dev->ct_path;
+
+	if (!path)
+		return 0;
+	if (READ_ONCE(path->stopping))
+		return -ESHUTDOWN;
+	if (band > 1 || !wcid || wcid > MT7916_CT_MAX_WCID)
+		return -ERANGE;
+	return mt76_npu_send_msg(path->npu, !band, WLAN_FUNC_SET_WAIT_DEL_STA,
+				wcid, GFP_KERNEL);
+}
+
+int mt7915_ct_set_ba(struct mt7915_dev *dev, u8 band, u16 wcid,
+		     u8 tid, u16 size, u16 ssn)
+{
+	struct mt7915_ct_path *path = dev->ct_path;
+	u32 value;
+
+	if (!path)
+		return 0;
+	if (READ_ONCE(path->stopping))
+		return size ? -ESHUTDOWN : 0;
+	if (band > 1 || !wcid || wcid > MT7916_CT_MAX_WCID || tid > 7 ||
+	    size > IEEE80211_MAX_AMPDU_BUF_HE || ssn > FIELD_MAX(MT7916_CT_BA_LAST_SEQ))
+		return -ERANGE;
+	value = FIELD_PREP(MT7916_CT_BA_TID, tid) |
+		FIELD_PREP(MT7916_CT_BA_WCID, wcid) |
+		FIELD_PREP(MT7916_CT_BA_SIZE, size);
+	if (size)
+		value |= FIELD_PREP(MT7916_CT_BA_LAST_SEQ,
+				    (ssn - 1) & FIELD_MAX(MT7916_CT_BA_LAST_SEQ));
+	return mt76_npu_send_msg(path->npu, !band, WLAN_FUNC_SET_WAIT_BA_WIN_SIZE,
+				value, GFP_KERNEL);
+}
