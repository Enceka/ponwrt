diff --git a/mt7915/npu.c b/mt7915/npu.c
index fead151..8fbba8c 100644
--- a/mt7915/npu.c
+++ b/mt7915/npu.c
@@ -3,6 +3,7 @@
 #include <linux/pci.h>
 #include <linux/if_vlan.h>
 #include <linux/unaligned.h>
