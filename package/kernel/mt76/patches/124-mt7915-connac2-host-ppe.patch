 	u32 bases[2];
 	bool stopping;
 };
 
+struct mt7915_ct_block {
+	struct mt7915_ct_path *path;
+	struct xarray cookies;
+	struct mutex lock;
+	int ifindex;
+};
+
+bool mt7915_ct_ppe_enabled(struct mt7915_dev *dev)
+{
+	return dev->ct_path && dev->ct_path->ppe;
+}
+
+static bool mt7915_ct_flow_ingress(struct flow_rule *rule, int ifindex)
+{
+	struct flow_match_basic basic;
+	struct flow_match_meta meta;
+	const struct flow_action_entry *act;
+	int index;
+
+	if (!rule || !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC))
+		return false;
+	flow_rule_match_meta(rule, &meta);
+	flow_rule_match_basic(rule, &basic);
+	if (meta.mask->ingress_ifindex != U32_MAX || meta.key->ingress_ifindex != ifindex ||
+	    basic.mask->n_proto != htons(0xffff) || basic.key->n_proto != htons(ETH_P_IP))
+		return false;
+	flow_action_for_each(index, act, &rule->action) {
+		if (act->id == FLOW_ACTION_REDIRECT)
+			return act->dev && !act->dev->ieee80211_ptr;
+	}
+	return false;
+}
+
+static int mt7915_ct_flow_cb(enum tc_setup_type type, void *data, void *priv)
+{
+	struct mt7915_ct_block *block = priv;
+	struct flow_cls_offload *flow = data;
+	int err = -EOPNOTSUPP;
+
+	if (type != TC_SETUP_CLSFLOWER)
+		return err;
+	mutex_lock(&block->lock);
+	switch (flow->command) {
+	case FLOW_CLS_REPLACE:
+		if (READ_ONCE(block->path->stopping) ||
+		    !mt7915_ct_flow_ingress(flow_cls_offload_flow_rule(flow), block->ifindex))
+			break;
+		if (xa_load(&block->cookies, flow->cookie)) {
+			err = 0;
+			break;
+		}
+		err = xa_insert(&block->cookies, flow->cookie, xa_mk_value(1), GFP_KERNEL);
+		if (err)
+			break;
+		err = airoha_ppe_dev_setup_tc_block_cb(block->path->ppe, flow);
+		if (err)
+			xa_erase(&block->cookies, flow->cookie);
+		break;
+	case FLOW_CLS_DESTROY:
+	case FLOW_CLS_STATS:
+		if (!xa_load(&block->cookies, flow->cookie))
+			break;
+		err = airoha_ppe_dev_setup_tc_block_cb(block->path->ppe, flow);
+		if (flow->command == FLOW_CLS_DESTROY && (!err || err == -ENOENT))
+			xa_erase(&block->cookies, flow->cookie);
+		break;
+	}
+	mutex_unlock(&block->lock);
+	return err;
+}
+
+static void mt7915_ct_block_release(void *priv)
+{
+	struct mt7915_ct_block *block = priv;
+	struct flow_cls_offload destroy = { .command = FLOW_CLS_DESTROY };
+	unsigned long cookie;
+	void *entry;
+
+	xa_for_each(&block->cookies, cookie, entry) {
+		destroy.cookie = cookie;
+		airoha_ppe_dev_setup_tc_block_cb(block->path->ppe, &destroy);
+	}
+	xa_destroy(&block->cookies);
+	kfree(block);
+}
+
+int mt7915_ct_setup_tc(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+		       struct net_device *netdev, enum tc_setup_type type, void *data)
+{
+	struct mt7915_dev *dev = mt7915_hw_dev(hw);
+	struct mt7915_ct_path *path = dev->ct_path;
+	struct flow_block_offload *offload = data;
+	struct flow_block_cb *cb;
+	struct mt7915_ct_block *block;
+
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+		return mt76_wed_net_setup_tc(hw, vif, netdev, type, data);
+#endif
+	if (!mt7915_ct_ppe_enabled(dev) || type != TC_SETUP_FT ||
+	    offload->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
+		return -EOPNOTSUPP;
+	offload->driver_block_list = &path->blocks;
+	cb = flow_block_cb_lookup(offload->block, mt7915_ct_flow_cb, netdev);
+	switch (offload->command) {
+	case FLOW_BLOCK_BIND:
+		if (!tc_can_offload(netdev) || vif->type != NL80211_IFTYPE_AP || READ_ONCE(path->stopping))
+			return -EOPNOTSUPP;
+		if (!cb) {
+			block = kzalloc(sizeof(*block), GFP_KERNEL);
+			if (!block)
+				return -ENOMEM;
+			block->path = path;
+			block->ifindex = netdev->ifindex;
+			xa_init(&block->cookies);
+			mutex_init(&block->lock);
+			cb = flow_block_cb_alloc(mt7915_ct_flow_cb, netdev, block, mt7915_ct_block_release);
+			if (IS_ERR(cb)) {
+				kfree(block);
+				return PTR_ERR(cb);
+			}
+			flow_block_cb_add(cb, offload);
+			list_add_tail(&cb->driver_list, &path->blocks);
+		}
+		flow_block_cb_incref(cb);
+		return 0;
+	case FLOW_BLOCK_UNBIND:
+		if (!cb)
+			return -ENOENT;
+		if (!flow_block_cb_decref(cb)) {
+			flow_block_cb_remove(cb, offload);
+			list_del(&cb->driver_list);
+		}
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+void mt7915_ct_check_ppe(struct mt7915_dev *dev, struct mt7915_sta *msta,
+			 struct sk_buff *skb, u32 info)
+{
+	struct mt7915_ct_path *path = dev->ct_path;
+	struct ieee80211_sta *sta;
+	const struct ethhdr *hdr;
+
+	if (!mt7915_ct_ppe_enabled(dev) || READ_ONCE(path->stopping) || !msta ||
+	    FIELD_GET(NPU_RX_DMA_CRSN_MASK, info) != PPE_CPU_REASON_HIT_UNBIND_RATE_REACHED ||
+	    skb->len < ETH_HLEN)
+		return;
+	sta = wcid_to_sta(&msta->wcid);
+	hdr = (const void *)skb->data;
+	if (!sta || !READ_ONCE(msta->ct_authorized) || hdr->h_proto != htons(ETH_P_IP) ||
+	    is_multicast_ether_addr(hdr->h_dest) ||
+	    !ether_addr_equal(hdr->h_source, sta->addr))
+		return;
+	skb_reset_mac_header(skb);
+	airoha_ppe_dev_check_skb(path->ppe, skb, FIELD_GET(NPU_RX_DMA_FOE_ID_MASK, info), true);
+}
+
+static void mt7915_ct_put_ppe(void *data)
+{
+	airoha_ppe_put_dev(data);
+}
