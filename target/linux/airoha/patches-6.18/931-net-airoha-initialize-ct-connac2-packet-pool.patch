+static int airoha_npu_connac2_init_pool(struct airoha_npu *npu)
+{
+	struct resource pool;
+	void __iomem *base;
+	u32 val = 0;
+	int err;
+
+	err = of_reserved_mem_region_to_resource_byname(npu->dev->of_node,
+						       "connac2-pkt", &pool);
+	if (err)
+		return err;
+	if (resource_size(&pool) != 6 * SZ_1M || upper_32_bits(pool.end) ||
+	    !IS_ALIGNED(pool.start, SZ_64K))
+		return -EINVAL;
+	base = ioremap_wc(pool.start, resource_size(&pool));
+	if (!base)
+		return -ENOMEM;
+	memset_io(base, 0, resource_size(&pool));
+	wmb();
+	iounmap(base);
+
+	err = airoha_npu_wlan_msg_send(npu, 1, WLAN_FUNC_SET_WAIT_NPU_BAND0_ONCPU,
+				       &val, sizeof(val), GFP_KERNEL);
+	if (err)
+		return err;
+	val = lower_32_bits(pool.start);
+	err = airoha_npu_wlan_msg_send(npu, 0, WLAN_FUNC_SET_WAIT_PKT_BUF_ADDR,
+				       &val, sizeof(val), GFP_KERNEL);
+	if (err)
+		return err;
+	val = 0;
+	return airoha_npu_wlan_msg_send(npu, 0, WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU,
+					&val, sizeof(val), GFP_KERNEL);
+}
