+static bool airoha_ppe_ct_requested(struct airoha_eth *eth)
+{
+	return airoha_is_7581(eth) && of_machine_is_compatible("fiberhome,hg5585f-ct") &&
+	       of_property_read_bool(eth->dev->of_node, "airoha,connac2-host-ppe");
+}
