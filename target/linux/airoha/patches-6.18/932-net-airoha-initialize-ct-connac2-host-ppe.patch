+static int airoha_ppe_ct_check_sram(struct airoha_ppe *ppe, bool clear)
+{
+	u32 count = airoha_ppe_get_total_sram_num_entries(ppe);
+	u32 hash;
+
+	for (hash = 0; hash < count; hash++) {
+		struct airoha_foe_entry *entry;
+		int err = 0;
+
+		spin_lock_bh(&ppe_lock);
+		entry = airoha_ppe_foe_get_entry_locked(ppe, hash);
+		if (!entry) {
+			err = -ETIMEDOUT;
+		} else if (entry->ib1 & (AIROHA_FOE_IB1_BIND_STATE | AIROHA_FOE_IB1_BIND_STATIC)) {
+			if (clear) {
+				memset(entry, 0, sizeof(*entry));
+				err = airoha_ppe_foe_commit_sram_entry(ppe, hash);
+			} else {
+				err = -EBUSY;
+			}
+		}
+		spin_unlock_bh(&ppe_lock);
+		if (err)
+			return err;
+		if (!(hash % 256))
+			cond_resched();
+	}
+	return 0;
+}
+
+static const u16 ct_bank0_regs[] = {
+	REG_PPE_TB_CFG(0), REG_PPE_TB_HASH_CFG(0), REG_PPE_BND_AGE0(0),
+	REG_PPE_BND_AGE1(0), REG_PPE_BIND_RATE(0), REG_PPE_HASH_SEED(0),
+	REG_PPE_DFT_CPORT(0, 0), REG_PPE_DFT_CPORT(0, 8), REG_PPE_MTU(0, 0),
+	REG_PPE_MTU(0, 2), REG_PPE_MTU(0, 4), REG_PPE_MTU(0, 6), REG_PPE_PPE_FLOW_CFG(0),
+	REG_PPE_BIND_LIMIT0(0), REG_PPE_BIND_LIMIT1(0), REG_PPE_UNBIND_AGE(0),
+};
+
+static bool airoha_ppe_ct_learning_init(struct airoha_eth *eth, int bank)
+{
+	const u32 limits0 = PPE_BIND_LIMIT0_HALF_MASK | PPE_BIND_LIMIT0_QUARTER_MASK;
+	const u32 limits1 = PPE_BIND_LIMIT1_FULL_MASK | PPE_BIND_LIMIT1_NON_L4_MASK;
+	const u32 unbind = PPE_UNBIND_AGE_MIN_PACKETS_MASK | PPE_UNBIND_AGE_DELTA_MASK;
+	const u32 ages = PPE_TB_CFG_AGE_TCP_FIN_MASK | PPE_TB_CFG_AGE_UDP_MASK |
+			 PPE_TB_CFG_AGE_TCP_MASK | PPE_TB_CFG_AGE_UNBIND_MASK |
+			 PPE_TB_CFG_AGE_NON_L4_MASK;
+	const u32 half_quarter = FIELD_PREP(PPE_BIND_LIMIT0_HALF_MASK, 4000) |
+				 FIELD_PREP(PPE_BIND_LIMIT0_QUARTER_MASK, 4000);
+	const u32 full_non_l4 = FIELD_PREP(PPE_BIND_LIMIT1_FULL_MASK, 8000) |
+				FIELD_PREP(PPE_BIND_LIMIT1_NON_L4_MASK, 1);
+	const u32 aging = FIELD_PREP(PPE_UNBIND_AGE_MIN_PACKETS_MASK, 1000) |
+			  FIELD_PREP(PPE_UNBIND_AGE_DELTA_MASK, 3);
+	const u32 bnd0_mask = PPE_BIND_AGE0_DELTA_NON_L4 | PPE_BIND_AGE0_DELTA_UDP;
+	const u32 bnd1_mask = PPE_BIND_AGE1_DELTA_TCP_FIN | PPE_BIND_AGE1_DELTA_TCP;
+	const u32 bnd0 = FIELD_PREP(PPE_BIND_AGE0_DELTA_NON_L4, 15) |
+			 FIELD_PREP(PPE_BIND_AGE0_DELTA_UDP, 15);
+	const u32 bnd1 = FIELD_PREP(PPE_BIND_AGE1_DELTA_TCP_FIN, 5) |
+			 FIELD_PREP(PPE_BIND_AGE1_DELTA_TCP, 15);
+
+	airoha_fe_rmw(eth, REG_PPE_BIND_LIMIT0(bank), limits0, half_quarter);
+	airoha_fe_rmw(eth, REG_PPE_BIND_LIMIT1(bank), limits1, full_non_l4);
+	airoha_fe_rmw(eth, REG_PPE_UNBIND_AGE(bank), unbind, aging);
+	airoha_fe_rmw(eth, REG_PPE_BND_AGE0(bank), bnd0_mask, bnd0);
+	airoha_fe_rmw(eth, REG_PPE_BND_AGE1(bank), bnd1_mask, bnd1);
+	airoha_fe_set(eth, REG_PPE_TB_CFG(bank), ages);
+
+	return (airoha_fe_rr(eth, REG_PPE_BIND_LIMIT0(bank)) & limits0) == half_quarter &&
+	       (airoha_fe_rr(eth, REG_PPE_BIND_LIMIT1(bank)) & limits1) == full_non_l4 &&
+	       (airoha_fe_rr(eth, REG_PPE_UNBIND_AGE(bank)) & unbind) == aging &&
+	       (airoha_fe_rr(eth, REG_PPE_BND_AGE0(bank)) & bnd0_mask) == bnd0 &&
+	       (airoha_fe_rr(eth, REG_PPE_BND_AGE1(bank)) & bnd1_mask) == bnd1 &&
+	       (airoha_fe_rr(eth, REG_PPE_TB_CFG(bank)) & ages) == ages;
+}
+
+static void airoha_ppe_ct_regs(struct airoha_ppe *ppe, int bank, bool restore)
+{
+	struct airoha_eth *eth = ppe->eth;
+	unsigned int idx;
+
+	static_assert(ARRAY_SIZE(ct_bank0_regs) == ARRAY_SIZE(ppe->ct_saved[0].regs));
+	for (idx = 0; idx < ARRAY_SIZE(ct_bank0_regs); idx++) {
+		u32 reg = ct_bank0_regs[idx] + bank * (PPE2_BASE - PPE1_BASE);
+
+		if (restore)
+			airoha_fe_wr(eth, reg, ppe->ct_saved[bank].regs[idx]);
+		else
+			ppe->ct_saved[bank].regs[idx] = airoha_fe_rr(eth, reg);
+	}
+}
+
+static int airoha_ppe_ct_quiesce(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	int bank, err;
+	u32 val;
+
+	for (bank = 0; bank < eth->soc->num_ppe; bank++) {
+		airoha_fe_clear(eth, REG_PPE_PPE_FLOW_CFG(bank), CT_HOST_IPV4_FLOWS);
+		airoha_fe_clear(eth, REG_PPE_GLO_CFG(bank), PPE_GLO_CFG_EN_MASK);
+	}
+	for (bank = 0; bank < eth->soc->num_ppe; bank++) {
+		err = read_poll_timeout(airoha_fe_rr, val,
+					!(val & (PPE_GLO_CFG_EN_MASK | PPE_GLO_CFG_BUSY_MASK)),
+					10, 100000, false, eth, REG_PPE_GLO_CFG(bank));
+		if (err) {
+			dev_err(eth->dev, "PPE%d still active, restoration deferred\n", bank);
+			return err;
+		}
+	}
+	return 0;
+}
+
+static int airoha_ppe_ct_stop(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	int bank, err;
+
+	WRITE_ONCE(ppe->ct_host_ppe, false);
+	err = airoha_ppe_ct_quiesce(ppe);
+	if (err)
+		return err;
+	if (ppe->ct_owns_sram) {
+		err = airoha_ppe_ct_check_sram(ppe, true);
+		if (err)
+			return err;
+		ppe->ct_owns_sram = false;
+	}
+	for (bank = 0; bank < eth->soc->num_ppe; bank++)
+		airoha_ppe_ct_regs(ppe, bank, true);
+	for (bank = 0; bank < eth->soc->num_ppe; bank++)
+		airoha_fe_rmw(eth, REG_PPE_GLO_CFG(bank), PPE_GLO_CFG_EN_MASK,
+			      ppe->ct_saved[bank].glo & PPE_GLO_CFG_EN_MASK);
+	ppe->ct_restore_pending = false;
+	return 0;
+}
+
+static int airoha_ppe_ct_start(struct airoha_ppe *ppe, struct airoha_npu *npu)
+{
+	struct device_node *np = npu->dev->of_node;
+	struct airoha_eth *eth = ppe->eth;
+	int bank, err;
+
+	if (ppe->ct_restore_pending)
+		return -EBUSY;
+
+	if (of_property_match_string(np, "memory-region-names", "connac2-pkt") < 0 ||
+	    of_property_match_string(np, "firmware-name", "airoha/hg5585f-ct/npu_rv32.bin") != 0 ||
+	    of_property_match_string(np, "firmware-name", "airoha/hg5585f-ct/npu_data.bin") != 1 ||
+	    eth->soc->num_ppe != ARRAY_SIZE(ppe->ct_saved) ||
+	    IS_ENABLED(CONFIG_NET_AIROHA_FLOW_STATS))
+		return -EOPNOTSUPP;
+
+	for (bank = 0; bank < eth->soc->num_ppe; bank++) {
+		if (airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(bank)) ||
+		    airoha_fe_rr(eth, REG_PPE_TB_BASE(bank)))
+			return -EBUSY;
+		ppe->ct_saved[bank].glo = airoha_fe_rr(eth, REG_PPE_GLO_CFG(bank));
+		airoha_ppe_ct_regs(ppe, bank, false);
+	}
+	err = airoha_ppe_ct_check_sram(ppe, false);
+	if (err)
+		return err;
+
+	ppe->ct_restore_pending = true;
+	err = airoha_ppe_ct_quiesce(ppe);
+	if (err)
+		return err;
+	ppe->ct_owns_sram = true;
+	airoha_ppe_hw_init(ppe, true);
+	for (bank = 0; bank < eth->soc->num_ppe; bank++) {
+		u32 hash = airoha_fe_rr(eth, REG_PPE_TB_HASH_CFG(bank));
+
+		if (!(hash & PPE_SRAM_TABLE_EN_MASK) ||
+		    (hash & (PPE_DRAM_TABLE_EN_MASK | PPE_DRAM_HASH1_EN_MASK)) ||
+		    !airoha_ppe_ct_learning_init(eth, bank))
+			goto rollback;
+	}
+	for (bank = 0; bank < eth->soc->num_ppe; bank++)
+		airoha_fe_set(eth, REG_PPE_GLO_CFG(bank), PPE_GLO_CFG_EN_MASK);
+	airoha_ppe_hw_init_ports(ppe);
+	for (bank = 0; bank < eth->soc->num_ppe; bank++) {
+		airoha_fe_set(eth, REG_PPE_PPE_FLOW_CFG(bank), CT_HOST_IPV4_FLOWS);
+		if (!airoha_ppe_is_enabled(eth, bank) ||
+		    airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(bank)) != CT_HOST_IPV4_FLOWS)
+			goto rollback;
+	}
+	WRITE_ONCE(ppe->ct_host_ppe, true);
+	return 0;
+
+rollback:
+	err = airoha_ppe_ct_stop(ppe);
+	return err ?: -EIO;
+}
