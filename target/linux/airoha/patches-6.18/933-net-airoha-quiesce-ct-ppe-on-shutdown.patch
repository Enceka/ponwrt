+void airoha_ppe_ct_shutdown(struct airoha_eth *eth)
+{
+	struct airoha_ppe *ppe = eth->ppe;
+	int err;
+
+	if (!airoha_ppe_ct_requested(eth))
+		return;
+
+	mutex_lock(&flow_offload_mutex);
+	spin_lock_bh(&ppe_lock);
+	ppe->ct_stopping = true;
+	spin_unlock_bh(&ppe_lock);
+	if (ppe->ct_restore_pending) {
+		err = airoha_ppe_ct_stop(ppe);
+		if (err)
+			dev_err(eth->dev, "CT PPE shutdown: %d\n", err);
+		else
+			dev_info(eth->dev, "CT PPE shutdown: banks restored\n");
+	}
+	mutex_unlock(&flow_offload_mutex);
+}
