+static int airoha_ppe_ct_stop_learning(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	u32 no_foe = FIELD_PREP(PPE_TB_CFG_SEARCH_MISS_MASK, 2);
+	int bank, err;
+	u32 val;
+
+	for (bank = 0; bank < eth->soc->num_ppe; bank++) {
+		airoha_fe_rmw(eth, REG_PPE_TB_CFG(bank), PPE_TB_CFG_SEARCH_MISS_MASK, no_foe);
+		airoha_fe_clear(eth, REG_PPE_PPE_FLOW_CFG(bank), CT_HOST_IPV4_FLOWS);
+	}
+	for (bank = 0; bank < eth->soc->num_ppe; bank++) {
+		u32 flow = airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(bank));
+		u32 tb = airoha_fe_rr(eth, REG_PPE_TB_CFG(bank));
+
+		if (flow || (tb & PPE_TB_CFG_SEARCH_MISS_MASK) != no_foe) {
+			dev_err(eth->dev, "CT PPE stop learning bank=%d flow=%08x tb=%08x\n", bank, flow, tb);
+			return -EBUSY;
+		}
+		err = read_poll_timeout(airoha_fe_rr, val, !(val & PPE_GLO_CFG_BUSY_MASK),
+					10, 100000, false, eth, REG_PPE_GLO_CFG(bank));
+		if (err || !(val & PPE_GLO_CFG_EN_MASK)) {
+			dev_err(eth->dev, "CT PPE drain bank=%d glo=%08x\n", bank, val);
+			return err ?: -EIO;
+		}
+	}
+	return 0;
+}
