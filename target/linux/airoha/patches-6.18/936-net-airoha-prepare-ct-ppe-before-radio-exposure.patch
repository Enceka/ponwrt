From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: prepare CT PPE before registering network devices

Try to acquire the CT SRAM owner after all GDM ports are allocated and
before publishing the network devices. Keep the native Ethernet path
available if preparation is deferred or foreign SRAM entries are found.
Expose an idempotent preparation API for wireless consumers to check the
same owner before exposing their DMA rings. Preserve all cold SRAM gates.

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -865,6 +865,7 @@
 int airoha_ppe_init(struct airoha_eth *eth);
 void airoha_ppe_deinit(struct airoha_eth *eth);
 void airoha_ppe_ct_shutdown(struct airoha_eth *eth);
+int airoha_ppe_ct_prepare(struct airoha_eth *eth);
 void airoha_ppe_init_upd_mem(struct airoha_gdm_dev *dev, const u8 *addr);
 u32 airoha_ppe_get_total_num_entries(struct airoha_ppe *ppe);
 struct airoha_foe_entry *airoha_ppe_foe_get_entry(struct airoha_ppe *ppe,
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1958,9 +1958,12 @@
-static int airoha_ppe_offload_setup(struct airoha_eth *eth)
+static int airoha_ppe_offload_setup(struct airoha_eth *eth, bool load_module)
 {
-	struct airoha_npu *npu = airoha_ppe_npu_get(eth);
+	struct airoha_npu *npu = load_module ? airoha_ppe_npu_get(eth) :
+					    airoha_npu_get(eth->dev);
 	struct airoha_ppe *ppe = eth->ppe;
 	int err, ppe_num_stats_entries;
 
 	if (IS_ERR(npu))
 		return PTR_ERR(npu);
+	if (!npu)
+		return -EOPNOTSUPP;
 	if (airoha_ppe_ct_requested(eth)) {
@@ -2002,6 +2005,42 @@
 	return err;
 }
 
+int airoha_ppe_ct_prepare(struct airoha_eth *eth)
+{
+	struct airoha_ppe *ppe = eth->ppe;
+	int err = 0;
+
+	if (!airoha_ppe_ct_requested(eth))
+		return -EOPNOTSUPP;
+	if (!test_bit(DEV_STATE_INITIALIZED, &eth->state))
+		return -EPROBE_DEFER;
+
+	mutex_lock(&flow_offload_mutex);
+	if (ppe->ct_stopping)
+		err = -ESHUTDOWN;
+	else if (!rcu_access_pointer(eth->npu))
+		err = airoha_ppe_offload_setup(eth, false);
+	else if (!READ_ONCE(ppe->ct_host_ppe) || !ppe->ct_owns_sram ||
+		 !ppe->ct_restore_pending)
+		err = -EBUSY;
+	mutex_unlock(&flow_offload_mutex);
+
+	return err;
+}
+
+int airoha_ppe_ct_prepare_dev(struct airoha_ppe_dev *dev)
+{
+	struct airoha_ppe *ppe;
+
+	if (!dev || !dev->priv)
+		return -ENODEV;
+	ppe = dev->priv;
+	if (!test_bit(DEV_STATE_REGISTERED, &ppe->eth->state))
+		return -EPROBE_DEFER;
+	return airoha_ppe_ct_prepare(ppe->eth);
+}
+EXPORT_SYMBOL_GPL(airoha_ppe_ct_prepare_dev);
+
 int airoha_ppe_setup_tc_block_cb(struct airoha_ppe_dev *dev, void *type_data)
 {
 	struct airoha_ppe *ppe = dev->priv;
@@ -2037,7 +2076,7 @@
 	if (ppe->ct_stopping)
 		err = -ESHUTDOWN;
 	else if (!eth->npu)
-		err = airoha_ppe_offload_setup(eth);
+		err = airoha_ppe_offload_setup(eth, true);
 	if (!err)
 		err = airoha_ppe_flow_offload_cmd(eth, type_data);
 
@@ -2221,6 +2260,12 @@
 
 	mutex_lock(&flow_offload_mutex);
 
+	if (airoha_ppe_ct_requested(eth)) {
+		spin_lock_bh(&ppe_lock);
+		eth->ppe->ct_stopping = true;
+		spin_unlock_bh(&ppe_lock);
+	}
+
 	npu = rcu_replace_pointer(eth->npu, NULL,
 				  lockdep_is_held(&flow_offload_mutex));
 	if (npu) {
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -4837,6 +4837,11 @@
 		}
 	}
 
+	err = airoha_ppe_ct_prepare(eth);
+	if (err && err != -EOPNOTSUPP)
+		dev_info(eth->dev, "CT PPE eager preparation: %d; native Ethernet retained\n",
+			 err);
+
 	err = airoha_register_gdm_devices(eth);
 	if (err)
 		goto error_napi_stop;
--- a/include/linux/soc/airoha/airoha_offload.h
+++ b/include/linux/soc/airoha/airoha_offload.h
@@ -29,6 +29,7 @@
 #if (IS_BUILTIN(CONFIG_NET_AIROHA) || IS_MODULE(CONFIG_NET_AIROHA))
 struct airoha_ppe_dev *airoha_ppe_get_dev(struct device *dev);
 void airoha_ppe_put_dev(struct airoha_ppe_dev *dev);
+int airoha_ppe_ct_prepare_dev(struct airoha_ppe_dev *dev);
 
 static inline int airoha_ppe_dev_setup_tc_block_cb(struct airoha_ppe_dev *dev,
 						   void *type_data)
@@ -58,6 +59,11 @@
 {
 }
 
+static inline int airoha_ppe_ct_prepare_dev(struct airoha_ppe_dev *dev)
+{
+	return -EOPNOTSUPP;
+}
+
 static inline int airoha_ppe_dev_setup_tc_block_cb(struct airoha_ppe_dev *dev,
 						   void *type_data)
 {
