--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_ct_ifc.h
@@ -0,0 +1,328 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef AIROHA_CT_IFC_H
+#define AIROHA_CT_IFC_H
+
+#define CT_IFC_CONTROL			0x204
+#define CT_IFC_DONE			BIT(31)
+#define CT_IFC_DATA(_word)		(0x210 + 4 * (_word))
+#define CT_IFC_UDF0			0x220
+#define CT_IFC_UDF0_MASK		GENMASK(15, 0)
+#define CT_IFC_UDF0_IPV4_LENGTH		((2 << 2) | 1)
+#define CT_IFC_TCAM_BANK		0
+#define CT_IFC_LUT1_BANK		1
+#define CT_IFC_ACTION_BANK		2
+#define CT_IFC_RULE_COUNT		64
+#define CT_IFC_LUT1_COUNT		32
+#define CT_IFC_RULE			(CT_IFC_RULE_COUNT - 1)
+#define CT_IFC_ACTION_ENABLE		BIT(31)
+#define CT_IFC_ACTION_STOP		BIT(30)
+#define CT_IFC_ACTION_FORCE_CPU		BIT(28)
+#define CT_IFC_LUT1_ENABLE		BIT(15)
+#define CT_IFC_LUT1_END			BIT(14)
+#define CT_IFC_LUT1_RANGE		(2 << 6)
+#define CT_IFC_LUT1_UDF0		32
+#define CT_IFC_TCAM_TYPE1		0x40
+#define CT_IFC_TCAM_TYPE_MASK		0xc0
+#define CT_IFC_TCAM_IPV4_VALID		BIT(1)
+#define CT_IFC_CPU_RX_RING		1
+#define CT_IFC_IPV4_LEN_MAX		57
+
+static struct net_device *airoha_ppe_ct_ifc_ingress(struct airoha_eth *eth)
+{
+	struct airoha_gdm_port *port = eth->ports[AIROHA_GDM4_IDX - 1];
+	unsigned int index;
+
+	if (!port || port->id != AIROHA_GDM4_IDX || !eth->soc->ops.get_vip_port ||
+	    eth->soc->ops.get_vip_port(port, 0) != XSI_ETH_VIP_PORT_MASK)
+		return NULL;
+	for (index = 0; index < ARRAY_SIZE(port->devs); index++) {
+		struct airoha_gdm_dev *gdm = port->devs[index];
+
+		if (gdm && !gdm->nbq)
+			return netdev_from_priv(gdm);
+	}
+	return NULL;
+}
+
+static bool airoha_ppe_ct_ifc_covers(struct airoha_ppe *ppe, struct flow_rule *rule,
+				     struct net_device *egress)
+{
+	struct airoha_eth *eth = ppe->eth;
+	struct net_device *ingress = airoha_ppe_ct_ifc_ingress(eth);
+	struct flow_match_basic basic;
+	struct flow_match_meta match;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!ppe->ct_ifc.cfg_owned || !ingress || !net_eq(dev_net(ingress), dev_net(egress)) ||
+	    !(airoha_fe_rr(eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK) ||
+	    airoha_fe_rr(eth, REG_FE_IFC_PORT_EN) != XSI_ETH_VIP_PORT_MASK ||
+	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN) ||
+	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CVLAN) ||
+	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PPPOE) ||
+	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_ENC_CONTROL))
+		return false;
+
+	flow_rule_match_basic(rule, &basic);
+	if (basic.mask->n_proto != htons(U16_MAX) ||
+	    basic.key->n_proto != htons(ETH_P_IP))
+		return false;
+	flow_rule_match_meta(rule, &match);
+	return (u32)match.mask->ingress_ifindex == U32_MAX &&
+	       (u32)match.key->ingress_ifindex == (u32)ingress->ifindex;
+}
+
+static int ct_ifc_access(struct airoha_eth *eth, unsigned int bank,
+			 unsigned int index, unsigned int page, bool write,
+			 u32 *words, unsigned int count)
+{
+	u32 command = (index << 16) | (page << 8) | (bank << 4) | 1;
+	unsigned int word;
+	u32 status;
+	int err;
+
+	if (write) {
+		for (word = 0; word < count; word++)
+			airoha_fe_wr(eth, CT_IFC_DATA(word), words[word]);
+		command |= BIT(1);
+	}
+	airoha_fe_wr(eth, CT_IFC_CONTROL, command);
+	err = read_poll_timeout(airoha_fe_rr, status, status & CT_IFC_DONE,
+				2, 1000, false, eth, CT_IFC_CONTROL);
+	if (err) {
+		dev_warn(eth->dev, "CT IFC command %08x timed out: %08x\n", command, status);
+		return err;
+	}
+	if (!write)
+		for (word = 0; word < count; word++)
+			words[word] = airoha_fe_rr(eth, CT_IFC_DATA(word));
+	return 0;
+}
+
+static int ct_ifc_write_verify(struct airoha_eth *eth, unsigned int bank,
+			       unsigned int index, unsigned int page, u32 *words,
+			       unsigned int count)
+{
+	u32 actual[3];
+	bool match;
+	int err;
+
+	err = ct_ifc_access(eth, bank, index, page, true, words, count);
+	if (!err)
+		err = ct_ifc_access(eth, bank, index, page, false, actual, count);
+	if (err)
+		return err;
+	if (bank == CT_IFC_TCAM_BANK)
+		match = actual[1] == words[1] && !((actual[0] ^ words[0]) & words[1]);
+	else
+		match = !memcmp(actual, words, count * sizeof(*words));
+	if (!match) {
+		dev_warn(eth->dev, "CT IFC bank=%u row=%u page=%u expected=%*phN actual=%*phN\n",
+			 bank, index, page, (int)(count * sizeof(*words)), words,
+			 (int)(count * sizeof(*words)), actual);
+		return -EIO;
+	}
+	return 0;
+}
+
+static const u8 ct_ifc_action_words[] = { 2, 3, 1 };
+
+static int ct_ifc_audit(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	u64 active = 0;
+	u32 used_lut = 0;
+	unsigned int index, page;
+	u32 words[2];
+	int err;
+
+	for (index = 0; index < CT_IFC_RULE_COUNT; index++) {
+		err = ct_ifc_access(eth, CT_IFC_ACTION_BANK, index, 2, false, words, 1);
+		if (err)
+			return err;
+		if (words[0] & CT_IFC_ACTION_ENABLE)
+			active |= BIT_ULL(index);
+		if (index == CT_IFC_RULE)
+			ppe->ct_ifc.action[2][0] = words[0];
+	}
+	for (index = 0; index < CT_IFC_LUT1_COUNT; index++) {
+		err = ct_ifc_access(eth, CT_IFC_LUT1_BANK, index, 0, false, words, 2);
+		if (err)
+			return err;
+		if (words[1] & CT_IFC_LUT1_ENABLE) {
+			used_lut |= BIT(index);
+		} else {
+			ppe->ct_ifc.lut_index = index;
+			memcpy(ppe->ct_ifc.lut, words, sizeof(words));
+		}
+	}
+	if (active || used_lut == U32_MAX)
+		return -EBUSY;
+
+	for (page = 0; page < 2; page++) {
+		err = ct_ifc_access(eth, CT_IFC_ACTION_BANK, CT_IFC_RULE, page, false,
+				    ppe->ct_ifc.action[page], ct_ifc_action_words[page]);
+		if (err)
+			return err;
+	}
+	for (page = 0; page < ARRAY_SIZE(ppe->ct_ifc.tcam); page++) {
+		err = ct_ifc_access(eth, CT_IFC_TCAM_BANK, CT_IFC_RULE, page, false,
+				    ppe->ct_ifc.tcam[page], 2);
+		if (err)
+			return err;
+	}
+	return 0;
+}
+
+static int ct_ifc_write_reg(struct airoha_eth *eth, u32 reg, u32 mask, u32 value)
+{
+	if (!mask)
+		return 0;
+	airoha_fe_rmw(eth, reg, mask, value & mask);
+	return (airoha_fe_rr(eth, reg) & mask) == (value & mask) ? 0 : -EIO;
+}
+
+static int airoha_ppe_ct_ifc_stop(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	unsigned int page;
+	int err = 0;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!ppe->ct_ifc.cfg_owned && !eth->ct_ifc_port_mask && !ppe->ct_ifc.udf_owned &&
+	    !ppe->ct_ifc.lut_dirty && !ppe->ct_ifc.tcam_dirty && !ppe->ct_ifc.action_dirty)
+		return 0;
+	if (ppe->ct_ifc.cfg_owned) {
+		err = ct_ifc_write_reg(eth, REG_FE_CSR_IFC_CFG, FE_IFC_EN_MASK, 0);
+		if (err) {
+			dev_err(eth->dev, "CT IFC could not disable classifier: %d\n", err);
+			return err;
+		}
+		ppe->ct_ifc.cfg_owned = false;
+	}
+	if (airoha_fe_rr(eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK) {
+		dev_err(eth->dev, "CT IFC classifier is owned elsewhere; restoration deferred\n");
+		return -EBUSY;
+	}
+	for (page = ARRAY_SIZE(ct_ifc_action_words); page-- > 0;) {
+		if (ppe->ct_ifc.action_dirty & BIT(page)) {
+			int ret = ct_ifc_write_verify(eth, CT_IFC_ACTION_BANK, CT_IFC_RULE,
+						      page, ppe->ct_ifc.action[page],
+						      ct_ifc_action_words[page]);
+
+			if (ret)
+				err = ret;
+			else
+				ppe->ct_ifc.action_dirty &= ~BIT(page);
+		}
+	}
+	for (page = 0; page < ARRAY_SIZE(ppe->ct_ifc.tcam); page++) {
+		if (ppe->ct_ifc.tcam_dirty & BIT(page)) {
+			int ret = ct_ifc_write_verify(eth, CT_IFC_TCAM_BANK, CT_IFC_RULE,
+						      page, ppe->ct_ifc.tcam[page], 2);
+
+			if (ret)
+				err = ret;
+			else
+				ppe->ct_ifc.tcam_dirty &= ~BIT(page);
+		}
+	}
+	if (ppe->ct_ifc.lut_dirty) {
+		int ret = ct_ifc_write_verify(eth, CT_IFC_LUT1_BANK, ppe->ct_ifc.lut_index, 0,
+					      ppe->ct_ifc.lut, ARRAY_SIZE(ppe->ct_ifc.lut));
+
+		if (ret)
+			err = ret;
+		else
+			ppe->ct_ifc.lut_dirty = false;
+	}
+	if (ppe->ct_ifc.udf_owned) {
+		int ret = ct_ifc_write_reg(eth, CT_IFC_UDF0, CT_IFC_UDF0_MASK, ppe->ct_ifc.udf);
+
+		if (ret)
+			err = ret;
+		else
+			ppe->ct_ifc.udf_owned = false;
+	}
+	if (eth->ct_ifc_port_mask && airoha_ifc_scope_ports(eth, 0))
+		err = -EIO;
+	if (err)
+		dev_err(eth->dev, "CT IFC restoration failed: %d\n", err);
+	return err;
+}
+
+static void airoha_ppe_ct_ifc_start(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	u32 range[] = { (CT_IFC_IPV4_LEN_MAX << 16) | sizeof(struct iphdr),
+			CT_IFC_LUT1_ENABLE | CT_IFC_LUT1_END | CT_IFC_LUT1_RANGE | CT_IFC_LUT1_UDF0 };
+	u32 action[][3] = { {}, { 0, 0, CT_IFC_CPU_RX_RING << 10 },
+			    { CT_IFC_ACTION_ENABLE | CT_IFC_ACTION_STOP | CT_IFC_ACTION_FORCE_CPU } };
+	unsigned int page;
+	int err;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!READ_ONCE(ppe->ct_host_ppe))
+		return;
+	if (ppe->ct_ifc.cfg_owned || eth->ct_ifc_port_mask || ppe->ct_ifc.udf_owned ||
+	    ppe->ct_ifc.lut_dirty || ppe->ct_ifc.tcam_dirty || ppe->ct_ifc.action_dirty)
+		return;
+	if (!airoha_ppe_ct_ifc_ingress(eth)) {
+		err = -ENODEV;
+		goto fail;
+	}
+	if (airoha_fe_rr(eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK) {
+		err = -EBUSY;
+		goto fail;
+	}
+	err = ct_ifc_audit(ppe);
+	if (err)
+		goto fail;
+	ppe->ct_ifc.udf = airoha_fe_rr(eth, CT_IFC_UDF0);
+	if ((ppe->ct_ifc.udf & CT_IFC_UDF0_MASK) != CT_IFC_UDF0_IPV4_LENGTH) {
+		ppe->ct_ifc.udf_owned = true;
+		err = ct_ifc_write_reg(eth, CT_IFC_UDF0, CT_IFC_UDF0_MASK, CT_IFC_UDF0_IPV4_LENGTH);
+		if (err)
+			goto fail;
+	}
+	ppe->ct_ifc.lut_dirty = true;
+	err = ct_ifc_write_verify(eth, CT_IFC_LUT1_BANK, ppe->ct_ifc.lut_index, 0,
+				  range, ARRAY_SIZE(range));
+	if (err)
+		goto fail;
+	for (page = ARRAY_SIZE(ppe->ct_ifc.tcam); page-- > 0;) {
+		u32 words[2] = {};
+
+		if (page == 8) {
+			words[0] = CT_IFC_TCAM_TYPE1 | CT_IFC_TCAM_IPV4_VALID;
+			words[1] = CT_IFC_TCAM_TYPE_MASK | CT_IFC_TCAM_IPV4_VALID;
+		} else if (page == 4) {
+			words[0] = BIT(ppe->ct_ifc.lut_index);
+			words[1] = words[0];
+		}
+		ppe->ct_ifc.tcam_dirty |= BIT(page);
+		err = ct_ifc_write_verify(eth, CT_IFC_TCAM_BANK, CT_IFC_RULE, page, words, 2);
+		if (err)
+			goto fail;
+	}
+	for (page = 0; page < ARRAY_SIZE(ct_ifc_action_words); page++) {
+		ppe->ct_ifc.action_dirty |= BIT(page);
+		err = ct_ifc_write_verify(eth, CT_IFC_ACTION_BANK, CT_IFC_RULE, page,
+					  action[page], ct_ifc_action_words[page]);
+		if (err)
+			goto fail;
+	}
+	err = airoha_ifc_scope_ports(eth, XSI_ETH_VIP_PORT_MASK);
+	if (err)
+		goto fail;
+	ppe->ct_ifc.cfg_owned = true;
+	err = ct_ifc_write_reg(eth, REG_FE_CSR_IFC_CFG, FE_IFC_EN_MASK, FE_IFC_EN_MASK);
+	if (err)
+		goto fail;
+	return;
+
+fail:
