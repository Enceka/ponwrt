+		ret = -EBUSY;
+		goto out;
+	}
+	for (i = 0; i < ARRAY_SIZE(ppe->ct_smac); i++) {
+		/* A partially cleared entry must never satisfy a later get(). */
+		ppe->ct_smac[i].valid = false;
+		for (word = 0; word < 2; word++) {
+			if (!(ppe->ct_smac[i].dirty & BIT(word)))
+				continue;
+
+			err = airoha_ppe_smac_write(ppe->eth,
+						    AIROHA_CT_SMAC_FIRST + i,
+						    word, 0);
+			if (err) {
+				if (!ret)
+					ret = err;
+				continue;
+			}
+			ppe->ct_smac[i].dirty &= ~BIT(word);
+		}
+	}
+out:
+	spin_unlock_bh(&ppe_lock);
+
+	return ret;
+}
