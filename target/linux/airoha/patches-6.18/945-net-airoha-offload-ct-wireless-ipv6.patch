+static int airoha_dev_setup_tc_block_cb(enum tc_setup_type type,
+					void *type_data, void *cb_priv)
+{
+	struct airoha_gdm_dev *dev = netdev_priv(cb_priv);
+	struct airoha_eth *eth = dev->eth;
+
+	if (type == TC_SETUP_CLSFLOWER && airoha_ppe_ct_requested(eth)) {
+		struct flow_cls_offload *f = type_data;
+
+		if (f->command == FLOW_CLS_REPLACE) {
+			struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+			struct flow_match_control control;
+
+			/* The CT IPv6 tuple cannot express arbitrary flower matches. */
+			if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CONTROL)) {
+				flow_rule_match_control(rule, &control);
+				if (control.key->addr_type == FLOW_DISSECTOR_KEY_IPV6_ADDRS)
+					return -EOPNOTSUPP;
+			}
+		}
+	}
+
+	return airoha_dev_setup_ft_block_cb(type, type_data, cb_priv);
+}
