+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __AIROHA_CT_SMAC_H
+#define __AIROHA_CT_SMAC_H
+
+/* GDM uses 1..4 and 15 preserves the ingress source address.  CT owns 5..14
+ * after taking over two empty PPE SRAM banks with DRAM lookup disabled.
+ * Entries reference immutable slots until both banks have been drained.
+ */
+#define AIROHA_CT_SMAC_FIRST	5
+#define AIROHA_CT_SMAC_COUNT	10
+
+static int airoha_ppe_smac_write(struct airoha_eth *eth, u8 id, u8 word,
+				 u32 value)
+{
+	u32 ctrl, val;
+
+	lockdep_assert_held(&ppe_lock);
+	if (id > 15 || word > 1)
+		return -EINVAL;
+
+	ctrl = FIELD_PREP(PPE_UPDMEM_ADDR_MASK, id) |
+	       FIELD_PREP(PPE_UPDMEM_OFFSET_MASK, word) |
+	       PPE_UPDMEM_WR_MASK | PPE_UPDMEM_REQ_MASK;
+	airoha_fe_wr(eth, REG_UPDMEM_DATA(0), value);
+
+	/* The source MAC table is shared through bank 0, including PPE2 flows. */
+	wmb();
+	airoha_fe_wr(eth, REG_UPDMEM_CTRL(0), ctrl);
+	return read_poll_timeout_atomic(airoha_fe_rr, val,
+					val & PPE_UPDMEM_ACK_MASK,
+					10, 1000, false, eth,
+					REG_UPDMEM_CTRL(0));
+}
+
+static int airoha_ppe_ct_smac_get(struct airoha_ppe *ppe, const u8 *addr,
+				  u8 *id)
+{
+	u32 values[2] = {
+		get_unaligned_be32(addr + 2), get_unaligned_be16(addr),
+	};
+	unsigned int i, word;
+	int err = -ENOSPC;
+
+	BUILD_BUG_ON(ARRAY_SIZE(ppe->ct_smac) != AIROHA_CT_SMAC_COUNT);
+	spin_lock_bh(&ppe_lock);
+	if (!ppe->ct_host_ppe || !ppe->ct_owns_sram || ppe->ct_stopping) {
+		err = -EBUSY;
+		goto out;
+	}
+	for (i = 0; i < ARRAY_SIZE(ppe->ct_smac); i++) {
+		if (ppe->ct_smac[i].valid &&
+		    ether_addr_equal(ppe->ct_smac[i].addr, addr)) {
+			*id = AIROHA_CT_SMAC_FIRST + i;
+			err = 0;
+			goto out;
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(ppe->ct_smac); i++) {
+		u8 slot = AIROHA_CT_SMAC_FIRST + i;
+
+		if (ppe->ct_smac[i].valid || ppe->ct_smac[i].dirty)
+			continue;
+
+		for (word = 0; word < ARRAY_SIZE(values); word++) {
+			/* A timed-out write can already have changed the table. */
+			ppe->ct_smac[i].dirty |= BIT(word);
+			err = airoha_ppe_smac_write(ppe->eth, slot, word,
+						    values[word]);
+			if (err)
+				goto out;
+		}
+
+		ether_addr_copy(ppe->ct_smac[i].addr, addr);
+		ppe->ct_smac[i].valid = true;
+		*id = slot;
+		err = 0;
+		break;
+	}
+out:
+	spin_unlock_bh(&ppe_lock);
+	return err;
+}
+
+/* Stop admissions, drain and quiesce both PPE banks before clearing owned
+ * words.  Failed writes retain their dirty bit so cleanup is retryable.
+ */
+static int airoha_ppe_ct_smac_stop(struct airoha_ppe *ppe)
+{
