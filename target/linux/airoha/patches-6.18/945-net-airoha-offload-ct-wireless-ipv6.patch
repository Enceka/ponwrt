+static bool airoha_ppe_ct_wlan_dest(const struct airoha_foe_entry *hwe,
+				    u8 *band, u16 *wcid)
+{
+	u32 type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+	u32 ib2, data, nbq;
+	u16 etype;
+
+	switch (type) {
+	case PPE_PKT_TYPE_IPV4_HNAPT:
+		ib2 = hwe->ipv4.ib2;
+		data = hwe->ipv4.data;
+		etype = hwe->ipv4.l2.common.etype;
+		break;
+	case PPE_PKT_TYPE_IPV6_ROUTE_5T:
+		ib2 = hwe->ipv6.ib2;
+		data = hwe->ipv6.data;
+		etype = hwe->ipv6.l2.etype;
+		break;
+	default:
+		return false;
+	}
+	nbq = FIELD_GET(AIROHA_FOE_IB2_NBQ, ib2);
+	if (FIELD_GET(AIROHA_FOE_IB2_PSE_PORT, ib2) != FE_PSE_PORT_GDM3 ||
+	    nbq < 2 || nbq > 3 ||
+	    FIELD_GET(AIROHA_FOE_CHANNEL, data) != 6 + nbq ||
+	    !(etype >> 6) || (etype >> 6) > 150)
+		return false;
+	*band = nbq - 2;
+	*wcid = etype >> 6;
+	return true;
+}
