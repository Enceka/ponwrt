+
+u32 airoha_ppe_ct_wlan_epoch(struct airoha_ppe_dev *dev, u8 band, u16 wcid)
+{
+	struct airoha_ppe *ppe = dev->priv;
+	u32 epoch = 0;
+
+	if (band > 1 || !wcid || wcid > 150)
+		return 0;
+	spin_lock_bh(&ppe_lock);
+	if (ppe->ct_host_ppe && !ppe->ct_stopping)
+		epoch = airoha_ppe_ct_epoch_locked(ppe, band, wcid);
