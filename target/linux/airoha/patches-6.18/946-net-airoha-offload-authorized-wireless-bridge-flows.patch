+/* Called under ppe_lock, including atomic bridge policy notifications.
+ * Stop both engines on the first SRAM error; never poll every remaining row.
+ * Software cookies can be released only after both EN and BUSY are clear.
+ */
+static int airoha_ppe_ct_bridge_fail_closed(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	int bank, err;
+	u32 val;
+
+	lockdep_assert_held(&ppe_lock);
+	ppe->ct_bridge_failed = true;
+	ppe->ct_stopping = true;
+	for (bank = 0; bank < eth->soc->num_ppe; bank++) {
+		airoha_fe_wr(eth, REG_PPE_PPE_FLOW_CFG(bank), 0);
+		airoha_fe_clear(eth, REG_PPE_GLO_CFG(bank), PPE_GLO_CFG_EN_MASK);
+	}
+	for (bank = 0; bank < eth->soc->num_ppe; bank++) {
+		err = read_poll_timeout_atomic(airoha_fe_rr, val,
+			!(val & (PPE_GLO_CFG_EN_MASK | PPE_GLO_CFG_BUSY_MASK)),
+			1, 100, false, eth, REG_PPE_GLO_CFG(bank));
+		if (err)
+			return err;
+	}
+	return 0;
+}
+
+static int airoha_ppe_ct_remove_wlan_flow(struct airoha_ppe *ppe,
+					 struct airoha_flow_table_entry *e)
+{
+	int err;
+
+	spin_lock_bh(&ppe_lock);
+	if (e->ct_bridge && ppe->ct_bridge_failed) {
+		err = airoha_ppe_ct_bridge_fail_closed(ppe);
+		hlist_del_init(&e->list);
+	} else {
+		err = airoha_ppe_ct_remove_wlan_flow_locked(ppe, e);
+		if (err && e->ct_bridge)
+			err = airoha_ppe_ct_bridge_fail_closed(ppe);
+	}
+	if (!err && e->ct_bridge) {
+		e->hash = 0xffff;
+		list_del_init(&e->ct_bridge_node);
+	}
 	spin_unlock_bh(&ppe_lock);
 	return err;
+}
+
+/* Atomic switchdev notification: no mutex, allocation or source-MAC update.
+ * Cookies remain indexed and permanently dead until FT destroys them.
+ */
+static int airoha_ppe_ct_bridge_event(struct notifier_block *nb,
+				     unsigned long event, void *ptr)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe, ct_bridge_notifier);
+	struct switchdev_notifier_bridge_fwd_info *info = ptr;
+	struct airoha_flow_table_entry *e;
+	int err = 0;
+
+	if (event != SWITCHDEV_BRIDGE_FWD_PRE_CHANGE)
+		return NOTIFY_DONE;
+	spin_lock_bh(&ppe_lock);
+	if (!ppe->ct_host_ppe)
+		goto unlock;
+	if (ppe->ct_bridge_failed) {
+		info->err = airoha_ppe_ct_bridge_fail_closed(ppe);
+		goto unlock;
+	}
+	if (ppe->ct_stopping)
+		goto unlock;
+	list_for_each_entry(e, &ppe->ct_bridge_flows, ct_bridge_node) {
+		e->ct_bridge_dead = true;
+		if (err) {
+			hlist_del_init(&e->list);
+			continue;
+		}
+		err = airoha_ppe_ct_remove_wlan_flow_locked(ppe, e);
+		if (err) {
+			airoha_ppe_ct_bridge_fail_closed(ppe);
+			info->err = err;
+		}
+	}
+unlock:
+	spin_unlock_bh(&ppe_lock);
+	return NOTIFY_DONE;
 }
 
