+static bool airoha_ppe_ct_bridge_current(struct airoha_ppe *ppe,
+					struct airoha_flow_table_entry *e,
+					const struct airoha_ct_bridge_peer *peer,
+					struct sk_buff *skb)
+{
+	struct ethhdr buffer;
