+	struct airoha_npu *npu;
+	bool ready;
+
+	lockdep_assert_held(&ppe_lock);
+	rcu_read_lock();
+	npu = rcu_dereference(ppe->eth->npu);
+	ready = npu && npu->ops.wlan_short_guard_ready &&
+		npu->ops.wlan_short_guard_ready(npu);
+	rcu_read_unlock();
+	if (!ready)
+		return false;
+	if (e->ct_bridge_dead || ppe->ct_bridge_failed ||
+	    e->ct_bridge_generation != br_flow_offload_generation() ||
+	    !peer || !peer->epoch || peer->band != e->ct_src.band ||
+	    peer->bss != e->ct_src.bss || peer->wcid != e->ct_src.wcid ||
+	    peer->epoch != e->ct_src.epoch ||
+	    e->ct_src.epoch != airoha_ppe_ct_epoch_locked(ppe, e->ct_src.band,
