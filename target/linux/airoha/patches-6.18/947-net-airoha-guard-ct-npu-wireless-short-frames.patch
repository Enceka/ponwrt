+			smp_store_release(&npu->wlan_short_guard_started, true);
+			if (airoha_npu_wlan_short_guard_ready(npu))
+				dev_info(dev, "CT WLAN short-frame/DS guard ready: Ethernet < 72 or nonzero DS to host\n");
+		}
 	} else if (!airoha_npu_wlan_msg_get(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
 					    &val, sizeof(val), GFP_KERNEL)) {
 		dev_info(dev, "NPU fw version: %0d.%d\n",
@@ -920,8 +971,17 @@
