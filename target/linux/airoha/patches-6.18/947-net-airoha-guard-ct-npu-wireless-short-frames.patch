 }
 
+static void airoha_npu_shutdown(struct platform_device *pdev)
+{
+	struct airoha_npu *npu = platform_get_drvdata(pdev);
+
+	if (npu)
+		airoha_npu_wlan_short_guard_clear(npu);
+}
+
 static struct platform_driver airoha_npu_driver = {
 	.probe = airoha_npu_probe,
+	.shutdown = airoha_npu_shutdown,
 	.driver = {
 		.name = "airoha-npu",
 		.of_match_table = of_airoha_npu_match,
