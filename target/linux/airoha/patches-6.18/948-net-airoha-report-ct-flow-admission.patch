From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: expose read-only CT flow admission results

Record the original hardware flow callback result and software-flow presence
for CT IPv4/IPv6 TCP/UDP requests, without changing return values or hardware
accesses. Aggregate repeated cookie/tuple/error observations in 64 bounded
LRU buckets. Export a locked snapshot through a read-only debugfs file.

--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_ct_flow_admission.h
@@ -0,0 +1,79 @@
+#ifndef AIROHA_CT_FLOW_ADMISSION_H
+#define AIROHA_CT_FLOW_ADMISSION_H
+
+#define CT_FLOW_ADMISSION_BUCKETS 64
+
+struct ct_flow_admission_key {
+	unsigned long cookie;
+	u32 src[4], dest[4];
+	int ingress, egress;
+	int error;
+	u16 sport, dport;
+	u8 smac[6], dmac[6];
+	u8 protocol;
+	bool ipv6;
+};
+
+struct ct_flow_admission_bucket {
+	struct ct_flow_admission_key key;
+	u64 count, sequence;
+	u32 hash;
+	bool present, valid;
+};
+
+struct ct_flow_admission_table {
+	struct ct_flow_admission_bucket bucket[CT_FLOW_ADMISSION_BUCKETS];
+	u64 total, replaced;
+};
+
+static inline bool ct_flow_admission_equal(const struct ct_flow_admission_key *first,
+					  const struct ct_flow_admission_key *second)
+{
+	return first->cookie == second->cookie && first->ingress == second->ingress &&
+		first->egress == second->egress && first->error == second->error &&
+		first->sport == second->sport && first->dport == second->dport &&
+		first->protocol == second->protocol && first->ipv6 == second->ipv6 &&
+		!memcmp(first->src, second->src, sizeof(first->src)) &&
+		!memcmp(first->dest, second->dest, sizeof(first->dest)) &&
+		!memcmp(first->smac, second->smac, sizeof(first->smac)) &&
+		!memcmp(first->dmac, second->dmac, sizeof(first->dmac));
+}
+
+static inline void ct_flow_admission_record(struct ct_flow_admission_table *table,
+					    const struct ct_flow_admission_key *key,
+					    bool present, u32 hash)
+{
+	struct ct_flow_admission_bucket *chosen = NULL;
+	unsigned int index;
+
+	for (index = 0; index < CT_FLOW_ADMISSION_BUCKETS; index++) {
+		struct ct_flow_admission_bucket *bucket = &table->bucket[index];
+
+		if (bucket->valid && ct_flow_admission_equal(&bucket->key, key)) {
+			chosen = bucket;
+			break;
+		}
+	}
+	if (!chosen) {
+		chosen = &table->bucket[0];
+		for (index = 0; index < CT_FLOW_ADMISSION_BUCKETS; index++) {
+			struct ct_flow_admission_bucket *bucket = &table->bucket[index];
+
+			if (!bucket->valid) {
+				chosen = bucket;
+				break;
+			}
+			if (bucket->sequence < chosen->sequence)
+				chosen = bucket;
+		}
+		if (chosen->valid)
+			table->replaced++;
+		*chosen = (struct ct_flow_admission_bucket) { .key = *key, .valid = true };
+	}
+	chosen->count++;
+	chosen->sequence = ++table->total;
+	chosen->present = present;
+	chosen->hash = hash;
+}
+
+#endif
