+static int airoha_npu_ct_pair_cmd(struct airoha_npu *npu,
+				 struct airoha_ct_pair_msg *msg)
+{
+	struct {
+		__le32 command, function;
+		struct airoha_ct_pair_msg data;
+	} packet = {
+		.command = cpu_to_le32(NPU_OP_SET << 4),
+		.function = cpu_to_le32(AIROHA_CT_PAIR_FUNC),
+		.data = *msg,
+	};
+	struct airoha_ct_pair_msg reply = {};
+	int err;
+
+	if (!airoha_npu_wlan_short_guard_ready(npu) ||
+	    !of_property_read_bool(npu->dev->of_node, "airoha,connac2-rebuilt-ram-lab"))
+		return -EOPNOTSUPP;
+	packet.data.magic = cpu_to_le32(AIROHA_CT_PAIR_MAGIC);
+	packet.data.abi = cpu_to_le16(AIROHA_CT_PAIR_ABI);
+	packet.data.status = cpu_to_le32(-EINPROGRESS);
+	packet.data.caps = 0;
+	err = __airoha_npu_send_msg(npu, NPU_FUNC_WIFI, &packet, sizeof(packet),
+				    &reply, sizeof(reply));
+	if (err)
+		return err;
+	/* A stale/legacy success must never grant an endpoint pair. */
+	if (memcmp(&packet.data, &reply, offsetof(struct airoha_ct_pair_msg, status)))
+		return -EPROTO;
+	err = (s32)le32_to_cpu(reply.status);
+	/* Preparation has no capabilities yet; preserve its bounded retry. */
+	if (err == -EAGAIN && !le32_to_cpu(reply.caps))
+		return err;
+	if ((le32_to_cpu(reply.caps) & AIROHA_CT_PAIR_CAPS) != AIROHA_CT_PAIR_CAPS)
+		return -EPROTO;
+	if (err > 0)
+		return -EPROTO;
+	if (!err)
+		*msg = reply;
+	return err;
+}
