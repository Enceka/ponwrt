+/* Serialize explicit authorizations against every nft transaction. */
+static DEFINE_MUTEX(nf_native_pair_mutex);
+static BLOCKING_NOTIFIER_HEAD(nf_native_pair_chain);
+static u64 nf_native_pair_generation = 1;
+static unsigned int nf_native_pair_users;
+static atomic_t nf_native_pair_bpf_active = ATOMIC_INIT(0);
+
+u64 nf_native_pair_policy_generation(void)
+{
+	return READ_ONCE(nf_native_pair_generation);
+}
+EXPORT_SYMBOL_GPL(nf_native_pair_policy_generation);
+
+int nf_native_pair_policy_begin(void)
+{
+	int err;
+
+	mutex_lock(&nf_native_pair_mutex);
+	if (nf_native_pair_generation >= U64_MAX - 1) {
+		mutex_unlock(&nf_native_pair_mutex);
+		return -EOVERFLOW;
+	}
+	nf_native_pair_generation++;
+	err = notifier_to_errno(blocking_notifier_call_chain(&nf_native_pair_chain,
+						NF_NATIVE_PAIR_PRE, NULL));
+	if (err) {
+		blocking_notifier_call_chain(&nf_native_pair_chain, NF_NATIVE_PAIR_POST, NULL);
+		nf_native_pair_generation++;
+		mutex_unlock(&nf_native_pair_mutex);
+	}
+	return err;
+}
+EXPORT_SYMBOL_GPL(nf_native_pair_policy_begin);
+
+void nf_native_pair_policy_end(void)
+{
+	lockdep_assert_held(&nf_native_pair_mutex);
+	nf_native_pair_generation++;
+	blocking_notifier_call_chain(&nf_native_pair_chain, NF_NATIVE_PAIR_POST, NULL);
+	mutex_unlock(&nf_native_pair_mutex);
+}
+EXPORT_SYMBOL_GPL(nf_native_pair_policy_end);
+
+int nf_native_pair_policy_lock(u64 generation)
+{
+	mutex_lock(&nf_native_pair_mutex);
+	if (!generation || generation != nf_native_pair_generation) {
+		mutex_unlock(&nf_native_pair_mutex);
+		return -ESTALE;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(nf_native_pair_policy_lock);
+
+void nf_native_pair_policy_unlock(void)
+{
+	mutex_unlock(&nf_native_pair_mutex);
+}
+EXPORT_SYMBOL_GPL(nf_native_pair_policy_unlock);
+
+int nf_native_pair_register(struct notifier_block *nb)
+{
+	int err;
+
+	mutex_lock(&nf_native_pair_mutex);
+	if (atomic_read(&nf_native_pair_bpf_active))
+		err = -EBUSY;
+	else
+		err = blocking_notifier_chain_register(&nf_native_pair_chain, nb);
+	if (!err)
+		nf_native_pair_users++;
+	mutex_unlock(&nf_native_pair_mutex);
+	return err;
+}
+EXPORT_SYMBOL_GPL(nf_native_pair_register);
+
+void nf_native_pair_unregister(struct notifier_block *nb)
+{
+	mutex_lock(&nf_native_pair_mutex);
+	blocking_notifier_chain_unregister(&nf_native_pair_chain, nb);
+	nf_native_pair_users--;
+	mutex_unlock(&nf_native_pair_mutex);
+}
+EXPORT_SYMBOL_GPL(nf_native_pair_unregister);
+
+/* Native RAM sessions exclude dynamic XDP/TCX installation. Some callers
+ * hold RTNL: never wait here on a policy transaction that can take RTNL.
+ */
+int nf_native_pair_bpf_begin(void)
+{
+	if (!mutex_trylock(&nf_native_pair_mutex))
+		return -EBUSY;
+	if (nf_native_pair_users) {
+		mutex_unlock(&nf_native_pair_mutex);
+		return -EOPNOTSUPP;
+	}
+	atomic_inc(&nf_native_pair_bpf_active);
+	mutex_unlock(&nf_native_pair_mutex);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(nf_native_pair_bpf_begin);
+
+void nf_native_pair_bpf_end(void)
+{
+	atomic_dec(&nf_native_pair_bpf_active);
+}
+EXPORT_SYMBOL_GPL(nf_native_pair_bpf_end);
