From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: add native wireless MAC-pair offload

Add an explicit default-off, generation-checked policy gate for authorized
WLAN IPv4/IPv6 peers. Learn directed native L2B rows in PPE bank0 after
successful software bridge forwarding and reserve bank1 for routed flows.
Use mailbox pair/endpoint epochs and completion barriers before revoke.

Invalidate authorization before nft, bridge or endpoint changes; reject
unknown hooks and XDP/TCX installation. Tag and accept only the three native
bridge conntrack hooks at their exact bridge heads and priorities. Preserve
legacy NPU operation offsets and existing CT flow-admission diagnostics.

--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_ct_native_pair.h
@@ -0,0 +1,302 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included after checked PPE revoke helpers; all state uses ppe_lock. */
+#define CT_PAIR_ROWS 4
+#define CT_PAIR_RETRY_US 100000
+struct airoha_ct_native_pair {
+	struct airoha_ct_pair_msg msg;
+	struct airoha_foe_entry rows[CT_PAIR_ROWS];
+	u16 hashes[CT_PAIR_ROWS];
+	int ingress_ifindex, egress_ifindex;
+	bool used;
+};
+
+static bool airoha_ct_pair_any(struct airoha_ppe *ppe)
+{
+	unsigned int i;
+
+	lockdep_assert_held(&ppe_lock);
+	for (i = 0; i < AIROHA_CT_PAIR_SLOTS; i++)
+		if (ppe->ct_pairs[i].used)
+			return true;
+	return false;
+}
+
+static int airoha_ct_pair_exchange(struct airoha_npu *npu, struct airoha_ct_pair_msg *msg)
+{
+	ktime_t deadline = ktime_add_us(ktime_get(), CT_PAIR_RETRY_US);
+	int err;
+
+	if (!npu || !npu->ops.ct_pair_cmd)
+		return -EOPNOTSUPP;
+	do {
+		err = npu->ops.ct_pair_cmd(npu, msg);
+		if (err != -EAGAIN)
+			break;
+		/* Firmware must return to its done FIFO between revoke probes. */
+		udelay(10);
+	} while (ktime_before(ktime_get(), deadline));
+	return err == -EAGAIN ? -ETIMEDOUT : err;
+}
+
+static int airoha_ct_pair_send(struct airoha_ppe *ppe, struct airoha_ct_pair_msg *msg)
+{
+	struct airoha_npu *npu;
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+	rcu_read_lock();
+	npu = rcu_dereference(ppe->eth->npu);
+	err = airoha_ct_pair_exchange(npu, msg);
+	rcu_read_unlock();
+	return err;
+}
+
+static int airoha_ct_pair_fail(struct airoha_ppe *ppe, int err)
+{
+	int stop_err;
+
+	ppe->ct_pair_failed = true;
+	stop_err = airoha_ppe_ct_bridge_fail_closed(ppe);
+	ppe->ct_pair_hw_stopped = !stop_err;
+	return stop_err ?: err;
+}
+
+static bool airoha_ct_pair_key(const struct airoha_foe_entry *row,
+			       const struct airoha_ct_pair_msg *msg)
+{
+	return FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, row->ib1) == PPE_PKT_TYPE_BRIDGE &&
+	       row->l2b.src_mac_hi == get_unaligned_be32(msg->smac) &&
+	       row->l2b.src_mac_lo == get_unaligned_be16(msg->smac + 4) &&
+	       row->l2b.dest_mac_hi == get_unaligned_be32(msg->dmac) &&
+	       row->l2b.dest_mac_lo == get_unaligned_be16(msg->dmac + 4) &&
+	       !row->l2b.ingress_vlan;
+}
+
+static bool airoha_ct_pair_row_owned(const struct airoha_foe_entry *row,
+				     const struct airoha_foe_entry *saved)
+{
+	u32 variable = AIROHA_FOE_IB1_BIND_TIMESTAMP;
+
+	return !((row->ib1 ^ saved->ib1) & ~variable) &&
+	       !memcmp(&row->d, &saved->d, sizeof(*row) - sizeof(row->ib1));
+}
+
+static int airoha_ct_native_pair_revoke(struct airoha_ppe *ppe, int band, u16 wcid)
+{
+	struct airoha_ct_pair_msg msg = {};
+	int i, j, err;
+
+	lockdep_assert_held(&ppe_lock);
+	if (!ppe->ct_native_pairs)
+		return 0;
+	msg.op = cpu_to_le16(band < 0 ? AIROHA_CT_PAIR_FLUSH : AIROHA_CT_PAIR_ENDPOINT_REVOKE);
+	if (band >= 0) {
+		if (ppe->ct_wlan_epoch[band][wcid] == U32_MAX)
+			return airoha_ct_pair_fail(ppe, -EOVERFLOW);
+		msg.src_selector = !band;
+		msg.src_wcid = cpu_to_le16(wcid);
+		msg.src_epoch = cpu_to_le32(ppe->ct_wlan_epoch[band][wcid] + 1);
+	}
+	err = airoha_ct_pair_send(ppe, &msg);
+	if (err)
+		return airoha_ct_pair_fail(ppe, err);
+	for (i = 0; i < AIROHA_CT_PAIR_SLOTS; i++) {
+		struct airoha_ct_native_pair *pair = &ppe->ct_pairs[i];
+
+		if (!pair->used || (band >= 0 &&
+		    !(pair->msg.src_selector == !band && le16_to_cpu(pair->msg.src_wcid) == wcid) &&
+		    !(pair->msg.dst_selector == !band && le16_to_cpu(pair->msg.dst_wcid) == wcid)))
+			continue;
+		for (j = 0; j < CT_PAIR_ROWS; j++) {
+			struct airoha_foe_entry *row, invalid;
+
+			if (pair->hashes[j] == U16_MAX)
+				continue;
+			row = airoha_ppe_foe_get_entry_locked(ppe, pair->hashes[j]);
+			if (!row)
+				return airoha_ct_pair_fail(ppe, -ETIMEDOUT);
+			if (airoha_ct_pair_row_owned(row, &pair->rows[j])) {
+				invalid = *row;
+				invalid.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+				err = airoha_ppe_foe_commit_entry(ppe, &invalid, pair->hashes[j], true);
+				if (err)
+					return airoha_ct_pair_fail(ppe, err);
+			}
+		}
+		pair->used = false;
+	}
+	return 0;
+}
+
+static bool airoha_ct_pair_peers(struct airoha_ppe *ppe, struct net_device *idev,
+				struct net_device *odev, const struct ethhdr *hdr,
+				struct airoha_wdma_info *src,
+				struct airoha_wdma_info *dst)
+{
+	struct net_device *master;
+
+	if (!idev || !odev || !net_eq(dev_net(idev), &init_net) ||
+	    !net_eq(dev_net(odev), &init_net) || !idev->ieee80211_ptr || !odev->ieee80211_ptr ||
+	    !netif_is_bridge_port(idev) || !netif_is_bridge_port(odev) ||
+	    !is_valid_ether_addr(hdr->h_source) || !is_valid_ether_addr(hdr->h_dest) ||
+	    ether_addr_equal(hdr->h_source, hdr->h_dest))
+		return false;
+	master = netdev_master_upper_dev_get_rcu(idev);
+	if (!master || !netif_is_bridge_master(master) || br_vlan_enabled(master) ||
+	    master != netdev_master_upper_dev_get_rcu(odev) ||
+	    br_port_get_stp_state(idev) != BR_STATE_FORWARDING ||
+	    br_port_get_stp_state(odev) != BR_STATE_FORWARDING ||
+	    br_port_flag_is_set(idev, BR_ISOLATED | BR_PORT_LOCKED) ||
+	    br_port_flag_is_set(odev, BR_ISOLATED | BR_PORT_LOCKED) ||
+	    (idev == odev && !br_port_flag_is_set(idev, BR_HAIRPIN_MODE)) ||
+	    br_fdb_find_port(master, hdr->h_source, 0) != idev ||
+	    br_fdb_find_port(master, hdr->h_dest, 0) != odev ||
+	    wiphy_dev(idev->ieee80211_ptr->wiphy)->parent !=
+	    wiphy_dev(odev->ieee80211_ptr->wiphy)->parent ||
+	    airoha_ppe_get_wdma_info(idev, hdr->h_source, src, true) ||
+	    airoha_ppe_get_wdma_info(odev, hdr->h_dest, dst, true) ||
+	    src->idx > 1 || dst->idx > 1 || src->bss > 63 || dst->bss > 63 ||
+	    !src->wcid || !dst->wcid || src->wcid > 150 || dst->wcid > 150 ||
+	    (src->idx == dst->idx && src->wcid == dst->wcid))
+		return false;
+	return true;
+}
+
+static void airoha_ct_native_pair_frame(struct airoha_ppe *ppe, struct sk_buff *skb)
+{
+	struct airoha_wdma_info src = {}, dst = {};
+	struct airoha_ct_pair_msg msg = {};
+	struct airoha_ct_native_pair *pair;
+	struct net_device *idev, *odev = skb->dev;
+	const struct ethhdr *hdr = eth_hdr(skb);
+	u64 generation;
+	int i, free_slot = -1, err;
+
+	if (!READ_ONCE(ppe->ct_native_pairs) || !READ_ONCE(ppe->ct_pair_policy_allowed) ||
+	    skb_vlan_tag_present(skb) ||
+	    (hdr->h_proto != htons(ETH_P_IP) && hdr->h_proto != htons(ETH_P_IPV6)))
+		return;
+	generation = br_flow_offload_generation();
+	if (!generation)
+		return;
+	idev = dev_get_by_index_rcu(dev_net(odev), skb->skb_iif);
+	if (!airoha_ct_pair_peers(ppe, idev, odev, hdr, &src, &dst))
+		return;
+	msg.op = cpu_to_le16(AIROHA_CT_PAIR_PUT);
+	msg.generation = cpu_to_le64(generation);
+	msg.src_selector = !src.idx;
+	msg.dst_selector = !dst.idx;
+	msg.src_wcid = cpu_to_le16(src.wcid);
+	msg.dst_wcid = cpu_to_le16(dst.wcid);
+	msg.src_bss = src.bss;
+	msg.dst_bss = dst.bss;
+	ether_addr_copy(msg.smac, hdr->h_source);
+	ether_addr_copy(msg.dmac, hdr->h_dest);
+	spin_lock_bh(&ppe_lock);
+	if (!ppe->ct_pair_policy_allowed || !ppe->ct_host_ppe || ppe->ct_stopping || ppe->ct_pair_failed ||
+	    generation != br_flow_offload_generation() ||
+	    !airoha_ct_pair_peers(ppe, idev, odev, hdr, &src, &dst) ||
+	    msg.src_selector != !src.idx || msg.dst_selector != !dst.idx ||
+	    le16_to_cpu(msg.src_wcid) != src.wcid || le16_to_cpu(msg.dst_wcid) != dst.wcid ||
+	    msg.src_bss != src.bss || msg.dst_bss != dst.bss)
+		goto out;
+	msg.src_epoch = cpu_to_le32(airoha_ppe_ct_epoch_locked(ppe, src.idx, src.wcid));
+	msg.dst_epoch = cpu_to_le32(airoha_ppe_ct_epoch_locked(ppe, dst.idx, dst.wcid));
+	if (!msg.src_epoch || !msg.dst_epoch)
+		goto out;
+	for (i = 0; i < AIROHA_CT_PAIR_SLOTS; i++) {
+		pair = &ppe->ct_pairs[i];
+		if (!pair->used) {
+			if (free_slot < 0)
+				free_slot = i;
+			continue;
+		}
+		if (!memcmp(&pair->msg.generation, &msg.generation, 40))
+			goto out;
+	}
+	if (free_slot < 0)
+		goto out;
+	if (ppe->ct_pair_token == U32_MAX) {
+		airoha_ct_pair_fail(ppe, -EOVERFLOW);
+		goto out;
+	}
+	msg.slot = cpu_to_le32(free_slot);
+	msg.token = cpu_to_le32(++ppe->ct_pair_token);
+	pair = &ppe->ct_pairs[free_slot];
+	/* Record before PUT: a timeout may mean NPU consumed the request. */
+	pair->msg = msg;
+	pair->ingress_ifindex = idev->ifindex;
+	pair->egress_ifindex = odev->ifindex;
+	memset(pair->hashes, 0xff, sizeof(pair->hashes));
+	pair->used = true;
+	err = airoha_ct_pair_send(ppe, &msg);
+	if (err) {
+		airoha_ct_pair_fail(ppe, err);
+		goto out;
+	}
+	/* PUT ACK publishes admission; RX epoch isolation may delay learning. */
+	pair->msg = msg;
+out:
+	spin_unlock_bh(&ppe_lock);
+}
+
+static void airoha_ct_native_pair_bind(struct airoha_ppe *ppe, struct sk_buff *skb,
+				       u32 hash, const struct airoha_ct_bridge_peer *peer)
+{
+	struct airoha_ct_native_pair *pair;
+	struct airoha_foe_entry *learned, bound;
+	const struct ethhdr *hdr = eth_hdr(skb);
+	u64 generation = br_flow_offload_generation();
+	int i, j, row_slot, err;
+
+	lockdep_assert_held(&ppe_lock);
+	if (!ppe->ct_pair_policy_allowed || ppe->ct_pair_failed || !peer || !generation ||
+	    hash >= PPE_SRAM_NUM_ENTRIES)
+		return;
+	for (i = 0; i < AIROHA_CT_PAIR_SLOTS; i++) {
+		pair = &ppe->ct_pairs[i];
+		if (!pair->used || le64_to_cpu(pair->msg.generation) != generation ||
+		    peer->band != !pair->msg.src_selector || peer->bss != pair->msg.src_bss ||
+		    peer->wcid != le16_to_cpu(pair->msg.src_wcid) ||
+		    peer->epoch != le32_to_cpu(pair->msg.src_epoch) ||
+		    peer->epoch != airoha_ppe_ct_epoch_locked(ppe, peer->band, peer->wcid) ||
+		    le32_to_cpu(pair->msg.dst_epoch) != airoha_ppe_ct_epoch_locked(ppe,
+			!pair->msg.dst_selector, le16_to_cpu(pair->msg.dst_wcid)) ||
+		    !ether_addr_equal(hdr->h_source, pair->msg.smac) ||
+		    !ether_addr_equal(hdr->h_dest, pair->msg.dmac))
+			continue;
+		learned = airoha_ppe_foe_get_entry_locked(ppe, hash);
+		if (!learned) {
+			airoha_ct_pair_fail(ppe, -ETIMEDOUT);
+			return;
+		}
+		if (!airoha_ct_pair_key(learned, &pair->msg) ||
+		    FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, learned->ib1) != AIROHA_FOE_STATE_UNBIND ||
+		    learned->ib1 & AIROHA_FOE_IB1_BIND_STATIC)
+			return;
+		row_slot = -1;
+		for (j = 0; j < CT_PAIR_ROWS; j++)
+			if (pair->hashes[j] == hash || pair->hashes[j] == U16_MAX) {
+				row_slot = j;
+				break;
+			}
+		if (row_slot < 0)
+			return;
+		bound = *learned;
+		bound.ib1 = FIELD_PREP(AIROHA_FOE_IB1_BIND_PACKET_TYPE, PPE_PKT_TYPE_BRIDGE) |
+			    FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE, AIROHA_FOE_STATE_BIND);
+		bound.l2b.data = FIELD_PREP(AIROHA_FOE_SHAPER_ID, 0x7f) |
+			FIELD_PREP(AIROHA_FOE_CHANNEL, 8 + !pair->msg.dst_selector);
+		bound.l2b.ib2 = FIELD_PREP(AIROHA_FOE_IB2_PORT_AG, 0x1f) | AIROHA_FOE_IB2_PSE_QOS |
+			FIELD_PREP(AIROHA_FOE_IB2_NBQ, 2 + !pair->msg.dst_selector) |
+			FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT, FE_PSE_PORT_GDM3);
+		bound.l2b.etype = le16_to_cpu(pair->msg.dst_wcid) << 6 | pair->msg.dst_bss;
+		bound.l2b.vlan1 = bound.l2b.vlan2 = 0;
+		pair->hashes[row_slot] = hash;
+		err = airoha_ppe_foe_commit_entry(ppe, &bound, hash, true);
+		pair->rows[row_slot] = bound;
+		if (err)
+			airoha_ct_pair_fail(ppe, err);
+		return;
+	}
+}
--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_ct_pair_banks.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#define CT_NATIVE_FLOW BIT(15)
+
+static u32 airoha_ct_pair_flow_mask(struct airoha_ppe *ppe, int bank)
+{
+	return CT_HOST_IP_FLOWS | (ppe->ct_native_pairs && !bank ? CT_NATIVE_FLOW : 0);
+}
+
+/* Move only PPE1 selectors. GDM2's direct loopback, CPU and DROP are preserved. */
+static u32 airoha_ct_pair_gdm_route(u32 cfg)
+{
+	unsigned int shift;
+
+	for (shift = 0; shift < 16; shift += 4)
+		if (((cfg >> shift) & 0xf) == FE_PSE_PORT_PPE1)
+			cfg = (cfg & ~(0xf << shift)) | (FE_PSE_PORT_PPE2 << shift);
+	return cfg;
+}
+
+static int airoha_ct_pair_gdm_start(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	int i;
+
+	if (!ppe->ct_native_pairs)
+		return 0;
+	/* Save every selector before the first write so partial failure rolls back. */
+	for (i = AIROHA_GDM1_IDX; i <= AIROHA_GDM4_IDX; i++)
+		ppe->ct_pair_gdm_saved[i - 1] = airoha_fe_rr(eth, REG_GDM_FWD_CFG(i));
+	ppe->ct_pair_gdm_owned = true;
+	for (i = AIROHA_GDM1_IDX; i <= AIROHA_GDM4_IDX; i++) {
+		u32 value = airoha_ct_pair_gdm_route(ppe->ct_pair_gdm_saved[i - 1]);
+
+		airoha_fe_wr(eth, REG_GDM_FWD_CFG(i), value);
+		if (airoha_fe_rr(eth, REG_GDM_FWD_CFG(i)) != value)
+			return -EIO;
+	}
+	return 0;
+}
+
+static int airoha_ct_pair_gdm_stop(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	int i;
+
+	if (!ppe->ct_pair_gdm_owned)
+		return 0;
+	for (i = AIROHA_GDM1_IDX; i <= AIROHA_GDM4_IDX; i++) {
+		airoha_fe_wr(eth, REG_GDM_FWD_CFG(i), ppe->ct_pair_gdm_saved[i - 1]);
+		if (airoha_fe_rr(eth, REG_GDM_FWD_CFG(i)) != ppe->ct_pair_gdm_saved[i - 1])
+			return -EIO;
+	}
+	ppe->ct_pair_gdm_owned = false;
+	return 0;
+}
--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_ct_pair_policy.h
@@ -0,0 +1,176 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <net/netfilter/nf_native_pair.h>
+#include <net/netns/generic.h>
+#include <linux/netfilter.h>
+#include <linux/netfilter_bridge.h>
+#include <linux/netfilter_ipv4.h>
+
+static int airoha_ct_pair_policy_event(struct notifier_block *nb,
+				       unsigned long event, void *unused)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe, ct_pair_policy_notifier);
+	int err = 0;
+
+	spin_lock_bh(&ppe_lock);
+	ppe->ct_pair_policy_allowed = false;
+	if (event == NF_NATIVE_PAIR_PRE && airoha_ct_pair_any(ppe))
+		err = airoha_ct_native_pair_revoke(ppe, -1, 0);
+	spin_unlock_bh(&ppe_lock);
+	return notifier_from_errno(err);
+}
+
+/* Only the three tagged native bridge conntrack hooks can join nft hooks.
+ * Ingress/egress callers pass -1 and never accept a bridge conntrack tag.
+ */
+static bool airoha_ct_pair_bridge_ct_hook(const struct nf_hook_ops *op,
+					 int bridge_hook)
+{
+	if (bridge_hook < 0 || op->hook_ops_type != NF_HOOK_OP_BRIDGE_CT ||
+	    op->pf != NFPROTO_BRIDGE || op->hooknum != (unsigned int)bridge_hook ||
+	    op->dev || op->priv || !op->hook)
+		return false;
+	if (bridge_hook == NF_BR_PRE_ROUTING)
+		return op->priority == NF_IP_PRI_CONNTRACK;
+	if (bridge_hook == NF_BR_LOCAL_IN || bridge_hook == NF_BR_POST_ROUTING)
+		return op->priority == NF_IP_PRI_CONNTRACK_CONFIRM;
+	return false;
+}
+
+static bool airoha_ct_pair_nft_hooks(struct nf_hook_entries *entries,
+				   int bridge_hook)
+{
+	struct nf_hook_ops **ops;
+	unsigned int i;
+
+	if (!entries)
+		return true;
+	ops = nf_hook_entries_get_hook_ops(entries);
+	for (i = 0; i < entries->num_hook_entries; i++)
+		if (ops[i]->hook_ops_type != NF_HOOK_OP_NF_TABLES &&
+		    ops[i]->hook_ops_type != NF_HOOK_OP_NFT_FT &&
+		    !airoha_ct_pair_bridge_ct_hook(ops[i], bridge_hook))
+			return false;
+	return true;
+}
+
+static bool airoha_ct_pair_policy_hooks(void)
+{
+	struct net_device *dev;
+	bool ok = true;
+	unsigned int h;
+
+	if (IS_ENABLED(CONFIG_BRIDGE_NETFILTER) || IS_ENABLED(CONFIG_NETFILTER_XTABLES) ||
+	    IS_ENABLED(CONFIG_NET_CLS_ACT))
+		return false;
+	rcu_read_lock();
+	for (h = 0; h < ARRAY_SIZE(init_net.nf.hooks_bridge); h++)
+		if (!airoha_ct_pair_nft_hooks(rcu_dereference(init_net.nf.hooks_bridge[h]), h))
+			ok = false;
+	/* INET ingress and NETDEV ingress share each device's hook head. */
+	for_each_netdev_rcu(&init_net, dev) {
+#ifdef CONFIG_NETFILTER_INGRESS
+		if (!airoha_ct_pair_nft_hooks(rcu_dereference(dev->nf_hooks_ingress), -1))
+			ok = false;
+#endif
+#ifdef CONFIG_NETFILTER_EGRESS
+		if (!airoha_ct_pair_nft_hooks(rcu_dereference(dev->nf_hooks_egress), -1))
+			ok = false;
+#endif
+#ifdef CONFIG_NET_XGRESS
+		if (rcu_access_pointer(dev->tcx_ingress) || rcu_access_pointer(dev->tcx_egress))
+			ok = false;
+#endif
+		if (dev_xdp_prog_count(dev))
+			ok = false;
+	}
+	rcu_read_unlock();
+	return ok;
+}
+
+static ssize_t ct_native_pair_policy_show(struct device *dev,
+					 struct device_attribute *attr, char *buf)
+{
+	struct airoha_eth *eth = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "generation=%llu allowed=%u failed=%u\n",
+			  nf_native_pair_policy_generation(),
+			  READ_ONCE(eth->ppe->ct_pair_policy_allowed),
+			  READ_ONCE(eth->ppe->ct_pair_failed));
+}
+
+static ssize_t ct_native_pair_policy_store(struct device *dev,
+					  struct device_attribute *attr,
+					  const char *buf, size_t len)
+{
+	struct airoha_eth *eth = dev_get_drvdata(dev);
+	struct airoha_ppe *ppe = eth->ppe;
+	unsigned long long generation;
+	char trailing;
+	int err;
+
+	if (!ppe->ct_native_pairs)
+		return -EOPNOTSUPP;
+	if (sysfs_streq(buf, "off")) {
+		spin_lock_bh(&ppe_lock);
+		ppe->ct_pair_policy_allowed = false;
+		err = ppe->ct_pair_token ? airoha_ct_native_pair_revoke(ppe, -1, 0) : 0;
+		spin_unlock_bh(&ppe_lock);
+		return err ?: len;
+	}
+	/* The caller has audited that every unicast IPv4/IPv6 packet between
+	 * these authorized WLAN MAC peers is permitted, without per-flow,
+	 * set/map, time, quota or state-dependent filtering.
+	 * Existing TCX/XDP is rejected; RAM sessions block new installation.
+	 */
+	if (sscanf(buf, "whole-mac-ip %llu %c", &generation, &trailing) != 1)
+		return -EINVAL;
+	err = nf_native_pair_policy_lock(generation);
+	if (err)
+		return err;
+	if (!airoha_ct_pair_policy_hooks()) {
+		err = -EOPNOTSUPP;
+		goto unlock;
+	}
+	spin_lock_bh(&ppe_lock);
+	if (!ppe->ct_host_ppe || ppe->ct_stopping || ppe->ct_pair_failed)
+		err = -ESHUTDOWN;
+	else {
+		struct airoha_ct_pair_msg cap = { .op = cpu_to_le16(AIROHA_CT_PAIR_CAP) };
+
+		err = airoha_ct_pair_send(ppe, &cap);
+		if (!err)
+			ppe->ct_pair_policy_allowed = true;
+	}
+	spin_unlock_bh(&ppe_lock);
+unlock:
+	nf_native_pair_policy_unlock();
+	return err ?: len;
+}
+static DEVICE_ATTR_RW(ct_native_pair_policy);
+
+static int airoha_ct_pair_policy_init(struct airoha_ppe *ppe)
+{
+	int err;
+
+	if (!ppe->ct_native_pairs)
+		return 0;
+	ppe->ct_pair_policy_notifier.notifier_call = airoha_ct_pair_policy_event;
+	err = nf_native_pair_register(&ppe->ct_pair_policy_notifier);
+	if (err)
+		return err;
+	err = device_create_file(ppe->eth->dev, &dev_attr_ct_native_pair_policy);
+	if (err)
+		nf_native_pair_unregister(&ppe->ct_pair_policy_notifier);
+	else
+		ppe->ct_pair_policy_registered = true;
+	return err;
+}
+
+static void airoha_ct_pair_policy_deinit(struct airoha_ppe *ppe)
+{
+	if (!ppe->ct_pair_policy_registered)
+		return;
+	device_remove_file(ppe->eth->dev, &dev_attr_ct_native_pair_policy);
+	nf_native_pair_unregister(&ppe->ct_pair_policy_notifier);
+	ppe->ct_pair_policy_registered = false;
+}
