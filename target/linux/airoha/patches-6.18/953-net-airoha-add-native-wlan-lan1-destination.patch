+/* Link/device changes retire the wired epoch before it can admit new packets.
+ * FDB and bridge policy changes continue through the existing global barrier. */
+static int airoha_ct_pair_wired_event(struct notifier_block *nb,
+				    unsigned long event, void *ptr)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe, ct_pair_wired_notifier);
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+	bool revoke = true, resume = false, used = false;
+	int i, err = 0;
+
+	if (dev != airoha_ct_pair_lan1(ppe))
+		return NOTIFY_DONE;
+	switch (event) {
+	case NETDEV_GOING_DOWN:
+	case NETDEV_DOWN:
+	case NETDEV_UNREGISTER:
+	case NETDEV_PRE_CHANGEADDR:
+	case NETDEV_PRECHANGEMTU:
+	case NETDEV_PRECHANGEUPPER:
+		break;
+	case NETDEV_CHANGE:
+		resume = true;
+		break;
+	case NETDEV_UP:
+	case NETDEV_CHANGEADDR:
+	case NETDEV_CHANGEMTU:
+	case NETDEV_CHANGEUPPER:
+		revoke = false;
+		resume = true;
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+	spin_lock_bh(&ppe_lock);
+	if (!ppe->ct_native_pairs || ppe->ct_stopping)
+		goto out;
+	if (revoke) {
+		ppe->ct_pair_wired_blocked = true;
+		for (i = 0; i < AIROHA_CT_PAIR_SLOTS; i++)
+			if (ppe->ct_pairs[i].used &&
+			    ppe->ct_pairs[i].msg.dst_selector == AIROHA_CT_PAIR_LAN1_SELECTOR)
+				used = true;
+		if (ppe->ct_pair_wired_epoch == U32_MAX)
+			err = airoha_ct_pair_fail(ppe, -EOVERFLOW);
+		else if (used)
+			err = airoha_ct_native_pair_revoke(ppe, AIROHA_CT_PAIR_LAN1_SELECTOR,
+							 AIROHA_CT_PAIR_LAN1_ID);
+		if (!err)
+			ppe->ct_pair_wired_epoch++;
+	}
+	if (!err && resume && netif_running(dev) && netif_carrier_ok(dev))
+		ppe->ct_pair_wired_blocked = false;
+out:
+	spin_unlock_bh(&ppe_lock);
+	return notifier_from_errno(err);
+}
