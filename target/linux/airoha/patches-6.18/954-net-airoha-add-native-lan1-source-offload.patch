From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: admit native LAN1 source traffic through FE

Admit LAN1 source MAC pairs through the ABI3 FE owner lifetime and bind
native bank0 bridge rows after checking current FDB and station ownership.
Retire the FE producer and all native submitters, drain PPE1, then remove
owned rows before restoring the bank. Keep failed IFC rollback work alive
until the pending QUIESCE completes. Before a failure hard-stops the banks,
issue global native FLUSH and retain retries independently of FE ownership
flags until all native references drain. Pin the FE fence/watchdog firmware.

--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_ct_fe_native.h
@@ -0,0 +1,258 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* ABI3 LAN1 producer ownership. All entry points hold ppe_lock; notifier
+ * callers are atomic, so table completion never sleeps. */
+#define CT_FE_NATIVE_ROW 54
+
+static int airoha_ct_fe_table(struct airoha_ppe *ppe, unsigned int bank,
+			      unsigned int index, unsigned int page, bool write,
+			      u32 *words, unsigned int count)
+{
+	struct airoha_eth *eth = ppe->eth;
+	u32 command = (index << 16) | (page << 8) | (bank << 4) | (write ? 3 : 1);
+	u32 status;
+	unsigned int i;
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+	if (write)
+		for (i = 0; i < count; i++)
+			airoha_fe_wr(eth, CT_IFC_DATA(i), words[i]);
+	airoha_fe_wr(eth, CT_IFC_CONTROL, command);
+	err = read_poll_timeout_atomic(airoha_fe_rr, status, status & CT_IFC_DONE,
+				       2, 1000, false, eth, CT_IFC_CONTROL);
+	if (!err && !write)
+		for (i = 0; i < count; i++)
+			words[i] = airoha_fe_rr(eth, CT_IFC_DATA(i));
+	return err;
+}
+
+static int airoha_ct_fe_put(struct airoha_ppe *ppe, unsigned int bank,
+			    unsigned int index, unsigned int page,
+			    u32 *words, unsigned int count)
+{
+	u32 actual[3] = {};
+	int err;
+
+	err = airoha_ct_fe_table(ppe, bank, index, page, true, words, count);
+	if (!err)
+		err = airoha_ct_fe_table(ppe, bank, index, page, false, actual, count);
+	if (err)
+		return err;
+	if (bank == CT_IFC_TCAM_BANK)
+		return actual[1] == words[1] && !((actual[0] ^ words[0]) & words[1]) ? 0 : -EIO;
+	return memcmp(actual, words, count * sizeof(*words)) ? -EIO : 0;
+}
+
+static int airoha_ct_fe_snapshot(struct airoha_ppe *ppe)
+{
+	unsigned int r, page;
+	int err;
+
+	if (!ppe->ct_ifc.cfg_owned ||
+	    !(airoha_fe_rr(ppe->eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK) ||
+	    airoha_fe_rr(ppe->eth, REG_FE_IFC_PORT_EN) != XSI_ETH_VIP_PORT_MASK)
+		return -EINVAL;
+	if (ppe->ct_fe.touched)
+		return -EBUSY;
+	for (r = 0; r < 2; r++) {
+		for (page = 0; page < 3; page++) {
+			err = airoha_ct_fe_table(ppe, CT_IFC_ACTION_BANK, CT_FE_NATIVE_ROW + r,
+						 page, false, ppe->ct_fe.action[r][page],
+						 ct_ifc_action_words[page]);
+			if (err)
+				return err;
+		}
+		if (ppe->ct_fe.action[r][2][0] & CT_IFC_ACTION_ENABLE)
+			return -EBUSY;
+		for (page = 0; page < 9; page++) {
+			err = airoha_ct_fe_table(ppe, CT_IFC_TCAM_BANK, CT_FE_NATIVE_ROW + r,
+						 page, false, ppe->ct_fe.tcam[r][page], 2);
+			if (err)
+				return err;
+		}
+	}
+	ppe->ct_fe.saved = true;
+	return 0;
+}
+
+static int airoha_ct_fe_restore(struct airoha_ppe *ppe)
+{
+	u32 disabled = 0;
+	unsigned int r, page;
+	int err, first = 0;
+
+	if (!ppe->ct_fe.touched)
+		return 0;
+	if (!ppe->ct_fe.saved)
+		return -EUCLEAN;
+	/* Both producers must stop before either key or action dependency changes. */
+	for (r = 0; r < 2; r++) {
+		err = airoha_ct_fe_put(ppe, CT_IFC_ACTION_BANK, CT_FE_NATIVE_ROW + r,
+				       2, &disabled, 1);
+		if (err && !first)
+			first = err;
+	}
+	if (first)
+		return first;
+	ppe->ct_fe.active = false;
+	for (r = 0; r < 2; r++) {
+		for (page = 0; page < 9; page++) {
+			err = airoha_ct_fe_put(ppe, CT_IFC_TCAM_BANK, CT_FE_NATIVE_ROW + r,
+					       page, ppe->ct_fe.tcam[r][page], 2);
+			if (err && !first)
+				first = err;
+		}
+		for (page = 0; page < 3; page++) {
+			err = airoha_ct_fe_put(ppe, CT_IFC_ACTION_BANK, CT_FE_NATIVE_ROW + r,
+					       page, ppe->ct_fe.action[r][page],
+					       ct_ifc_action_words[page]);
+			if (err && !first)
+				first = err;
+		}
+	}
+	if (!first) {
+		ppe->ct_fe.touched = false;
+		ppe->ct_fe.saved = false;
+	}
+	return first;
+}
+
+static int airoha_ct_fe_control(struct airoha_ppe *ppe, u16 op, u64 generation,
+				u32 epoch)
+{
+	struct airoha_ct_pair_msg msg = {
+		.op = cpu_to_le16(op), .generation = cpu_to_le64(generation),
+		.src_epoch = cpu_to_le32(epoch),
+		.src_selector = AIROHA_CT_PAIR_LAN1_SELECTOR,
+		.src_wcid = cpu_to_le16(AIROHA_CT_PAIR_LAN1_ID),
+	};
+
+	return airoha_ct_pair_send(ppe, &msg);
+}
+
+static int airoha_ct_fe_quiesce(struct airoha_ppe *ppe, u64 generation)
+{
+	u32 epoch;
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+	err = airoha_ct_fe_restore(ppe);
+	if (!err)
+		err = airoha_ct_fe_snapshot(ppe);
+	if (err)
+		return err;
+	if (!generation || ppe->ct_fe.epoch == U32_MAX ||
+	    ppe->ct_pair_wired_epoch == U32_MAX)
+		return -EOVERFLOW;
+	/* Preserve the exact attempted epoch for an ambiguous mailbox timeout. */
+	if (!ppe->ct_fe.pending) {
+		epoch = max(ppe->ct_fe.epoch + 1, ppe->ct_pair_wired_epoch + 1);
+		ppe->ct_fe.pending_epoch = epoch;
+		ppe->ct_fe.pending_generation = generation;
+		ppe->ct_fe.pending = true;
+	}
+	ppe->ct_fe.armed = false;
+	err = airoha_ct_fe_control(ppe, AIROHA_CT_PAIR_FE_QUIESCE,
+				   ppe->ct_fe.pending_generation, ppe->ct_fe.pending_epoch);
+	if (err)
+		return err;
+	ppe->ct_fe.epoch = ppe->ct_fe.pending_epoch;
+	ppe->ct_fe.generation = ppe->ct_fe.pending_generation;
+	ppe->ct_pair_wired_epoch = ppe->ct_fe.epoch - 1;
+	ppe->ct_fe.pending = false;
+	ppe->ct_fe.arm_pending = false;
+	return 0;
+}
+
+static int airoha_ct_fe_arm(struct airoha_ppe *ppe, u64 generation)
+{
+	u32 tcam[9][2] = {}, action[][3] = {
+		{ 6 << 8, 0 }, { 0, BIT(28), 7 << 10 },
+		{ CT_IFC_ACTION_ENABLE | CT_IFC_ACTION_STOP },
+	};
+	unsigned int r, page;
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+	if (!ppe->ct_fe.epoch || ppe->ct_fe.pending || ppe->ct_fe.drain_pending ||
+	    ppe->ct_pair_failed || ppe->ct_stopping || ppe->ct_fe.generation != generation)
+		return -ESTALE;
+	if (ppe->ct_fe.armed && ppe->ct_fe.active)
+		return 0;
+	err = airoha_ct_fe_snapshot(ppe);
+	if (err)
+		return err;
+	ppe->ct_fe.arm_pending = true;
+	err = airoha_ct_fe_control(ppe, AIROHA_CT_PAIR_FE_ARM, generation, ppe->ct_fe.epoch);
+	if (err)
+		return err;
+	ppe->ct_fe.arm_pending = false;
+	ppe->ct_fe.armed = true;
+	ppe->ct_fe.touched = true;
+	for (r = 0; r < 2; r++) {
+		tcam[8][0] = r ? 0x41 : 0x42;
+		tcam[8][1] = 0xc3;
+		for (page = 0; page < 9; page++) {
+			err = airoha_ct_fe_put(ppe, CT_IFC_TCAM_BANK, CT_FE_NATIVE_ROW + r,
+					       page, tcam[page], 2);
+			if (err)
+				return err;
+		}
+		for (page = 0; page < 2; page++) {
+			err = airoha_ct_fe_put(ppe, CT_IFC_ACTION_BANK, CT_FE_NATIVE_ROW + r,
+					       page, action[page], ct_ifc_action_words[page]);
+			if (err)
+				return err;
+		}
+	}
+	for (r = 0; r < 2; r++) {
+		err = airoha_ct_fe_put(ppe, CT_IFC_ACTION_BANK, CT_FE_NATIVE_ROW + r,
+				       2, action[2], 1);
+		if (err)
+			return err;
+	}
+	ppe->ct_fe.active = true;
+	if (!ppe->ct_fe.health_stopping)
+		schedule_delayed_work(&ppe->ct_fe.health_work, msecs_to_jiffies(100));
+	return 0;
+}
+
+/* FE RXMBI completes the PSE assembly. PPE BUSY establishes the next queue
+ * boundary after FLUSH has stopped all native producers and TDMA references. */
+static int airoha_ct_fe_ppe_drain(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	u32 status, no_foe = FIELD_PREP(PPE_TB_CFG_SEARCH_MISS_MASK, 2);
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+	if (!ppe->ct_fe.drain_pending) {
+		ppe->ct_fe.drain_flow = airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(0));
+		ppe->ct_fe.drain_tb = airoha_fe_rr(eth, REG_PPE_TB_CFG(0));
+		ppe->ct_fe.drain_pending = true;
+	}
+	airoha_fe_rmw(eth, REG_PPE_TB_CFG(0), PPE_TB_CFG_SEARCH_MISS_MASK, no_foe);
+	airoha_fe_wr(eth, REG_PPE_PPE_FLOW_CFG(0), 0);
+	if (airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(0)) ||
+	    (airoha_fe_rr(eth, REG_PPE_TB_CFG(0)) & PPE_TB_CFG_SEARCH_MISS_MASK) != no_foe)
+		return -EIO;
+	err = read_poll_timeout_atomic(airoha_fe_rr, status, !(status & PPE_GLO_CFG_BUSY_MASK),
+				       10, 100000, false, eth, REG_PPE_GLO_CFG(0));
+	return err ?: (status & PPE_GLO_CFG_EN_MASK ? 0 : -EIO);
+}
+
+static int airoha_ct_fe_ppe_resume(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+
+	lockdep_assert_held(&ppe_lock);
+	if (!ppe->ct_fe.drain_pending)
+		return 0;
+	airoha_fe_wr(eth, REG_PPE_TB_CFG(0), ppe->ct_fe.drain_tb);
+	airoha_fe_wr(eth, REG_PPE_PPE_FLOW_CFG(0), ppe->ct_fe.drain_flow);
+	if (airoha_fe_rr(eth, REG_PPE_TB_CFG(0)) != ppe->ct_fe.drain_tb ||
+	    airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(0)) != ppe->ct_fe.drain_flow)
+		return -EIO;
+	ppe->ct_fe.drain_pending = false;
+	return 0;
+}
