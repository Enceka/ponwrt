+++ b/drivers/net/ethernet/airoha/airoha_ct_native_pair.h
@@ -51,14 +51,81 @@
 	return err;
 }
 
+static void airoha_ct_fe_health_work(struct work_struct *work);
+#include "airoha_ct_fe_native.h"
+
+/* FLUSH closes every admission before reporting outstanding references.
+ * A fault can keep those references busy indefinitely. Send one command now,
+ * then retry in the worker without waiting for a completion ACK to stop PPE.
+ * EAGAIN also covers a busy firmware lock, so it always retains the retry. */
+static void airoha_ct_pair_close_once(struct airoha_ppe *ppe)
+{
+	struct airoha_ct_pair_msg msg = { .op = cpu_to_le16(AIROHA_CT_PAIR_FLUSH) };
+	struct airoha_npu *npu;
+	int err = -EOPNOTSUPP;
+
+	lockdep_assert_held(&ppe_lock);
+	rcu_read_lock();
+	npu = rcu_dereference(ppe->eth->npu);
+	if (npu && npu->ops.ct_pair_cmd)
+		err = npu->ops.ct_pair_cmd(npu, &msg);
+	rcu_read_unlock();
+	ppe->ct_pair_close_pending = !!err;
+}
+
 static int airoha_ct_pair_fail(struct airoha_ppe *ppe, int err)
 {
 	int stop_err;
 
+	ppe->ct_pair_policy_allowed = false;
 	ppe->ct_pair_failed = true;
+	/* Close WLAN pairs too: FE QUIESCE retires only wired endpoints. */
+	airoha_ct_pair_close_once(ppe);
+	/* Close the FE producer before bank fail-closed stops the consumer. */
+	if (!airoha_ct_fe_restore(ppe) &&
+	    (ppe->ct_fe.armed || ppe->ct_fe.pending || ppe->ct_fe.arm_pending))
+		airoha_ct_fe_quiesce(ppe, max(ppe->ct_fe.generation,
+					     br_flow_offload_generation()));
 	stop_err = airoha_ppe_ct_bridge_fail_closed(ppe);
 	ppe->ct_pair_hw_stopped = !stop_err;
+	if ((ppe->ct_pair_close_pending || ppe->ct_fe.touched || ppe->ct_fe.armed || ppe->ct_fe.pending ||
+	     ppe->ct_fe.arm_pending) && !ppe->ct_fe.health_stopping)
+		schedule_delayed_work(&ppe->ct_fe.health_work, msecs_to_jiffies(100));
 	return stop_err ?: err;
+}
+
+
+static void airoha_ct_fe_health_work(struct work_struct *work)
+{
+	struct airoha_ppe *ppe = container_of(to_delayed_work(work), struct airoha_ppe,
+					     ct_fe.health_work);
+	bool again;
+	int err;
+
+	spin_lock_bh(&ppe_lock);
+	if (!ppe->ct_fe.health_stopping && ppe->ct_pair_failed && ppe->ct_pair_close_pending)
+		airoha_ct_pair_close_once(ppe);
+	if (!ppe->ct_fe.health_stopping && ppe->ct_pair_failed &&
+	    (ppe->ct_fe.touched || ppe->ct_fe.armed || ppe->ct_fe.pending || ppe->ct_fe.arm_pending)) {
+		if (!airoha_ct_fe_restore(ppe))
+			airoha_ct_fe_quiesce(ppe, max(ppe->ct_fe.generation,
+						     br_flow_offload_generation()));
+	}
+	if (ppe->ct_fe.health_stopping || !ppe->ct_fe.armed || !ppe->ct_fe.active ||
+	    ppe->ct_stopping || ppe->ct_pair_failed)
+		goto out;
+	/* Idempotent ARM performs the firmware fault/stop checks first. */
+	err = airoha_ct_fe_control(ppe, AIROHA_CT_PAIR_FE_ARM,
+				   ppe->ct_fe.generation, ppe->ct_fe.epoch);
+	if (err)
+		airoha_ct_pair_fail(ppe, err);
+out:
+	again = !ppe->ct_fe.health_stopping && (ppe->ct_pair_close_pending || ppe->ct_fe.touched ||
+		(ppe->ct_pair_failed && (ppe->ct_fe.armed || ppe->ct_fe.pending || ppe->ct_fe.arm_pending)) ||
+		(ppe->ct_fe.armed && ppe->ct_fe.active && !ppe->ct_pair_failed && !ppe->ct_stopping));
+	if (again)
+		schedule_delayed_work(&ppe->ct_fe.health_work, msecs_to_jiffies(100));
+	spin_unlock_bh(&ppe_lock);
 }
 
