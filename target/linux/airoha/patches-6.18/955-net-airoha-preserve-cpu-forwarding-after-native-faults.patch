From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: preserve CPU forwarding after native offload faults

Before stopping the native PPE banks, close admission, route their GDM
selectors to each port's current QDMA, and gate the owned IFC producer.
Keep fallback sticky across reopen, QDMA migration and route restoration,
and retain native retirement retries and frame ownership after a fault.
Record the first failed operation and expose read-only fallback state.

--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_ct_cpu_fallback.h
@@ -0,0 +1,150 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by airoha_eth.c. Lock order: ppe_lock -> ct_route_lock.
+ * No helper holding ct_route_lock takes a mutex or ppe_lock.
+ */
+static u16 airoha_ct_ppe_selectors(u32 cfg)
+{
+	u16 mask = 0;
+	unsigned int shift;
+
+	for (shift = 0; shift < 16; shift += 4)
+		if (((cfg >> shift) & 0xf) == FE_PSE_PORT_PPE1 ||
+		    ((cfg >> shift) & 0xf) == FE_PSE_PORT_PPE2)
+			mask |= 0xf << shift;
+	return mask;
+}
+
+static u32 airoha_ct_cpu_selectors(u32 cfg, u16 mask, u8 cpu)
+{
+	unsigned int shift;
+
+	for (shift = 0; shift < 16; shift += 4)
+		if (mask & (0xf << shift))
+			cfg = (cfg & ~(0xf << shift)) | (cpu << shift);
+	return cfg;
+}
+
+/* RX chooses its netdev from SPORT. Keep each active GDM on its actual QDMA.
+ * A shared GDM with conflicting active QDMA mappings cannot be represented by
+ * its single destination selector and is contained with DROP.
+ */
+static int airoha_ct_gdm_cpu_locked(struct airoha_eth *eth, unsigned int id)
+{
+	struct airoha_gdm_port *port = eth->ports[id - 1];
+	int pass, cpu = -ENODEV;
+	unsigned int i;
+
+	lockdep_assert_held(&eth->ct_route_lock);
+	if (!port)
+		return cpu;
+	rcu_read_lock();
+	for (pass = 0; pass < 2 && cpu == -ENODEV; pass++) {
+		for (i = 0; i < ARRAY_SIZE(port->devs); i++) {
+			struct airoha_gdm_dev *dev = port->devs[i];
+			struct airoha_qdma *qdma;
+			int next;
+
+			if (!dev || (!pass && !netif_running(netdev_from_priv(dev))))
+				continue;
+			qdma = rcu_dereference(dev->qdma);
+			if (qdma == &eth->qdma[0])
+				next = FE_PSE_PORT_CDM1;
+			else if (qdma == &eth->qdma[1])
+				next = FE_PSE_PORT_CDM2;
+			else
+				continue;
+			if (cpu >= 0 && cpu != next) {
+				cpu = -EXDEV;
+				goto out;
+			}
+			cpu = next;
+		}
+	}
+out:
+	rcu_read_unlock();
+	return cpu;
+}
+
+static int airoha_ct_gdm_route_locked(struct airoha_eth *eth, unsigned int id,
+				      u32 cfg)
+{
+	u16 mask = eth->ct_cpu_route_mask[id - 1];
+	int cpu = 0, err = 0;
+
+	lockdep_assert_held(&eth->ct_route_lock);
+	if (mask) {
+		cpu = airoha_ct_gdm_cpu_locked(eth, id);
+		if (cpu < 0) {
+			/* No configured device has no CPU receiver to preserve. */
+			err = cpu == -ENODEV ? 0 : cpu;
+			cpu = FE_PSE_PORT_DROP;
+		}
+		cfg = airoha_ct_cpu_selectors(cfg, mask, cpu);
+	}
+	airoha_fe_wr(eth, REG_GDM_FWD_CFG(id), cfg);
+	if (airoha_fe_rr(eth, REG_GDM_FWD_CFG(id)) != cfg)
+		err = -EIO;
+	if (err && eth->ct_cpu_fallback) {
+		WRITE_ONCE(eth->ct_cpu_routes_ready, false);
+		/* Reopen and QDMA migration can fail after the initial recovery
+		 * worker has stopped. Requeue it without taking ppe_lock here.
+		 */
+		if (eth->ppe->ct_native_pairs &&
+		    !READ_ONCE(eth->ppe->ct_fe.health_stopping))
+			schedule_delayed_work(&eth->ppe->ct_fe.health_work,
+					      msecs_to_jiffies(100));
+	}
+	return err;
+}
+
+int airoha_gdm_fwd_cfg_update(struct airoha_eth *eth, unsigned int id,
+			     u32 mask, u32 value)
+{
+	u32 cfg;
+	int err;
+
+	if (id < AIROHA_GDM1_IDX || id > AIROHA_GDM4_IDX)
+		return -EINVAL;
+	spin_lock_bh(&eth->ct_route_lock);
+	cfg = (airoha_fe_rr(eth, REG_GDM_FWD_CFG(id)) & ~mask) | (value & mask);
+	if (eth->ct_cpu_fallback) {
+		eth->ct_cpu_route_mask[id - 1] &= ~mask;
+		eth->ct_cpu_route_mask[id - 1] |= airoha_ct_ppe_selectors(cfg);
+	}
+	err = airoha_ct_gdm_route_locked(eth, id, cfg);
+	spin_unlock_bh(&eth->ct_route_lock);
+	return err;
+}
+
+/* Atomic fault cutover. Keep ownership/shadows and all inflight references.
+ * cfg_owned is retained so normal teardown can restore the original tables.
+ */
+int airoha_ct_cpu_fallback(struct airoha_eth *eth)
+{
+	unsigned int id;
+	int err = 0, ret;
+
+	spin_lock_bh(&eth->ct_route_lock);
+	WRITE_ONCE(eth->ct_cpu_fallback, true);
+	for (id = AIROHA_GDM1_IDX; id <= AIROHA_GDM4_IDX; id++) {
+		u32 cfg = airoha_fe_rr(eth, REG_GDM_FWD_CFG(id));
+
+		eth->ct_cpu_route_mask[id - 1] |= airoha_ct_ppe_selectors(cfg);
+		ret = airoha_ct_gdm_route_locked(eth, id, cfg);
+		if (ret && !err)
+			err = ret;
+	}
+	WRITE_ONCE(eth->ct_cpu_routes_ready, !err);
+	if (READ_ONCE(eth->ppe->ct_ifc.cfg_owned))
+		airoha_fe_clear(eth, REG_FE_CSR_IFC_CFG, FE_IFC_EN_MASK);
+	if (airoha_fe_rr(eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK) {
+		if (!err)
+			err = -EIO;
+	} else {
+		WRITE_ONCE(eth->ct_cpu_ifc_disabled, true);
+	}
+	spin_unlock_bh(&eth->ct_route_lock);
+	if (err)
+		dev_err_ratelimited(eth->dev, "CT CPU fallback incomplete: %d\n", err);
+	return err;
+}
