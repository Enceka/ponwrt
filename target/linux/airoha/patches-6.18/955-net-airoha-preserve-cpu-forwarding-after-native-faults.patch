+/* Capture the first failure before close/restore changes hardware state. */
+static void airoha_ct_pair_error_diag(struct airoha_ppe *ppe,
+				      const struct airoha_ct_pair_msg *msg,
+				      int err, const char *stage,
+				      const char *caller, unsigned int line,
+				      unsigned int retries)
+{
+	u32 glo0, glo1, flow0, flow1;
+
+	lockdep_assert_held(&ppe_lock);
+	glo0 = airoha_fe_rr(ppe->eth, REG_PPE_GLO_CFG(0));
+	glo1 = airoha_fe_rr(ppe->eth, REG_PPE_GLO_CFG(1));
+	flow0 = airoha_fe_rr(ppe->eth, REG_PPE_PPE_FLOW_CFG(0));
+	flow1 = airoha_fe_rr(ppe->eth, REG_PPE_PPE_FLOW_CFG(1));
+	pr_err("ct-first-error %s caller=%s:%u err=%d op=%d token=%u slot=%u gen=%llu src_epoch=%u dst_epoch=%u eagain=%u\n",
+	       stage, caller, line, err, msg ? le16_to_cpu(msg->op) : -1,
+	       msg ? le32_to_cpu(msg->token) : 0, msg ? le32_to_cpu(msg->slot) : 0,
+	       msg ? (unsigned long long)le64_to_cpu(msg->generation) : 0ULL,
+	       msg ? le32_to_cpu(msg->src_epoch) : 0,
+	       msg ? le32_to_cpu(msg->dst_epoch) : 0, retries);
+	pr_err("ct-first-error %s fe_gen=%llu epoch=%u pending_gen=%llu pending_epoch=%u armed=%u active=%u touched=%u saved=%u pending=%u arm_pending=%u drain_pending=%u health_stop=%u allowed=%u failed=%u stopping=%u hw_stopped=%u glo=%08x/%08x flow=%08x/%08x\n",
+	       stage, (unsigned long long)ppe->ct_fe.generation, ppe->ct_fe.epoch,
+	       (unsigned long long)ppe->ct_fe.pending_generation, ppe->ct_fe.pending_epoch,
+	       ppe->ct_fe.armed, ppe->ct_fe.active, ppe->ct_fe.touched, ppe->ct_fe.saved,
+	       ppe->ct_fe.pending, ppe->ct_fe.arm_pending, ppe->ct_fe.drain_pending,
+	       ppe->ct_fe.health_stopping, ppe->ct_pair_policy_allowed, ppe->ct_pair_failed,
+	       ppe->ct_stopping, ppe->ct_pair_hw_stopped, glo0, glo1, flow0, flow1);
+}
+
+static int airoha_ct_pair_exchange_counted(struct airoha_npu *npu,
+					 struct airoha_ct_pair_msg *msg,
+					 unsigned int *retries)
 {
 	ktime_t deadline = ktime_add_us(ktime_get(), CT_PAIR_RETRY_US);
 	int err;
 
+	*retries = 0;
 	if (!npu || !npu->ops.ct_pair_cmd)
 		return -EOPNOTSUPP;
 	do {
 		err = npu->ops.ct_pair_cmd(npu, msg);
 		if (err != -EAGAIN)
 			break;
+		(*retries)++;
 		/* Firmware must return to its done FIFO between revoke probes. */
 		udelay(10);
 	} while (ktime_before(ktime_get(), deadline));
 	return err == -EAGAIN ? -ETIMEDOUT : err;
 }
 
