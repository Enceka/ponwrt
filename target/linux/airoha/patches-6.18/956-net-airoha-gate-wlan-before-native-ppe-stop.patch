 	     !READ_ONCE(ppe->eth->ct_cpu_routes_ready)))
 		airoha_ct_cpu_fallback(ppe->eth);
-	if (!ppe->ct_fe.health_stopping && ppe->ct_pair_failed && ppe->ct_pair_close_pending)
+	if (!ppe->ct_fe.health_stopping && ppe->ct_pair_failed && !ppe->ct_pair_hw_stopped)
+		airoha_ppe_ct_bridge_fail_closed(ppe);
+	else if (!ppe->ct_fe.health_stopping && ppe->ct_pair_failed && ppe->ct_pair_close_pending)
 		airoha_ct_pair_close_once(ppe);
 	if (!ppe->ct_fe.health_stopping && ppe->ct_pair_failed &&
 	    (ppe->ct_fe.armed || ppe->ct_fe.pending || ppe->ct_fe.arm_pending))
@@ -177,7 +207,8 @@
 		airoha_ct_pair_fail(ppe, err);
 out:
 	again = !ppe->ct_fe.health_stopping && (ppe->ct_pair_close_pending ||
-		(ppe->ct_pair_failed && (!READ_ONCE(ppe->eth->ct_cpu_ifc_disabled) ||
+		(ppe->ct_pair_failed && (!ppe->ct_pair_hw_stopped ||
+		 !READ_ONCE(ppe->eth->ct_cpu_ifc_disabled) ||
 		 !READ_ONCE(ppe->eth->ct_cpu_routes_ready))) ||
 		(!READ_ONCE(ppe->eth->ct_cpu_fallback) && ppe->ct_fe.touched) ||
 		(ppe->ct_pair_failed && (ppe->ct_fe.armed || ppe->ct_fe.pending || ppe->ct_fe.arm_pending)) ||
