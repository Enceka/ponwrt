From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: gate WLAN before native PPE stop

Require the sticky firmware WLAN gate ACK before stopping native PPE banks,
retain NPU owners on failed teardown, and close fixed-DT provider unbind.
Publish native state after all netdevs register and pin the matching firmware.

--- a/drivers/net/ethernet/airoha/airoha_ct_native_pair.h
+++ b/drivers/net/ethernet/airoha/airoha_ct_native_pair.h
@@ -103,6 +103,29 @@
 static void airoha_ct_fe_health_work(struct work_struct *work);
 #include "airoha_ct_fe_native.h"
 
+/* The fault gate ACK covers descriptor publication, not frame retirement. */
+static int airoha_ct_pair_wlan_gate(struct airoha_ppe *ppe)
+{
+	struct airoha_ct_pair_msg msg = {
+		.op = cpu_to_le16(AIROHA_CT_PAIR_FLUSH),
+		.flags = cpu_to_le32(AIROHA_CT_PAIR_F_CPU_FALLBACK),
+	};
+	struct airoha_npu *npu;
+	int err = -EOPNOTSUPP;
+
+	lockdep_assert_held(&ppe_lock);
+	if (READ_ONCE(ppe->eth->ct_cpu_wlan_gated))
+		return 0;
+	rcu_read_lock();
+	npu = rcu_dereference(ppe->eth->npu);
+	if (npu && npu->ops.ct_pair_cmd)
+		err = npu->ops.ct_pair_cmd(npu, &msg);
+	rcu_read_unlock();
+	if (!err)
+		WRITE_ONCE(ppe->eth->ct_cpu_wlan_gated, true);
+	return err;
+}
+
 /* FLUSH closes every admission before reporting outstanding references.
  * A fault can keep those references busy indefinitely. Send one command now,
  * then retry in the worker without waiting for a completion ACK to stop PPE.
@@ -122,14 +145,19 @@
 	ppe->ct_pair_close_pending = !!err;
 }
 
-static void airoha_ct_pair_fault_close(struct airoha_ppe *ppe)
-{
-	lockdep_assert_held(&ppe_lock);
-	airoha_ct_pair_close_once(ppe);
+static int airoha_ct_pair_fault_close(struct airoha_ppe *ppe)
+{
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+	err = airoha_ct_pair_wlan_gate(ppe);
+	if (!err)
+		airoha_ct_pair_close_once(ppe);
 	if (READ_ONCE(ppe->eth->ct_cpu_ifc_disabled))
 		ppe->ct_fe.active = false;
 	if (!ppe->ct_fe.health_stopping)
 		schedule_delayed_work(&ppe->ct_fe.health_work, msecs_to_jiffies(100));
+	return err;
 }
 
