From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: retain PON mappings on CT flow retirement errors

Retire CT PON hardware rows before publishing replacement GEM/T-CONT or
LLID mappings. Preserve failed cookies for retry and compare the live row
before invalidation. Deduplicate rhashtable walks across resize restarts.

--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -883,7 +883,7 @@
 }
 
 static bool airoha_ppe_foe_compare_entry(struct airoha_flow_table_entry *e,
-					 struct airoha_foe_entry *hwe)
+					 const struct airoha_foe_entry *hwe)
 {
 	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
 	int len;
@@ -1006,41 +1006,111 @@
 	spin_unlock_bh(&ppe_lock);
 }
 
-void airoha_ppe_remove_egress_flows(struct airoha_gdm_dev *dev)
+/* Match the action as well as the tuple before withdrawing a CT PON row.
+ * A hardware hash can be reused while an old software cookie still exists.
+ * Timestamp and FIN transitions belong to hardware; bearer metadata does not.
+ */
+static bool airoha_ppe_ct_pon_row_matches(struct airoha_flow_table_entry *e,
+					const struct airoha_foe_entry *hwe)
+{
+	u32 type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
+	u32 mask = AIROHA_FOE_IB1_BIND_STATIC | AIROHA_FOE_IB1_BIND_TTL |
+		   AIROHA_FOE_IB1_BIND_TUNNEL_DECAP | AIROHA_FOE_IB1_BIND_PPPOE |
+		   AIROHA_FOE_IB1_BIND_VPM | AIROHA_FOE_IB1_BIND_VLAN_LAYER;
+
+	if (((e->data.ib1 ^ hwe->ib1) & mask) ||
+	    !airoha_ppe_foe_compare_entry(e, hwe))
+		return false;
+	if (type == PPE_PKT_TYPE_IPV4_HNAPT)
+		return e->data.ipv4.ib2 == hwe->ipv4.ib2 &&
+		       e->data.ipv4.data == hwe->ipv4.data &&
+		       !memcmp(&e->data.ipv4.new_tuple, &hwe->ipv4.new_tuple,
+			       sizeof(hwe->ipv4.new_tuple)) &&
+		       !memcmp(&e->data.ipv4.l2, &hwe->ipv4.l2,
+			       sizeof(hwe->ipv4.l2));
+	if (type == PPE_PKT_TYPE_IPV6_ROUTE_5T)
+		return e->data.ipv6.ib2 == hwe->ipv6.ib2 &&
+		       e->data.ipv6.data == hwe->ipv6.data &&
+		       !memcmp(&e->data.ipv6.l2, &hwe->ipv6.l2,
+			       sizeof(hwe->ipv6.l2));
+	return false;
+}
+
+static int airoha_ppe_ct_remove_pon_flow(struct airoha_ppe *ppe,
+				      struct airoha_flow_table_entry *e)
+{
+	struct airoha_foe_entry *hwe, invalid;
+	u32 type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
+	int err = 0;
+
+	if (e->type == FLOW_TYPE_L2 || e->type == FLOW_TYPE_L2_SUBFLOW ||
+	    (type != PPE_PKT_TYPE_IPV4_HNAPT && type != PPE_PKT_TYPE_IPV6_ROUTE_5T))
+		return -EOPNOTSUPP;
+	spin_lock_bh(&ppe_lock);
+	/* A failed withdrawal keeps its cookie/hash but cannot learn again. */
+	hlist_del_init(&e->list);
+	if (e->hash == 0xffff)
+		goto unlock;
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, e->hash);
+	if (!hwe) {
+		err = -ETIMEDOUT;
+	} else if ((FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) == AIROHA_FOE_STATE_BIND ||
+		    FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) == AIROHA_FOE_STATE_FIN) &&
+		   airoha_ppe_ct_pon_row_matches(e, hwe)) {
+		invalid = *hwe;
+		invalid.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+		err = airoha_ppe_foe_commit_entry(ppe, &invalid, e->hash, false);
+	}
+	if (!err)
+		e->hash = 0xffff;
+unlock:
+	spin_unlock_bh(&ppe_lock);
+	return err;
+}
+
+int airoha_ppe_remove_egress_flows(struct airoha_gdm_dev *dev)
 {
 	struct airoha_eth *eth = dev->eth;
 	struct airoha_flow_table_entry *e, *tmp;
 	struct rhashtable_iter iter;
 	LIST_HEAD(remove_list);
+	int err = 0;
 
 	lockdep_assert_held(&flow_offload_mutex);
 
-	/* TC replace and destroy callbacks share flow_offload_mutex with this walk.
-	 * Collect matching objects before removal so rhashtable iteration continues
-	 * through every entry in the current bucket.
-	 */
+	/* A resize can rewind the walk and return an object more than once. */
 	rhashtable_walk_enter(&eth->flow_table, &iter);
 	rhashtable_walk_start(&iter);
 	while ((e = rhashtable_walk_next(&iter))) {
-		if (IS_ERR(e))
-			continue;
-		if (e->egress_dev == dev)
+		if (IS_ERR(e)) {
+			if (PTR_ERR(e) == -EAGAIN)
+				continue;
+			err = PTR_ERR(e);
+			break;
+		}
+		if (e->egress_dev == dev && list_empty(&e->gc_node))
 			list_add_tail(&e->gc_node, &remove_list);
 	}
 	rhashtable_walk_stop(&iter);
 	rhashtable_walk_exit(&iter);
 
-	/* Bearer changes invalidate GEM/T-CONT/LLID metadata in existing FOEs.
-	 * Remove the software index at the same time; netfilter keeps forwarding
-	 * and later connections can offload with the new mapping.
-	 */
 	list_for_each_entry_safe(e, tmp, &remove_list, gc_node) {
 		list_del_init(&e->gc_node);
-		airoha_ppe_foe_flow_remove_entry(eth->ppe, e);
+		/* Unlink every temporary node, including after a failed withdrawal. */
+		if (err)
+			continue;
+		if (eth->ppe->ct_host_ppe) {
+			err = airoha_ppe_ct_remove_pon_flow(eth->ppe, e);
+			if (err)
+				continue;
+		} else {
+			airoha_ppe_foe_flow_remove_entry(eth->ppe, e);
+		}
 		rhashtable_remove_fast(&eth->flow_table, &e->node,
 				       airoha_flow_table_params);
 		kfree(e);
 	}
+	return err;
 }
 
 static bool airoha_ppe_ct_wlan_dest(const struct airoha_foe_entry *hwe,
