+++ b/drivers/net/ethernet/airoha/airoha_pon_retire.h
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _AIROHA_PON_RETIRE_H_
+#define _AIROHA_PON_RETIRE_H_
+
+/* Include after airoha_eth.h. All calls require the same sleepable GDM2
+ * configuration mutex, including queue-scheduler and channel-enable writers.
+ * The caller must stop ALL PON admission and synchronize software TX, then
+ * revoke all PON FOEs before retire. The stock sequence temporarily enables
+ * only one GDM2 TX/RX channel; it therefore needs exclusive use of GDM2.
+ * The controller must retain this state and its service ownership on error.
+ */
+#define AIROHA_PON_RETIRE_CHANNELS	32
+#define AIROHA_PON_RETIRE_START		BIT(0)
+#define AIROHA_PON_RETIRE_DONE		BIT(1)
+#define AIROHA_PON_RETIRE_CHANNEL_MASK	GENMASK(8, 4)
+#define AIROHA_PON_RETIRE_CMD_MASK	(AIROHA_PON_RETIRE_CHANNEL_MASK | \
+					 AIROHA_PON_RETIRE_DONE | \
+					 AIROHA_PON_RETIRE_START)
+#define AIROHA_PON_RETIRE_BUSY_REG	0x1570
+#define AIROHA_PON_RETIRE_QUEUE_REG(ch)	(0x1280 + ((ch) & ~3U))
+
+struct airoha_pon_retirement {
+	u32 owned;
+	u32 drained;
+	u8 saved_close[AIROHA_PON_RETIRE_CHANNELS];
+	/* A failed register restore keeps the original snapshot across retries. */
+	u32 saved_tx;
+	u32 saved_rx;
+	unsigned int active_channel;
+	bool restore_pending;
+	bool command_owned;
+};
+
+static inline u32 airoha_pon_retire_queue_mask(unsigned int channel)
+{
+	return 0xffU << ((channel & 3) * 8);
+}
+
+/* Acquire before any write: even a failed close retains retry ownership. */
+static int airoha_pon_channel_close(struct airoha_eth *eth,
+				  struct airoha_pon_retirement *state,
+				  unsigned int channel)
+{
+	struct airoha_qdma *qdma = &eth->qdma[1];
+	u32 mask, value, bit;
+
+	if (channel >= AIROHA_PON_RETIRE_CHANNELS)
+		return -EINVAL;
+	mask = airoha_pon_retire_queue_mask(channel);
+	bit = BIT(channel);
+	value = airoha_qdma_rr(qdma, REG_QUEUE_CLOSE_CFG(channel));
+	if (!(state->owned & bit)) {
+		state->saved_close[channel] = value >> ((channel & 3) * 8);
+		state->owned |= bit;
+		state->drained &= ~bit;
+	}
+	airoha_qdma_rmw(qdma, REG_QUEUE_CLOSE_CFG(channel), mask, mask);
+	if ((airoha_qdma_rr(qdma, REG_QUEUE_CLOSE_CFG(channel)) & mask) != mask) {
+		state->drained &= ~bit;
+		return -EIO;
+	}
+	return 0;
+}
+
+/* The extra channel comparison rejects a completion from another command. */
+static bool airoha_pon_channel_retire_done(struct airoha_eth *eth,
+					 unsigned int channel)
+{
+	u32 command = airoha_fe_rr(eth, REG_GDM_CHN_RLS(2));
+
+	if (!(command & AIROHA_PON_RETIRE_DONE) ||
+	    (command & AIROHA_PON_RETIRE_CHANNEL_MASK) != (channel << 4))
+		return false;
+	if (airoha_fe_rr(eth, AIROHA_PON_RETIRE_BUSY_REG) & BIT(channel))
+		return false;
+	return !(airoha_qdma_rr(&eth->qdma[1],
+			       AIROHA_PON_RETIRE_QUEUE_REG(channel)) &
+		 airoha_pon_retire_queue_mask(channel));
+}
+
+static int airoha_pon_retire_restore(struct airoha_eth *eth,
+				    struct airoha_pon_retirement *state)
+{
+	int ret = 0;
+
+	if (state->command_owned) {
+		airoha_fe_rmw(eth, REG_GDM_CHN_RLS(2),
+			      AIROHA_PON_RETIRE_CMD_MASK, 0);
+		if (airoha_fe_rr(eth, REG_GDM_CHN_RLS(2)) &
+		    AIROHA_PON_RETIRE_CMD_MASK)
+			ret = -EIO;
+		else
+			state->command_owned = false;
+	}
+	airoha_fe_wr(eth, REG_GDM_TXCHN_EN(2), state->saved_tx);
+	airoha_fe_wr(eth, REG_GDM_RXCHN_EN(2), state->saved_rx);
+	if (airoha_fe_rr(eth, REG_GDM_TXCHN_EN(2)) != state->saved_tx ||
+	    airoha_fe_rr(eth, REG_GDM_RXCHN_EN(2)) != state->saved_rx)
+		ret = -EIO;
+	if (!ret)
+		state->restore_pending = false;
+	return ret;
+}
+
+static int airoha_pon_channel_retire(struct airoha_eth *eth,
+				   struct airoha_pon_retirement *state,
+				   unsigned int channel)
+{
+	u32 command, bit;
+	int remaining, ret;
+
+	if (channel >= AIROHA_PON_RETIRE_CHANNELS)
+		return -EINVAL;
+	if (state->restore_pending && state->active_channel != channel)
+		return -EBUSY;
+	ret = airoha_pon_channel_close(eth, state, channel);
+	if (ret)
+		return ret;
+	bit = BIT(channel);
+	state->drained &= ~bit;
+	if (state->restore_pending) {
+		ret = airoha_pon_retire_restore(eth, state);
+		if (ret)
+			return ret;
+	}
+	command = airoha_fe_rr(eth, REG_GDM_CHN_RLS(2));
+	if (command & AIROHA_PON_RETIRE_CMD_MASK)
+		return -EBUSY;
+	state->saved_tx = airoha_fe_rr(eth, REG_GDM_TXCHN_EN(2));
+	state->saved_rx = airoha_fe_rr(eth, REG_GDM_RXCHN_EN(2));
+	state->active_channel = channel;
+	state->restore_pending = true;
+	/* Match stock fe_core .text+0x72d0, RX first and then TX. */
+	airoha_fe_wr(eth, REG_GDM_RXCHN_EN(2), bit);
+	airoha_fe_wr(eth, REG_GDM_TXCHN_EN(2), bit);
+	ret = -EIO;
+	if (airoha_fe_rr(eth, REG_GDM_RXCHN_EN(2)) != bit ||
+	    airoha_fe_rr(eth, REG_GDM_TXCHN_EN(2)) != bit)
+		goto restore;
+	/* CHN_RLS also holds the live MBI aging selectors. */
+	airoha_fe_rmw(eth, REG_GDM_CHN_RLS(2), AIROHA_PON_RETIRE_CMD_MASK,
+		      (channel << 4) | AIROHA_PON_RETIRE_START);
+	state->command_owned = true;
+	command = airoha_fe_rr(eth, REG_GDM_CHN_RLS(2));
+	if ((command & (AIROHA_PON_RETIRE_CHANNEL_MASK |
+			AIROHA_PON_RETIRE_START)) !=
+	    ((channel << 4) | AIROHA_PON_RETIRE_START))
+		goto restore;
+	ret = -ETIMEDOUT;
+	/* Stock decrements its ten-round budget after each 1 ms delay and
+	 * exits before sampling on the last round. Require two consecutive
+	 * complete observations, restarting the pair after any failed sample.
+	 */
+	for (remaining = 10; remaining; remaining--) {
+		usleep_range(1000, 1100);
+		if (remaining == 1)
+			break;
+		if (airoha_pon_channel_retire_done(eth, channel) &&
+		    airoha_pon_channel_retire_done(eth, channel)) {
+			ret = 0;
+			break;
+		}
+	}
+
+restore:
+	if (airoha_pon_retire_restore(eth, state))
+		ret = -EIO;
+	if (!ret)
+		state->drained |= bit;
+	return ret;
+}
+
+/* Only call after controller updates and mapping publication both succeed.
+ * Restores the original queue byte; it does not implicitly open queues that
+ * the scheduler had already disabled before the transaction.
+ */
+static int airoha_pon_channel_reopen(struct airoha_eth *eth,
+				   struct airoha_pon_retirement *state,
+				   unsigned int channel)
+{
+	struct airoha_qdma *qdma = &eth->qdma[1];
+	u32 bit, mask, value;
+
+	if (channel >= AIROHA_PON_RETIRE_CHANNELS)
+		return -EINVAL;
+	bit = BIT(channel);
+	if (!(state->owned & bit))
+		return 0;
+	if (!(state->drained & bit))
+		return -EBUSY;
+	if (state->restore_pending)
+		return -EBUSY;
+	if (airoha_fe_rr(eth, REG_GDM_CHN_RLS(2)) & AIROHA_PON_RETIRE_CMD_MASK)
+		return -EBUSY;
+	mask = airoha_pon_retire_queue_mask(channel);
+	value = (u32)state->saved_close[channel] << ((channel & 3) * 8);
+	airoha_qdma_rmw(qdma, REG_QUEUE_CLOSE_CFG(channel), mask, value);
+	if ((airoha_qdma_rr(qdma, REG_QUEUE_CLOSE_CFG(channel)) & mask) != value) {
+		airoha_qdma_rmw(qdma, REG_QUEUE_CLOSE_CFG(channel), mask, mask);
+		return -EIO;
+	}
+	state->owned &= ~bit;
+	state->drained &= ~bit;
+	return 0;
+}
+
+#endif
