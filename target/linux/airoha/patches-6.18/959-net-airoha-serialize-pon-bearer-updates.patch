@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _AIROHA_PON_TRANSACTION_H_
+#define _AIROHA_PON_TRANSACTION_H_
+
+/* Included after the netdev operations and the PON transmit entry point. */
+static struct airoha_gdm_dev *airoha_pon_update_dev(struct net_device *netdev)
+{
+	struct airoha_gdm_dev *dev;
+
+	if (!netdev || netdev->netdev_ops != &airoha_netdev_ops)
+		return ERR_PTR(-EINVAL);
+	dev = netdev_priv(netdev);
+	if (!test_bit(AIROHA_DEV_F_PON, &dev->flags) || !dev->pon_retirement)
+		return ERR_PTR(-EOPNOTSUPP);
+	return dev;
+}
+
+static u32 airoha_pon_table_channels(const struct airoha_pon_flow_table *table,
+				   u32 tag)
+{
+	u32 mask = 0;
+	unsigned int i;
+
+	if (tag & AIROHA_PON_QDMA_VALID)
+		mask |= BIT(FIELD_GET(AIROHA_PON_QDMA_TCONT_MASK, tag));
+	if (table)
+		for (i = 0; i < table->count; i++)
+			mask |= BIT(FIELD_GET(AIROHA_PON_QDMA_TCONT_MASK,
