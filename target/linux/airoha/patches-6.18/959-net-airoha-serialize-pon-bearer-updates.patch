+int airoha_eth_pon_update_begin(struct net_device *netdev, u32 channel_mask)
+{
+	struct airoha_gdm_dev *dev = airoha_pon_update_dev(netdev);
+	struct airoha_pon_retirement *state;
+	struct airoha_eth *eth;
+	unsigned int channel;
+	int pending, err;
+
+	if (IS_ERR(dev))
+		return PTR_ERR(dev);
+	eth = dev->eth;
+	state = dev->pon_retirement;
+	mutex_lock(&flow_offload_mutex);
+	mutex_lock(&eth->pon_config_lock);
+	if (eth->pon_update_owner && eth->pon_update_owner != dev) {
+		err = -EBUSY;
+		goto unlock;
+	}
+	eth->pon_update_owner = dev;
+	dev->pon_update_ready = false;
+	WRITE_ONCE(dev->pon_update_blocked, true);
+	dev->pon_update_channels |= channel_mask | airoha_pon_mapping_channels(dev);
+	/* The same RCU section covers both data and control descriptor submission.
+	 * The gate prevents all new submissions, including wake races from NAPI.
+	 */
+	netif_tx_disable(netdev);
+	synchronize_net();
+	err = read_poll_timeout(atomic_read, pending, !pending,
+				1000, 100000, false, &dev->pon_tx_pending);
+	if (err)
+		goto unlock;
+	err = airoha_ppe_remove_egress_flows(dev);
+	if (err)
+		goto unlock;
+
+	/* Repair a failed whole-register restore before touching another channel. */
+	if (state->restore_pending) {
+		err = airoha_pon_channel_retire(eth, state, state->active_channel);
+		if (err)
+			goto unlock;
+	}
+	for (channel = 0; channel < AIROHA_PON_RETIRE_CHANNELS; channel++) {
+		if (!(dev->pon_update_channels & BIT(channel)))
+			continue;
+		err = airoha_pon_channel_close(eth, state, channel);
+		if (err)
+			goto unlock;
+	}
+	for (channel = 0; channel < AIROHA_PON_RETIRE_CHANNELS; channel++) {
+		if (!(dev->pon_update_channels & BIT(channel)))
+			continue;
+		err = airoha_pon_channel_retire(eth, state, channel);
+		if (err)
+			goto unlock;
+	}
+	dev->pon_update_ready = true;
+	err = 0;
+unlock:
+	mutex_unlock(&eth->pon_config_lock);
+	mutex_unlock(&flow_offload_mutex);
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_update_begin);
+
+int airoha_eth_pon_update_end(struct net_device *netdev)
+{
+	struct airoha_gdm_dev *dev = airoha_pon_update_dev(netdev);
+	struct airoha_pon_retirement *state;
+	struct airoha_eth *eth;
+	unsigned int channel;
+	int err;
+
+	if (IS_ERR(dev))
+		return PTR_ERR(dev);
+	eth = dev->eth;
+	state = dev->pon_retirement;
+	mutex_lock(&flow_offload_mutex);
+	mutex_lock(&eth->pon_config_lock);
+	err = -EBUSY;
+	if (eth->pon_update_owner != dev || !dev->pon_update_ready)
+		goto unlock;
+	for (channel = 0; channel < AIROHA_PON_RETIRE_CHANNELS; channel++) {
+		if (!(dev->pon_update_channels & BIT(channel)))
+			continue;
+		err = airoha_pon_channel_reopen(eth, state, channel);
+		if (err)
+			goto reclose;
+	}
+	dev->pon_update_channels = 0;
+	dev->pon_update_ready = false;
+	eth->pon_update_owner = NULL;
+	/* Mapping writes precede release of the gate. TX readers use RCU. */
+	smp_store_release(&dev->pon_update_blocked, false);
+	if (netif_running(netdev) && netif_carrier_ok(netdev))
+		netif_tx_wake_all_queues(netdev);
+	err = 0;
+	goto unlock;
+reclose:
+	/* No CPU or offloaded TX was admitted during this partial reopen.
+	 * Preserve the first failure and retry the entire transaction via begin.
+	 */
+	dev->pon_update_ready = false;
+	for (channel = 0; channel < AIROHA_PON_RETIRE_CHANNELS; channel++)
+		if (dev->pon_update_channels & BIT(channel))
+			airoha_pon_channel_close(eth, state, channel);
+unlock:
+	mutex_unlock(&eth->pon_config_lock);
+	mutex_unlock(&flow_offload_mutex);
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_update_end);
