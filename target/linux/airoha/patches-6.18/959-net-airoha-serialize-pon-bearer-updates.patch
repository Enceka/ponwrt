+		if (*dsa_port >= AIROHA_MAX_DSA_PORTS ||
+		    (*dsa_port < 0 && netdev_uses_dsa(lower)))
+			goto out;
+		*ingress = dev;
+		err = 0;
+	} else if (idev->ieee80211_ptr) {
+		err = 0;
+	}
+out:
+	dev_put(idev);
+	return err;
+}
