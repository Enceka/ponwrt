+	if (!pon)
+		return 0;
+	if (meta.mask->ingress_ifindex != U32_MAX ||
+	    meta.mask->ingress_iftype || meta.mask->l2_miss ||
+	    meta.key->ingress_ifindex <= 0)
+		return -EOPNOTSUPP;
+	*ifindex = meta.key->ingress_ifindex;
+	idev = dev_get_by_index(dev_net(odev), *ifindex);
+	if (!idev)
