+static int airoha_ppe_ct_ingress_dev(struct airoha_eth *eth,
+				   struct flow_rule *rule,
+				   struct net_device *odev,
+				   struct airoha_gdm_dev *egress,
+				   struct airoha_gdm_dev **ingress,
+				   int *ifindex, int *dsa_port)
+{
+	struct flow_match_meta meta;
+	struct net_device *idev, *lower;
+	struct airoha_gdm_dev *dev;
+	bool pon = egress && test_bit(AIROHA_DEV_F_PON, &egress->flags);
+	int err = -EOPNOTSUPP, i, j;
+
+	*ingress = NULL;
+	*ifindex = 0;
+	*dsa_port = -1;
+	flow_rule_match_meta(rule, &meta);
+	/* Preserve existing non-PON admission. A masked META that could include
+	 * PON must satisfy the same exact source contract as a PON egress.
+	 */
+	for (i = 0; !pon && i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
+			dev = port->devs[j];
+			if (!dev || !test_bit(AIROHA_DEV_F_PON, &dev->flags))
+				continue;
+			idev = netdev_from_priv(dev);
+			if (net_eq(dev_net(idev), dev_net(odev)) &&
+			    !((idev->ifindex ^ meta.key->ingress_ifindex) &
+			      meta.mask->ingress_ifindex)) {
+				pon = true;
+				break;
+			}
+		}
