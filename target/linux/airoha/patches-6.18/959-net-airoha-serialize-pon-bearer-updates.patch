+{
+	bool input_pon = ingress && test_bit(AIROHA_DEV_F_PON, &ingress->flags);
+	bool output_pon = egress && test_bit(AIROHA_DEV_F_PON, &egress->flags);
+	struct airoha_qdma *qdma;
+
+	if (!input_pon && !output_pon)
+		return true;
+	/* IP FOE keys omit ingress domain and encapsulation. Keep both PON
+	 * directions in software until the hardware qualifier owns that scope.
+	 */
+	if (!READ_ONCE(ppe->ct_pon_qualified))
+		return false;
+	if (bridge || (input_pon && output_pon) ||
+	    !airoha_ppe_ct_ip_rule_supported(rule, false))
+		return false;
+	if (input_pon && (!airoha_ppe_ct_pon_dev_ready(ingress) || !egress))
+		return false;
+	if (!output_pon)
+		return true;
+	if (!airoha_ppe_ct_pon_dev_ready(egress))
+		return false;
+	qdma = airoha_qdma_deref(egress);
+	/* The direct T-CONT encoding requires WAN HQoS remapping to be disabled. */
+	return qdma == &egress->eth->qdma[1] &&
+	       !(airoha_qdma_rr(qdma, AIROHA_PON_QDMA_HQOS_CFG) &
+		 AIROHA_PON_QDMA_HQOS_EN);
+}
