+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by airoha_ct_ifc.h. All guards share the existing IFC ownership. */
+#define CT_IFC_CPU_ROW(_guard) (32 + (_guard))
+
+/* Complement of { 0x0800, 0x86dd } in sixteen ternary cubes. Shared bits
+ * reject their opposite value. Differing bits, XORed with 0x0800, must all
+ * be zero or all one for an IP EtherType; every mixed vector has a 0 -> 1
+ * transition in the cyclic bit order. These guards may overlap each other,
+ * but none overlaps a native plain-IP row, independent of row priority.
+ */
+static const struct {
+	u16 key, mask;
+} ct_ifc_non_ip[] = {
+	{ 0x0002, 0x0002 },
+	{ 0x0020, 0x0020 },
+	{ 0x0100, 0x0100 },
+	{ 0x1000, 0x1000 },
+	{ 0x2000, 0x2000 },
+	{ 0x4000, 0x4000 },
+	{ 0x0004, 0x0005 },
+	{ 0x0008, 0x000c },
+	{ 0x0010, 0x0018 },
+	{ 0x0040, 0x0050 },
+	{ 0x0080, 0x00c0 },
+	{ 0x0200, 0x0280 },
+	{ 0x0400, 0x0600 },
+	{ 0x0000, 0x0c00 },
+	{ 0x8800, 0x8800 },
+	{ 0x0001, 0x8001 },
+};
+
+static void ct_ifc_cpu_words(unsigned int guard, unsigned int page, u32 *words)
+{
+	static const u16 encap[] = { BIT(5), BIT(4), BIT(10) };
+
+	words[0] = words[1] = 0;
+	if (page == 0) {
+		words[0] = words[1] = XSI_ETH_VIP_PORT_MASK;
+	} else if (page == 8) {
+		/* Type0 supplies EtherType plus VLAN0/VLAN1/PPPoE presence. */
+		words[1] = CT_IFC_TCAM_TYPE_MASK;
+	} else if (guard < ARRAY_SIZE(encap) && page == 7) {
+		words[0] = words[1] = encap[guard];
+	} else if (guard >= ARRAY_SIZE(encap) && page == 5) {
+		words[0] = ct_ifc_non_ip[guard - ARRAY_SIZE(encap)].key;
+		words[1] = ct_ifc_non_ip[guard - ARRAY_SIZE(encap)].mask;
+	}
+}
+
+static int ct_ifc_cpu_audit(struct airoha_ppe *ppe)
+{
+	unsigned int guard, page;
+	int err;
+
+	for (guard = 0; guard < ARRAY_SIZE(ppe->ct_ifc.cpu_rule); guard++) {
+		struct airoha_ct_ifc_cpu_rule *rule = &ppe->ct_ifc.cpu_rule[guard];
+
+		for (page = 0; page < ARRAY_SIZE(ct_ifc_action_words); page++) {
+			err = ct_ifc_access(ppe->eth, CT_IFC_ACTION_BANK, CT_IFC_CPU_ROW(guard),
+					    page, false, rule->action[page], ct_ifc_action_words[page]);
+			if (err)
+				return err;
+		}
+		for (page = 0; page < ARRAY_SIZE(rule->tcam); page++) {
+			err = ct_ifc_access(ppe->eth, CT_IFC_TCAM_BANK, CT_IFC_CPU_ROW(guard),
+					    page, false, rule->tcam[page], 2);
+			if (err)
+				return err;
+		}
+	}
+	return 0;
+}
+
+static int ct_ifc_cpu_start(struct airoha_ppe *ppe)
+{
+	u32 action[][3] = { {}, { 0, 0, CT_IFC_CPU_RX_RING << 10 },
+			    { CT_IFC_ACTION_ENABLE | CT_IFC_ACTION_STOP |
+			      CT_IFC_ACTION_FORCE_CPU } };
+	unsigned int guard, page;
+	int err;
+
+	for (guard = 0; guard < ARRAY_SIZE(ppe->ct_ifc.cpu_rule); guard++) {
+		struct airoha_ct_ifc_cpu_rule *rule = &ppe->ct_ifc.cpu_rule[guard];
+
+		for (page = ARRAY_SIZE(rule->tcam); page-- > 0;) {
+			u32 words[2];
+
+			ct_ifc_cpu_words(guard, page, words);
+			rule->tcam_dirty |= BIT(page);
+			err = ct_ifc_write_verify(ppe->eth, CT_IFC_TCAM_BANK, CT_IFC_CPU_ROW(guard),
+						  page, words, 2);
+			if (err)
+				return err;
+		}
+		for (page = 0; page < ARRAY_SIZE(ct_ifc_action_words); page++) {
+			rule->action_dirty |= BIT(page);
+			err = ct_ifc_write_verify(ppe->eth, CT_IFC_ACTION_BANK, CT_IFC_CPU_ROW(guard),
+						  page, action[page], ct_ifc_action_words[page]);
+			if (err)
+				return err;
+		}
+	}
+	return 0;
+}
+
+/* Global IFC is already closed. Retain every failed shadow for a retry. */
+static int ct_ifc_cpu_stop(struct airoha_ppe *ppe)
+{
+	unsigned int guard, page;
+	int err = 0;
+
+	for (guard = 0; guard < ARRAY_SIZE(ppe->ct_ifc.cpu_rule); guard++) {
+		struct airoha_ct_ifc_cpu_rule *rule = &ppe->ct_ifc.cpu_rule[guard];
+
+		for (page = ARRAY_SIZE(ct_ifc_action_words); page-- > 0;) {
+			int ret;
+
+			if (!(rule->action_dirty & BIT(page)))
+				continue;
+			ret = ct_ifc_write_verify(ppe->eth, CT_IFC_ACTION_BANK, CT_IFC_CPU_ROW(guard),
+						 page, rule->action[page], ct_ifc_action_words[page]);
+			if (ret)
+				err = ret;
+			else
+				rule->action_dirty &= ~BIT(page);
+		}
+		for (page = 0; page < ARRAY_SIZE(rule->tcam); page++) {
+			int ret;
+
+			if (!(rule->tcam_dirty & BIT(page)))
+				continue;
+			ret = ct_ifc_write_verify(ppe->eth, CT_IFC_TCAM_BANK, CT_IFC_CPU_ROW(guard),
+						 page, rule->tcam[page], 2);
+			if (ret)
+				err = ret;
+			else
+				rule->tcam_dirty &= ~BIT(page);
+		}
+	}
+	return err;
+}
