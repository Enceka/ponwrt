From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: select pinned ordinary CT full-test firmware

Select the full-image ABI3 payload independently of the existing RAM and
stock loaders. Require the PPE and its NPU phandle to agree on the profile.

--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -302,19 +302,29 @@
 	static const u8 lab_sha256[][SHA256_DIGEST_SIZE] = {
 		{ 0x0c, 0x22, 0xad, 0xc3, 0xcd, 0xb8, 0x1c, 0x9f, 0xc2, 0x88, 0x31, 0xdf, 0xe5, 0x5f, 0x5d, 0xcb, 0x10, 0xbb, 0xac, 0x8e, 0x53, 0x90, 0xe6, 0x48, 0x02, 0x23, 0x53, 0x23, 0x7a, 0xbe, 0xdb, 0x11 },
 		{ 0xdf, 0x3f, 0x61, 0x98, 0x04, 0xa9, 0x2f, 0xdb, 0x40, 0x57, 0x19, 0x2d, 0xc4, 0x3d, 0xd7, 0x48, 0xea, 0x77, 0x8a, 0xdc, 0x52, 0xbc, 0x49, 0x8c, 0xe8, 0x05, 0x24, 0xc0, 0x14, 0xb8, 0x11, 0x19 },
+	};
+	static const u8 ordinary_sha256[SHA256_DIGEST_SIZE] = {
+		0x76, 0xed, 0x9c, 0x88, 0x2c, 0x5b, 0xc7, 0xdc,
+		0x50, 0x1b, 0xe3, 0x2d, 0x54, 0x08, 0xfe, 0x6b,
+		0xf5, 0xde, 0x8f, 0xd4, 0x99, 0x19, 0xab, 0x61,
+		0x0a, 0xd0, 0x65, 0x72, 0x54, 0xea, 0xdb, 0x7a,
 	};
+	bool full = of_property_read_bool(dev->of_node, "airoha,connac2-ordinary-full-test");
+	bool ram = of_property_read_bool(dev->of_node, "airoha,connac2-rebuilt-ram-lab");
 	bool ct = airoha_npu_is_connac2_ct(dev);
 	const char *fw_names[2];
 	int ret;
 
-	if (of_property_read_bool(dev->of_node, "airoha,connac2-rebuilt-ram-lab")) {
-		if (!ct)
+	if (ram || full) {
+		if (!ct || (ram && full))
 			return -EINVAL;
-		ret = airoha_npu_load_firmware(dev, addr, "airoha/hg5585f-ct/npu_rebuilt_rv32.bin",
-					       0x18000, lab_sha256[0], false);
+		ret = airoha_npu_load_firmware(dev, addr, full ?
+			"airoha/hg5585f-ct/npu_full_test_rv32.bin" : "airoha/hg5585f-ct/npu_rebuilt_rv32.bin",
+			0x18000, full ? ordinary_sha256 : lab_sha256[0], false);
 		if (ret)
 			return ret;
 		return airoha_npu_load_firmware(dev, base + REG_NPU_LOCAL_SRAM,
+					       full ? "airoha/hg5585f-ct/npu_full_test_data.bin" :
 					       "airoha/hg5585f-ct/npu_rebuilt_data.bin",
 					       4, lab_sha256[1], false);
 	}
@@ -397,7 +407,8 @@
 	int err;
 
 	if (!airoha_npu_wlan_short_guard_ready(npu) ||
-	    !of_property_read_bool(npu->dev->of_node, "airoha,connac2-rebuilt-ram-lab"))
+	    !(of_property_read_bool(npu->dev->of_node, "airoha,connac2-rebuilt-ram-lab") ||
+	      of_property_read_bool(npu->dev->of_node, "airoha,connac2-ordinary-full-test")))
 		return -EOPNOTSUPP;
 	packet.data.magic = cpu_to_le32(AIROHA_CT_PAIR_MAGIC);
 	packet.data.abi = cpu_to_le16(AIROHA_CT_PAIR_ABI);
@@ -1009,7 +1020,9 @@
 	msleep(100);
 
 	if (airoha_npu_is_connac2_ct(dev)) {
-		if (of_property_read_bool(dev->of_node, "airoha,connac2-rebuilt-ram-lab"))
+		if (of_property_read_bool(dev->of_node, "airoha,connac2-ordinary-full-test"))
+			dev_info(dev, "verified ordinary Connac2 full-test firmware\n");
+		else if (of_property_read_bool(dev->of_node, "airoha,connac2-rebuilt-ram-lab"))
 			dev_info(dev, "verified rebuilt Connac2 RAM firmware\n");
 		else
 			dev_info(dev, "verified Connac2 firmware 1456-50\n");
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -3526,12 +3526,16 @@
 	INIT_LIST_HEAD(&ppe->ct_bridge_flows);
 	eth->ppe = ppe;
 
-	if (of_property_read_bool(eth->dev->of_node, "airoha,connac2-ram-native-pairs")) {
+	if (of_property_read_bool(eth->dev->of_node, "airoha,connac2-ram-native-pairs") ||
+	    of_property_read_bool(eth->dev->of_node, "airoha,connac2-ordinary-full-test")) {
 		struct device_node *np = of_parse_phandle(eth->dev->of_node, "airoha,npu", 0);
 		bool ram_lab = np && of_property_read_bool(np, "airoha,connac2-rebuilt-ram-lab");
+		bool full = np && of_property_read_bool(np, "airoha,connac2-ordinary-full-test");
 
 		of_node_put(np);
-		if (!ram_lab || !airoha_ppe_ct_requested(eth))
+		if (ram_lab == full || !airoha_ppe_ct_requested(eth) ||
+		    ram_lab != of_property_read_bool(eth->dev->of_node, "airoha,connac2-ram-native-pairs") ||
+		    full != of_property_read_bool(eth->dev->of_node, "airoha,connac2-ordinary-full-test"))
 			return -EOPNOTSUPP;
 		ppe->ct_pairs = devm_kcalloc(eth->dev, AIROHA_CT_PAIR_SLOTS,
 					    sizeof(*ppe->ct_pairs), GFP_KERNEL);
