From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: own covered optical CPU route probes

Add RAM-only source coverage and explicit optical classifier routing.
Read back the complete CPU coverage before changing GDM2 forwarding.
Return the optical route to CPU before any classifier withdrawal or
rewrite, retaining ownership when route restoration fails.

--- a/drivers/net/ethernet/airoha/airoha_ct_pon_ifc_words.h
+++ b/drivers/net/ethernet/airoha/airoha_ct_pon_ifc_words.h
@@ -31,4 +31,23 @@
 	return 0;
 }
 
+static inline int
+airoha_ct_pon_ifc_cover_encode(struct airoha_ct_pon_ifc_words *row,
+			      unsigned int ring, unsigned int type)
+{
+	if (!row || (ring != 2 && ring != 4) || type > 1)
+		return -EINVAL;
+	*row = (struct airoha_ct_pon_ifc_words) {
+		.tcam = {
+			[0] = { BIT(2), BIT(2) },
+			[8] = { type << 6, 0xc0 },
+		},
+		.action = {
+			[1] = { 0, 0, ring << 10 },
+			[2] = { BIT(31) | BIT(30) | BIT(28), 0, 0 },
+		},
+	};
+	return 0;
+}
+
 #endif
