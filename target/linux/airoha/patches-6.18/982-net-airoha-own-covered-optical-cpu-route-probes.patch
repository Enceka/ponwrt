+static int airoha_ct_pon_ifc_route_close(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	u32 value;
+	int err = 0;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	spin_lock_bh(&eth->ct_route_lock);
+	if (ppe->ct_pon_ifc_route_owned) {
+		value = (airoha_fe_rr(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX)) &
+			 ~GENMASK(15, 0)) | FE_PSE_PORT_CDM2 * 0x1111;
+		airoha_fe_wr(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX), value);
+		if (airoha_fe_rr(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX)) != value)
+			err = -EIO;
+		else
+			ppe->ct_pon_ifc_route_owned = false;
+	}
+	spin_unlock_bh(&eth->ct_route_lock);
+	return err;
+}
+
+static int airoha_ct_pon_ifc_route_open(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	struct airoha_ct_pon_ifc_words expected;
+	unsigned int slot, row, page;
+	u32 actual[3], value;
+	int err = -ESHUTDOWN;
+
+	ASSERT_RTNL();
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!ppe->ct_pon_ifc_cover || !ppe->ct_pon_ifc.saved_valid ||
+	    ppe->ct_pon_ifc.pending || eth->ct_ifc_command_pending ||
+	    ppe->ct_pon_ifc_route_owned || !ppe->ct_host_ppe || ppe->ct_stopping ||
+	    ppe->ct_pon_qualified || !airoha_ct_pon_ifc_route_ready(ppe))
+		return err;
+	spin_lock_bh(&ppe_lock);
+	for (slot = 0; slot < 2; slot++) {
+		if (!(ppe->ct_pon_ifc_cover & BIT(slot)))
+			continue;
+		if ((ppe->ct_pon_ifc.active & (3 << (slot * 2))) != (3 << (slot * 2))) {
+			err = -ESHUTDOWN;
+			goto out;
+		}
+		for (row = 56 + slot * 2; row < 58 + slot * 2; row++) {
+			airoha_ct_pon_ifc_cover_encode(&expected, slot ? 4 : 2, row % 2);
+			for (page = 0; page < 9; page++) {
+				err = airoha_ct_pon_ifc_read(ppe, 0, row, page, actual, 2);
+				if (err)
+					goto out;
+				if (actual[1] != expected.tcam[page][1] ||
+				    ((actual[0] ^ expected.tcam[page][0]) & actual[1])) {
+					err = -EUCLEAN;
+					goto out;
+				}
+			}
+			for (page = 0; page < 3; page++) {
+				err = airoha_ct_pon_ifc_read(ppe, 2, row, page, actual,
+							    ct_ifc_action_words[page]);
+				if (err)
+					goto out;
+				if (memcmp(actual, expected.action[page],
+					   ct_ifc_action_words[page] * sizeof(u32))) {
+					err = -EUCLEAN;
+					goto out;
+				}
+			}
+		}
+	}
+	spin_lock_bh(&eth->ct_route_lock);
+	err = -ESHUTDOWN;
+	if (eth->ct_cpu_fallback || eth->ct_ifc_cpu_port_failed ||
+	    !ppe->ct_ifc.cfg_owned || !eth->ct_ifc_pon_ready ||
+	    eth->ct_ifc_port_mask != (XSI_ETH_VIP_PORT_MASK | BIT(2)) ||
+	    !(airoha_fe_rr(eth, REG_FE_IFC_PORT_EN) & BIT(2)) ||
+	    !(airoha_fe_rr(eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK) ||
+	    !airoha_ct_pon_ifc_route_ready(ppe))
+		goto unlock;
+	value = (airoha_fe_rr(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX)) &
+		 ~GENMASK(15, 0)) | FE_PSE_PORT_PPE2 * 0x1111;
+	ppe->ct_pon_ifc_route_owned = true;
+	airoha_fe_wr(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX), value);
+	err = airoha_fe_rr(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX)) == value ? 0 : -EIO;
+unlock:
+	spin_unlock_bh(&eth->ct_route_lock);
+out:
+	spin_unlock_bh(&ppe_lock);
+	if (err && (ppe->ct_pon_ifc.pending || ppe->ct_pon_ifc_route_owned))
+		airoha_ct_pon_ifc_fault(ppe);
+	return err;
+}
