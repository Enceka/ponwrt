From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: probe optical source predicates under CPU coverage

Expose a bounded RAM-only source bitmap diagnostic using the existing row
owner. Require the second CPU cover and quiescent native policy before
publishing typed source-only rows in the first slot. Retain the second
cover and return the route to CPU for each replacement.

--- a/drivers/net/ethernet/airoha/airoha_ct_pon_ifc_cpu.h
+++ b/drivers/net/ethernet/airoha/airoha_ct_pon_ifc_cpu.h
@@ -409,6 +409,38 @@
 		schedule_delayed_work(&ppe->ct_pon_ifc_work, msecs_to_jiffies(100));
 }
 
+static int airoha_ct_pon_ifc_source_set(struct airoha_ppe *ppe, unsigned int source,
+				       unsigned int mode)
+{
+	struct airoha_ct_pon_ifc_io io = airoha_ct_pon_ifc_io(ppe);
+	struct airoha_ct_pon_ifc_words rows[2];
+	unsigned int type;
+	int err;
+
+	ASSERT_RTNL();
+	lockdep_assert_held(&flow_offload_mutex);
+	if (source > 31 || mode > 2)
+		return -EINVAL;
+	if (!(ppe->ct_pon_ifc_cover & BIT(1)) || ppe->ct_fe.active ||
+	    ppe->ct_pair_policy_allowed)
+		return -EBUSY;
+	err = airoha_ct_pon_ifc_cpu_publish(ppe, 0, 0, true);
+	if (err)
+		return err;
+	for (type = 0; type < 2; type++) {
+		airoha_ct_pon_ifc_cover_encode(&rows[type], 2, type);
+		rows[type].tcam[0][0] = mode == 1 ? 0 : BIT(source);
+		rows[type].tcam[0][1] = mode == 2 ? U32_MAX : BIT(source);
+	}
+	ppe->ct_pon_ifc_cover &= ~BIT(0);
+	spin_lock_bh(&ppe_lock);
+	err = airoha_ct_pon_ifc_publish(&ppe->ct_pon_ifc, &io, 0, rows);
+	spin_unlock_bh(&ppe_lock);
+	if (err)
+		airoha_ct_pon_ifc_fault(ppe);
+	return err;
+}
+
 static ssize_t ct_pon_cpu_probe_show(struct device *dev,
 				    struct device_attribute *attr, char *buf)
 {
@@ -445,7 +477,9 @@
 		if (!strcmp(command, "set")) {
 			if (fields != 3 || kstrtouint(service_word, 0, &service))
 				return -EINVAL;
-		} else if ((strcmp(command, "clear") && strcmp(command, "cover")) || fields != 2)
+		} else if ((strcmp(command, "clear") && strcmp(command, "cover") &&
+			    strcmp(command, "source") && strcmp(command, "absent") &&
+			    strcmp(command, "only")) || fields != 2)
 			return -EINVAL;
 	}
 	rtnl_lock();
@@ -461,6 +495,12 @@
 		err = airoha_ct_pon_ifc_route_open(ppe);
 	else if (!strcmp(command, "cover"))
 		err = airoha_ct_pon_ifc_cpu_publish(ppe, slot, 0, true);
+	else if (!strcmp(command, "source"))
+		err = airoha_ct_pon_ifc_source_set(ppe, slot, 0);
+	else if (!strcmp(command, "absent"))
+		err = airoha_ct_pon_ifc_source_set(ppe, slot, 1);
+	else if (!strcmp(command, "only"))
+		err = airoha_ct_pon_ifc_source_set(ppe, slot, 2);
 	else if (!strcmp(command, "set"))
 		err = airoha_ct_pon_ifc_cpu_set(ppe, slot, service);
 	else
