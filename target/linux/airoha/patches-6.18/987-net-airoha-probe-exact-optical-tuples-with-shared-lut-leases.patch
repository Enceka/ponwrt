 }
 
+static int airoha_ct_pon_ifc_cpu_tuple(struct airoha_ppe *ppe,
+				      unsigned int slot, unsigned int service)
+{
+	struct airoha_ct_pon_ifc_io io = airoha_ct_pon_ifc_io(ppe);
+	struct airoha_ct_ifc_pool_io pool_io = airoha_ct_pon_ifc_tuple_io(ppe);
+	struct airoha_ct_ifc_tuple_words words[2];
+	struct airoha_ct_pon_ifc_words rows[2];
+	struct airoha_eth *eth = ppe->eth;
+	unsigned int family;
+	int err;
+
+	ASSERT_RTNL();
+	lockdep_assert_held(&flow_offload_mutex);
+	if (slot || !service || service > U16_MAX)
+		return -EINVAL;
+	if (airoha_ct_pon_ifc_tuple_busy(ppe) ||
+	    (ppe->ct_pon_ifc.active & 3) || (ppe->ct_pon_ifc.dirty & 3) ||
+	    !(ppe->ct_pon_ifc_cover & BIT(1)))
+		return -EBUSY;
+	err = airoha_ct_pon_ifc_route_close(ppe);
+	if (err)
+		goto fault;
+	if (!READ_ONCE(ppe->ct_pon_ifc_registered) ||
+	    READ_ONCE(ppe->ct_pon_ifc_work_stopping) ||
+	    !READ_ONCE(ppe->ct_host_ppe) || READ_ONCE(ppe->ct_stopping) ||
+	    READ_ONCE(ppe->ct_pon_qualified) || READ_ONCE(eth->ct_cpu_fallback) ||
+	    READ_ONCE(eth->ct_ifc_cpu_port_failed) || !READ_ONCE(eth->ct_ifc_pon_ready) ||
+	    !ppe->ct_pon_ifc.saved_valid || ppe->ct_pon_ifc.pending ||
+	    eth->ct_ifc_command_pending || !airoha_ifc_lan_ports_ready(eth) ||
+	    !airoha_ct_pon_ifc_route_ready(ppe))
+		return -ESHUTDOWN;
+	err = airoha_ct_pon_ifc_tuple_words(words);
+	if (err)
+		return err;
+	for (family = 0; family < 2; family++)
+		airoha_ct_pon_ifc_cover_encode(&rows[family], 4, family);
+	spin_lock_bh(&ppe_lock);
+	err = airoha_ct_pon_ifc_dependencies(ppe);
+	if (!err)
+		err = airoha_ct_pon_ifc_rows_check(ppe, 1, rows);
+	if (!err)
+		err = airoha_ct_pon_ifc_tuple_space(ppe, words);
+	if (!err) {
+		ppe->ct_pon_ifc_tuple = true;
+		for (family = 0; family < 2; family++) {
+			err = airoha_ct_ifc_pool_acquire(&ppe->ct_pon_ifc_pool, &pool_io,
+							&words[family], &ppe->ct_pon_ifc_lease[family]);
+			if (err)
+				break;
+		}
+	}
+	if (!err)
+		err = airoha_ct_pon_ifc_tuple_rows(ppe, service, rows);
+	if (!err)
+		err = airoha_ct_pon_ifc_publish(&ppe->ct_pon_ifc, &io, 0, rows);
+	if (!err) {
+		ppe->ct_pon_ifc_services[0] = service;
+		ppe->ct_pon_ifc_cover &= ~BIT(0);
+	}
+	spin_unlock_bh(&ppe_lock);
+	if (!err || (err == -ENOSPC && !airoha_ct_pon_ifc_tuple_busy(ppe)))
+		return err;
+fault:
+	airoha_ct_pon_ifc_fault(ppe);
+	return err;
+}
