--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_bank1_routes.h
@@ -0,0 +1,87 @@
+#ifndef AIROHA_BANK1_ROUTES_H
+#define AIROHA_BANK1_ROUTES_H
+
+static int airoha_bank1_routes_write_all(struct airoha_eth *eth, bool guarded)
+{
+	unsigned int id;
+	int error = 0;
+
+	lockdep_assert_held(&eth->ct_route_lock);
+	for (id = AIROHA_GDM1_IDX; id <= AIROHA_GDM4_IDX; ++id) {
+		u32 config = airoha_fe_rr(eth, REG_GDM_FWD_CFG(id));
+		int result;
+
+		config = (config & ~GENMASK(15, 0)) |
+			 eth->ct_bank1_routes.desired[id - 1];
+		result = airoha_ct_gdm_route_write_locked(eth, id, config, guarded);
+		if (result && !error)
+			error = result;
+	}
+	return error;
+}
+
+int airoha_bank1_routes_claim(struct airoha_eth *eth, const void *owner)
+{
+	struct airoha_bank1_routes *routes;
+	unsigned int id;
+	int error;
+
+	if (!eth || !owner)
+		return -EINVAL;
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!eth->ppe || !eth->ppe->ct_host_ppe || eth->soc->num_ppe < 2)
+		return -EOPNOTSUPP;
+	routes = &eth->ct_bank1_routes;
+	spin_lock_bh(&eth->ct_route_lock);
+	if ((routes->owner && routes->owner != owner) ||
+	    eth->ppe->ct_pon_ifc_route_owned) {
+		error = -EBUSY;
+		goto unlock;
+	}
+	if (!routes->owner) {
+		for (id = AIROHA_GDM1_IDX; id <= AIROHA_GDM4_IDX; ++id)
+			routes->desired[id - 1] =
+				airoha_fe_rr(eth, REG_GDM_FWD_CFG(id));
+		routes->owner = owner;
+	}
+	routes->ready = false;
+	error = airoha_bank1_routes_write_all(eth, true);
+	routes->ready = !error;
+unlock:
+	spin_unlock_bh(&eth->ct_route_lock);
+	return error;
+}
+
+int airoha_bank1_routes_release(struct airoha_eth *eth, const void *owner)
+{
+	struct airoha_bank1_routes *routes;
+	int error;
+
+	if (!eth || !owner)
+		return -EINVAL;
+	lockdep_assert_held(&flow_offload_mutex);
+	routes = &eth->ct_bank1_routes;
+	spin_lock_bh(&eth->ct_route_lock);
+	if (routes->owner != owner) {
+		error = -ESTALE;
+		goto unlock;
+	}
+	if (airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1)) ||
+	    (airoha_fe_rr(eth, REG_PPE_GLO_CFG(1)) & PPE_GLO_CFG_BUSY_MASK)) {
+		error = -EBUSY;
+		goto unlock;
+	}
+	routes->ready = false;
+	error = airoha_bank1_routes_write_all(eth, false);
+	if (error) {
+		airoha_bank1_routes_write_all(eth, true);
+		goto unlock;
+	}
+	routes->owner = NULL;
+	memset(routes->desired, 0, sizeof(routes->desired));
+unlock:
+	spin_unlock_bh(&eth->ct_route_lock);
+	return error;
+}
+
+#endif
