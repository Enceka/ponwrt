From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: own GDM default routes around bank1 isolation

Keep an exclusive owner's desired GDM selectors separate from their
CPU-filtered hardware values. Route every PPE2 default selector to its
actual CPU receiver while ownership is held, including reopen and QDMA
migration. Reject the optical classifier probe's direct bank1 opening.

Retain all route snapshots on readback failure. Release only after bank1
flow processing and BUSY are clear, restore the latest requested routes
through ordinary/fault policy, and reclose all routes on a partial error.
The lifecycle owner must stop NPU ingress and retire its FOE entries first.

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -852,6 +852,12 @@
 	} ops;
 };
 
+struct airoha_bank1_routes {
+	const void *owner;
+	u16 desired[AIROHA_MAX_NUM_GDM_PORTS];
+	bool ready;
+};
+
 struct airoha_eth {
 	struct device *dev;
 
@@ -871,6 +877,7 @@
 
 	/* Serializes sticky CPU fallback with GDM routes and QDMA publication. */
 	spinlock_t ct_route_lock;
+	struct airoha_bank1_routes ct_bank1_routes;
 	u16 ct_cpu_route_mask[AIROHA_MAX_NUM_GDM_PORTS];
 	bool ct_ifc_cpu_port_failed;
 	bool ct_ifc_command_pending;
@@ -984,6 +991,8 @@
 bool airoha_ifc_lan_ports_ready(struct airoha_eth *eth);
 int airoha_gdm_fwd_cfg_update(struct airoha_eth *eth, unsigned int id,
 			     u32 mask, u32 value);
+int airoha_bank1_routes_claim(struct airoha_eth *eth, const void *owner);
+int airoha_bank1_routes_release(struct airoha_eth *eth, const void *owner);
 int airoha_ct_cpu_fallback(struct airoha_eth *eth);
 int airoha_ppe_ct_shutdown(struct airoha_eth *eth);
 int airoha_ppe_ct_prepare(struct airoha_eth *eth);
