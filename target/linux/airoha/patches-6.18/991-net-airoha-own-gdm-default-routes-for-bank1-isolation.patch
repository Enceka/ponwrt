+static int airoha_ct_gdm_route_write_locked(struct airoha_eth *eth, unsigned int id,
+					    u32 cfg, bool guarded)
 {
 	u16 mask = eth->ct_cpu_route_mask[id - 1];
 	int cpu = 0, err = 0;
 
 	lockdep_assert_held(&eth->ct_route_lock);
+	if (guarded && eth->ct_bank1_routes.owner) {
