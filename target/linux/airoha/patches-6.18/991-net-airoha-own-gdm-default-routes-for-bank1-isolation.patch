 	return err;
 }
 
+static int airoha_ct_gdm_route_locked(struct airoha_eth *eth, unsigned int id,
+				      u32 cfg)
+{
+	lockdep_assert_held(&eth->ct_route_lock);
+	if (eth->ct_bank1_routes.owner)
+		cfg = (cfg & ~GENMASK(15, 0)) |
+		      eth->ct_bank1_routes.desired[id - 1];
+	return airoha_ct_gdm_route_write_locked(eth, id, cfg, true);
+}
