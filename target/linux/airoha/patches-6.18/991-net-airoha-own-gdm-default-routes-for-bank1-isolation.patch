+
+		for (shift = 0; shift < 16; shift += 4)
+			if (((cfg >> shift) & 0xf) == FE_PSE_PORT_PPE2)
+				mask |= 0xf << shift;
+	}
 	if (mask) {
@@ -141,4 +148,16 @@
+	if (err && eth->ct_bank1_routes.owner)
