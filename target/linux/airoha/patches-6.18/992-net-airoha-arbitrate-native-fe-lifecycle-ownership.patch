-static int airoha_ct_fe_quiesce(struct airoha_ppe *ppe, u64 generation)
+static int __maybe_unused airoha_ct_fe_owner_claim(struct airoha_ppe *ppe,
+						 const void *owner)
+{
+	lockdep_assert_held(&ppe_lock);
+	if (!owner)
+		return -EINVAL;
+	if (ppe->ct_fe.owner)
+		return ppe->ct_fe.owner == owner ? 0 : -EBUSY;
+	if (ppe->ct_pair_failed || ppe->ct_stopping || ppe->ct_fe.health_stopping ||
+	    READ_ONCE(ppe->eth->ct_ifc_cpu_port_failed) ||
+	    READ_ONCE(ppe->eth->ct_cpu_fallback))
+		return -ESHUTDOWN;
+	if (ppe->ct_pair_policy_allowed ||
+	    (ppe->ct_pairs && airoha_ct_pair_any(ppe)) ||
+	    ppe->ct_fe.pending || ppe->ct_fe.arm_pending || ppe->ct_fe.armed ||
+	    ppe->ct_fe.active || ppe->ct_fe.touched || ppe->ct_fe.drain_pending)
+		return -EBUSY;
+	ppe->ct_fe.owner_quiesced = false;
+	ppe->ct_fe.owner = owner;
+	return 0;
+}
+
+static int __maybe_unused airoha_ct_fe_owner_quiesce(struct airoha_ppe *ppe,
+						   const void *owner, u64 generation,
+						   u32 epoch)
+{
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+	if (!owner || !generation || !epoch)
+		return -EINVAL;
+	if (ppe->ct_fe.owner != owner)
+		return -ESTALE;
+	if (ppe->ct_fe.pending) {
+		if (ppe->ct_fe.pending_epoch != epoch ||
+		    ppe->ct_fe.pending_generation != generation)
+			return -ESTALE;
+	} else {
+		if (epoch < ppe->ct_fe.epoch || epoch <= ppe->ct_pair_wired_epoch ||
+		    generation < ppe->ct_fe.generation ||
+		    (epoch == ppe->ct_fe.epoch && generation != ppe->ct_fe.generation))
+			return -ESTALE;
+		ppe->ct_fe.pending_epoch = epoch;
+		ppe->ct_fe.pending_generation = generation;
+		ppe->ct_fe.pending = true;
+	}
+	ppe->ct_fe.owner_quiesced = false;
+	err = airoha_ct_fe_control_owned_from(ppe, owner, AIROHA_CT_PAIR_FE_QUIESCE,
+					      generation, epoch, __func__, __LINE__);
+	if (err)
+		return err > 0 ? -EPROTO : err;
+	ppe->ct_fe.epoch = epoch;
+	ppe->ct_fe.generation = generation;
+	ppe->ct_pair_wired_epoch = epoch - 1;
+	ppe->ct_fe.pending = false;
+	ppe->ct_fe.arm_pending = false;
+	ppe->ct_fe.armed = false;
+	ppe->ct_fe.active = false;
+	ppe->ct_fe.owner_quiesced = true;
+	return 0;
+}
+
+static int __maybe_unused airoha_ct_fe_owner_release(struct airoha_ppe *ppe,
+						   const void *owner)
+{
+	lockdep_assert_held(&ppe_lock);
+	if (!owner)
+		return -EINVAL;
+	if (ppe->ct_fe.owner != owner)
+		return -ESTALE;
+	if (!ppe->ct_fe.owner_quiesced || ppe->ct_fe.pending || ppe->ct_fe.arm_pending ||
+	    ppe->ct_fe.armed || ppe->ct_fe.active || ppe->ct_fe.touched ||
+	    ppe->ct_fe.drain_pending)
+		return -EBUSY;
+	ppe->ct_fe.owner_quiesced = false;
+	ppe->ct_fe.owner = NULL;
+	return 0;
+}
+
+static int airoha_ct_fe_quiesce(struct airoha_ppe *ppe, u64 generation)
 {
 	u32 epoch;
