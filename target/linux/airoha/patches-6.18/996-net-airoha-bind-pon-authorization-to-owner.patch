--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_npu_admission.h
@@ -0,0 +1,144 @@
+#ifndef AIROHA_NPU_ADMISSION_H
+#define AIROHA_NPU_ADMISSION_H
+
+static int airoha_npu_owner_return_ready(struct airoha_npu_owner *owner,
+					 const struct airoha_npu_txn_identity *id)
+{
+	struct airoha_ppe *ppe = owner->ppe;
+	struct airoha_npu_return *path = owner->return_path;
+	int error;
+
+	if (!ppe->ct_host_ppe || ppe->ct_stopping || owner->native_stopped ||
+	    owner->stop_completed || !path || !path->ring ||
+	    !smp_load_acquire(&path->bound))
+		return -EBUSY;
+	if (READ_ONCE(path->fault) || READ_ONCE(ppe->eth->ct_cpu_fallback))
+		return -EIO;
+	if (path->epoch != id->epoch || path->generation != id->generation ||
+	    id->open_mask != GATE_PON2 ||
+	    ppe->eth->ct_bank1_routes.owner != owner || !ppe->eth->ct_bank1_routes.ready)
+		return -ESTALE;
+	spin_lock_bh(&ppe_lock);
+	error = ppe->ct_fe.owner == owner && ppe->ct_fe.owner_quiesced &&
+		!ppe->ct_fe.pending && !ppe->ct_fe.arm_pending && !ppe->ct_fe.armed &&
+		ppe->ct_fe.epoch == id->epoch && ppe->ct_fe.generation == id->generation ?
+		0 : -ESTALE;
+	spin_unlock_bh(&ppe_lock);
+	if (error)
+		return error;
+	rcu_read_lock();
+	error = airoha_npu_return_mapping(path, netdev_from_priv(path->dev)) ? 0 : -ESTALE;
+	rcu_read_unlock();
+	return error;
+}
+
+int airoha_ppe_npu_owner_authorize_locked(struct airoha_eth *eth,
+					  const struct airoha_npu_auth_rule *rules,
+					  u32 count)
+{
+	struct airoha_npu_owner *owner;
+	struct airoha_npu_return *path;
+	unsigned int index;
+	int error;
+
+	if (!eth || !eth->ppe)
+		return -EINVAL;
+	lockdep_assert_held(&flow_offload_mutex);
+	owner = eth->ppe->ct_npu_owner;
+	if (!owner || owner->txn.phase != NPU_TXN_CLOSED || owner->auth_attempted)
+		return -EBUSY;
+	error = airoha_npu_auth_rules_validate(owner->txn.id.epoch,
+					      owner->txn.id.generation, rules, count);
+	if (error)
+		return error;
+	error = airoha_npu_owner_return_ready(owner, &owner->txn.id);
+	if (error)
+		return error;
+	path = owner->return_path;
+	rcu_read_lock();
+	for (index = 0; index < count; ++index)
+		if (!airoha_npu_return_binding(path, netdev_from_priv(path->dev),
+					       &path->config,
+					       ER_SERVICE_VALID | rules[index].raw[7])) {
+			error = -ESTALE;
+			break;
+		}
+	rcu_read_unlock();
+	if (error)
+		return error;
+	owner->auth_attempted = true;
+	owner->epoch_dirty = true;
+	error = airoha_npu_auth_publish(owner->txn.id.epoch, owner->txn.id.generation,
+					rules, count, airoha_npu_owner_auth, owner);
+	if (!error)
+		error = airoha_npu_owner_return_ready(owner, &owner->txn.id);
+	if (!error)
+		owner->auth_count = count;
+	return error;
+}
+
+static int airoha_npu_owner_ready(void *ctx,
+				  const struct airoha_npu_txn_identity *id)
+{
+	struct airoha_npu_owner *owner = ctx;
+	struct npu_auth_message message = {
+		.w = {
+			[AM_MAGIC] = AUTH_MBOX_MAGIC,
+			[AM_ABI_OP] = AUTH_MBOX_ABI | AUTH_MBOX_QUERY << 16,
+			[AM_BYTES] = AUTH_MBOX_BYTES,
+			[AM_STATUS] = (auth_u32)-EINPROGRESS,
+		},
+	};
+	int error;
+
+	if (!owner->ppe->ct_pon_qualified)
+		return -EOPNOTSUPP;
+	error = airoha_npu_owner_return_ready(owner, id);
+	if (error)
+		return error;
+	if (!owner->auth_attempted || !owner->auth_count)
+		return -EACCES;
+	error = airoha_npu_owner_auth(owner, &message);
+	if (error)
+		return error;
+	if (message.w[AM_STATE_EPOCH] != id->epoch ||
+	    message.w[AM_STATE_GENERATION] != id->generation ||
+	    message.w[AM_COUNT] != owner->auth_count ||
+	    message.w[AM_ENABLED] != 1 || message.w[AM_INFLIGHT])
+		return -ESTALE;
+	return airoha_npu_owner_return_ready(owner, id);
+}
+
+int airoha_ppe_npu_owner_renew_locked(struct airoha_eth *eth, u64 generation)
+{
+	struct airoha_npu_owner *owner;
+	int error;
+
+	if (!eth || !eth->ppe || !generation)
+		return -EINVAL;
+	if (generation > U32_MAX)
+		return -EOVERFLOW;
+	lockdep_assert_held(&flow_offload_mutex);
+	owner = eth->ppe->ct_npu_owner;
+	if (!owner || !eth->ppe->ct_host_ppe || owner->native_stopped || owner->stop_completed)
+		return -EBUSY;
+	if (generation < owner->txn.id.generation || generation != br_flow_offload_generation())
+		return -ESTALE;
+	error = airoha_ppe_npu_owner_close_locked(eth);
+	if (error)
+		return error;
+	if (generation != owner->txn.id.generation) {
+		if (owner->txn.id.epoch == U32_MAX)
+			return -EOVERFLOW;
+		error = airoha_npu_txn_begin(&owner->txn, owner->txn.id.epoch + 1,
+					     generation, owner->txn.id.open_mask);
+		if (error)
+			return error;
+		error = airoha_ppe_npu_owner_close_locked(eth);
+		if (error)
+			return error;
+	}
+	return generation == br_flow_offload_generation() ? 0 : -ESTALE;
+}
+
+#endif
