-	if (cur_qdma && cur_qdma != qdma) {
+	if (cur_qdma != qdma) {
 		err = airoha_ct_ifc_cpu_port_change(eth,
 			eth->soc->ops.get_sport(dev->port, dev->nbq));
 		if (err)
@@ -2900,16 +2902,42 @@
 	}
 
 	if (cur_qdma) {
+		bitmap_zero(tx_stopped, AIROHA_NUM_NETDEV_TX_RINGS);
+		for (i = 0; i < netdev->num_tx_queues; ++i)
+			if (netif_tx_queue_stopped(netdev_get_tx_queue(netdev, i)))
+				__set_bit(i, tx_stopped);
+		lro_enabled = airoha_fe_lro_is_enabled(eth, cur_qdma - &eth->qdma[0]);
 		netif_tx_stop_all_queues(netdev);
 		airoha_dev_lro_disable(dev);
 	}
 
 	spin_lock_bh(&eth->ct_route_lock);
 	rcu_assign_pointer(dev->qdma, qdma);
+	err = 0;
 	if (eth->ct_cpu_fallback || eth->ct_bank1_routes.owner)
-		airoha_ct_gdm_route_locked(eth, dev->port->id,
+		err = airoha_ct_gdm_route_locked(eth, dev->port->id,
 			airoha_fe_rr(eth, REG_GDM_FWD_CFG(dev->port->id)));
+	if (err) {
+		int rollback_error;
+
+		rcu_assign_pointer(dev->qdma, cur_qdma);
+		rollback_error = airoha_ct_gdm_route_locked(eth, dev->port->id,
+			airoha_fe_rr(eth, REG_GDM_FWD_CFG(dev->port->id)));
+		if (rollback_error)
+			dev_err_ratelimited(eth->dev, "QDMA route rollback failed: %d\n", rollback_error);
+	}
 	spin_unlock_bh(&eth->ct_route_lock);
+	if (err) {
+		synchronize_rcu();
+		if (cur_qdma) {
+			for (i = 0; i < netdev->num_tx_queues; ++i)
+				if (!test_bit(i, tx_stopped))
+					netif_tx_wake_queue(netdev_get_tx_queue(netdev, i));
+			if (lro_enabled)
+				airoha_dev_lro_enable(dev);
+		}
+		return err;
+	}
 	netdev->irq = qdma->irq_banks[0].irq;
 	qdma->users++;
 	synchronize_rcu();
@@ -4284,6 +4312,7 @@
 {
 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
 	struct airoha_gdm_port *port = dev->port;
+	bool was_wan = test_bit(AIROHA_DEV_F_WAN, &dev->flags);
 	int err;
 
 	if (port->id != AIROHA_GDM3_IDX &&
@@ -4296,8 +4325,18 @@
 
 	clear_bit(AIROHA_DEV_F_WAN, &dev->flags);
 	err = airoha_dev_set_qdma(dev);
-	if (err)
+	if (err) {
+		if (was_wan) {
+			int rollback_error;
+
+			set_bit(AIROHA_DEV_F_WAN, &dev->flags);
+			rollback_error = airoha_enable_gdm2_loopback(dev);
+			if (rollback_error)
+				dev_err_ratelimited(dev->eth->dev,
+						    "QoS loopback rollback failed: %d\n", rollback_error);
+		}
 		return err;
+	}
 	airoha_dev_set_xmit_frame_size(netdev);
 
 	airoha_set_macaddr(dev, netdev->dev_addr);
--- a/drivers/net/ethernet/airoha/airoha_ct_cpu_fallback.h
+++ b/drivers/net/ethernet/airoha/airoha_ct_cpu_fallback.h
@@ -5,11 +5,19 @@
 /* Stop forceCPU users before either its source map or QDMA receiver changes.
  * Failed gate readback leaves the old map and receiver in place.
  */
+static int airoha_bank1_routes_revoke_locked(struct airoha_eth *eth);
+
 static int airoha_ct_ifc_cpu_route_close_locked(struct airoha_eth *eth)
 {
 	int err = 0;
 
 	lockdep_assert_held(&eth->ct_route_lock);
+	if (eth->ct_bank1_routes.owner &&
+	    (eth->ct_bank1_routes.pon_open || eth->ct_bank1_routes.revoked)) {
+		err = airoha_bank1_routes_revoke_locked(eth);
+		if (err)
+			return err;
+	}
 	if (eth->ppe && READ_ONCE(eth->ppe->ct_ifc.cfg_owned)) {
 		if (eth->ppe->ct_pon_ifc_route_owned) {
 			u32 value = (airoha_fe_rr(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX)) &
@@ -34,7 +42,8 @@
 	int err = 0;
 
 	spin_lock_bh(&eth->ct_route_lock);
-	if (sport == 24 || (sport == 2 && READ_ONCE(eth->ct_ifc_pon_ready)))
+	if (sport == 24 || (sport == 2 && (READ_ONCE(eth->ct_ifc_pon_ready) ||
+					 eth->ct_bank1_routes.owner)))
 		err = airoha_ct_ifc_cpu_route_close_locked(eth);
 	spin_unlock_bh(&eth->ct_route_lock);
 	return err;
@@ -113,15 +122,24 @@
 	if (guarded && eth->ct_bank1_routes.owner) {
 		unsigned int shift;
 
-		for (shift = 0; shift < 16; shift += 4)
-			if (((cfg >> shift) & 0xf) == FE_PSE_PORT_PPE2)
-				mask |= 0xf << shift;
+		if (id == AIROHA_GDM2_IDX && eth->ct_bank1_routes.pon_open) {
+			cfg = (cfg & ~GENMASK(15, 0)) | FE_PSE_PORT_PPE2 * 0x1111;
+			cpu = airoha_ct_gdm_cpu_locked(eth, id);
+			if (cpu != FE_PSE_PORT_CDM2) {
+				err = cpu < 0 ? cpu : -EXDEV;
+				mask = GENMASK(15, 0);
+			}
+		} else
+			for (shift = 0; shift < 16; shift += 4)
+				if (((cfg >> shift) & 0xf) == FE_PSE_PORT_PPE2)
+					mask |= 0xf << shift;
 	}
 	if (mask) {
 		cpu = airoha_ct_gdm_cpu_locked(eth, id);
 		if (cpu < 0) {
 			/* No configured device has no CPU receiver to preserve. */
-			err = cpu == -ENODEV ? 0 : cpu;
+			if (!err)
+				err = cpu == -ENODEV ? 0 : cpu;
 			cpu = FE_PSE_PORT_DROP;
 		}
 		cfg = airoha_ct_cpu_selectors(cfg, mask, cpu);
@@ -145,8 +163,12 @@
 			schedule_delayed_work(&eth->ppe->ct_fe.health_work,
