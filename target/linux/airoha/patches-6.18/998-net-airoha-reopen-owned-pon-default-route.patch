+		err = airoha_bank1_routes_revoke_locked(eth);
+		if (err)
+			goto unlock;
+	}
 	if (id == AIROHA_GDM2_IDX && READ_ONCE(eth->ct_ifc_pon_ready) &&
 	    ((cfg ^ previous) & GENMASK(15, 0))) {
 		err = airoha_ct_ifc_cpu_route_close_locked(eth);
@@ -206,6 +235,14 @@
 
 	spin_lock_bh(&eth->ct_route_lock);
 	WRITE_ONCE(eth->ct_cpu_fallback, true);
+	if (eth->ct_bank1_routes.owner) {
+		if (eth->ct_bank1_routes.pon_open) {
+			eth->ct_cpu_route_mask[AIROHA_GDM2_IDX - 1] = GENMASK(15, 0);
+			eth->ct_bank1_routes.ready = false;
+		}
+		eth->ct_bank1_routes.pon_open = false;
+		eth->ct_bank1_routes.revoked = true;
+	}
 	for (id = AIROHA_GDM1_IDX; id <= AIROHA_GDM4_IDX; id++) {
 		u32 cfg = airoha_fe_rr(eth, REG_GDM_FWD_CFG(id));
 
--- a/drivers/net/ethernet/airoha/airoha_bank1_routes.h
+++ b/drivers/net/ethernet/airoha/airoha_bank1_routes.h
@@ -18,6 +18,19 @@
 			error = result;
 	}
 	return error;
+}
+
+static int airoha_bank1_routes_revoke_locked(struct airoha_eth *eth)
+{
+	struct airoha_bank1_routes *routes = &eth->ct_bank1_routes;
+
+	lockdep_assert_held(&eth->ct_route_lock);
+	if (!routes->owner)
+		return 0;
+	routes->pon_open = false;
+	routes->revoked = true;
+	routes->ready = false;
+	return airoha_bank1_routes_write_all(eth, true);
 }
 
 int airoha_bank1_routes_claim(struct airoha_eth *eth, const void *owner)
@@ -44,9 +57,53 @@
 				airoha_fe_rr(eth, REG_GDM_FWD_CFG(id));
 		routes->owner = owner;
 	}
+	routes->pon_open = false;
+	routes->revoked = false;
 	routes->ready = false;
 	error = airoha_bank1_routes_write_all(eth, true);
 	routes->ready = !error;
+unlock:
+	spin_unlock_bh(&eth->ct_route_lock);
+	return error;
+}
+
+int airoha_bank1_routes_open(struct airoha_eth *eth, const void *owner)
+{
+	struct airoha_bank1_routes *routes;
+	int error;
+
+	if (!eth || !eth->ppe || !owner)
+		return -EINVAL;
+	lockdep_assert_held(&flow_offload_mutex);
+	routes = &eth->ct_bank1_routes;
+	spin_lock_bh(&eth->ct_route_lock);
+	if (routes->owner != owner || !routes->ready || routes->revoked) {
+		error = -ESTALE;
+		goto unlock;
+	}
+	if (!eth->ppe->ct_pon_qualified || eth->ct_ordinary_full_test) {
+		error = -EOPNOTSUPP;
+		goto unlock;
+	}
+	if (eth->ct_cpu_fallback || eth->ct_cpu_route_mask[AIROHA_GDM2_IDX - 1] ||
+	    eth->ppe->ct_stopping || eth->ppe->ct_pon_ifc_route_owned) {
+		error = -EBUSY;
+		goto unlock;
+	}
+	error = airoha_ct_gdm_cpu_locked(eth, AIROHA_GDM2_IDX);
+	if (error != FE_PSE_PORT_CDM2) {
+		error = error < 0 ? error : -EXDEV;
+		goto unlock;
+	}
+	if (!(airoha_fe_rr(eth, REG_PPE_GLO_CFG(1)) & PPE_GLO_CFG_EN_MASK) ||
+	    !airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1))) {
+		error = -EIO;
+		goto unlock;
+	}
+	routes->pon_open = true;
+	error = airoha_bank1_routes_write_all(eth, true);
+	if (error)
+		airoha_bank1_routes_revoke_locked(eth);
 unlock:
 	spin_unlock_bh(&eth->ct_route_lock);
 	return error;
@@ -66,7 +123,7 @@
 		error = -ESTALE;
 		goto unlock;
 	}
-	if (airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1)) ||
+	if (routes->pon_open || airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1)) ||
 	    (airoha_fe_rr(eth, REG_PPE_GLO_CFG(1)) & PPE_GLO_CFG_BUSY_MASK)) {
 		error = -EBUSY;
 		goto unlock;
@@ -78,6 +135,7 @@
 		goto unlock;
 	}
 	routes->owner = NULL;
+	routes->revoked = false;
 	memset(routes->desired, 0, sizeof(routes->desired));
 unlock:
 	spin_unlock_bh(&eth->ct_route_lock);
