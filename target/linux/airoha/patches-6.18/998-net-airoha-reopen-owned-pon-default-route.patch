From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: reopen only the owned PON default route

Keep exclusive bank1 route ownership while admitting GDM2. Revoke the
opening before route or QDMA changes and retain CPU fallback on errors.
Roll back QDMA publication when its guarded route cannot be updated,
preserving queue state, shared LRO and the previous WAN role.

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -858,7 +858,7 @@
 struct airoha_bank1_routes {
 	const void *owner;
 	u16 desired[AIROHA_MAX_NUM_GDM_PORTS];
-	bool ready;
+	bool ready, pon_open, revoked;
 };
 
 struct airoha_eth {
@@ -996,6 +996,7 @@
 			     u32 mask, u32 value);
 int airoha_bank1_routes_claim(struct airoha_eth *eth, const void *owner);
 int airoha_bank1_routes_release(struct airoha_eth *eth, const void *owner);
+int airoha_bank1_routes_open(struct airoha_eth *eth, const void *owner);
 int airoha_ct_cpu_fallback(struct airoha_eth *eth);
 int airoha_ppe_npu_owner_claim_locked(struct airoha_eth *eth, u64 generation);
