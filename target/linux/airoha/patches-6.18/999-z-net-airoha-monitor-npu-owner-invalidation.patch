+static int airoha_npu_owner_invalidate(struct airoha_ppe *ppe)
+{
+	struct airoha_npu_owner *owner = ppe->ct_npu_owner;
+	struct npu_gate_message message = {
+		.w = {
+			[GM_MAGIC] = GATE_MAGIC,
+			[GM_ABI_OP] = GATE_ABI | GATE_CLOSE << 16,
+			[GM_BYTES] = GATE_BYTES,
+			[GM_STATUS] = (gate_u32)-EINPROGRESS,
+		},
+	};
+	struct airoha_npu *npu;
+	int error, gate_error;
+
+	lockdep_assert_held(&ppe_lock);
+	if (!owner)
+		return 0;
+	WRITE_ONCE(owner->invalidated, true);
+	owner->close_pending = true;
+	if (owner->invalidation_seq != U64_MAX)
+		owner->invalidation_seq++;
+	error = airoha_bank1_routes_revoke(ppe->eth, owner);
+	if (!owner->closed_ack) {
+		message.w[GM_EPOCH] = owner->gate_id.epoch;
+		message.w[GM_GENERATION] = owner->gate_id.generation;
+		rcu_read_lock();
+		npu = rcu_dereference(ppe->eth->npu);
+		gate_error = npu ? airoha_npu_gate_command(npu, &message) : -ENODEV;
+		rcu_read_unlock();
+		if (!error)
+			error = gate_error;
+	}
+	if (!owner->retiring)
+		schedule_delayed_work(&owner->health_work, msecs_to_jiffies(100));
+	return error;
+}
 
