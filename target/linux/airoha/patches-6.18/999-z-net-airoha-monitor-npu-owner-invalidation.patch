+#ifndef AIROHA_NPU_HEALTH_H
+#define AIROHA_NPU_HEALTH_H
+
+static int airoha_npu_owner_health_check(struct airoha_npu_owner *owner)
+{
+	struct npu_gate_message gate = {
+		.w = {
+			[GM_MAGIC] = GATE_MAGIC,
+			[GM_ABI_OP] = GATE_ABI | GATE_QUERY << 16,
+			[GM_BYTES] = GATE_BYTES,
+			[GM_STATUS] = (gate_u32)-EINPROGRESS,
+		},
+	};
+	struct npu_auth_message auth = {
+		.w = {
+			[AM_MAGIC] = AUTH_MBOX_MAGIC,
+			[AM_ABI_OP] = AUTH_MBOX_ABI | AUTH_MBOX_QUERY << 16,
+			[AM_BYTES] = AUTH_MBOX_BYTES,
+			[AM_STATUS] = (auth_u32)-EINPROGRESS,
+		},
+	};
+	const struct airoha_npu_txn_identity *id = &owner->txn.id;
+	int error;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (READ_ONCE(owner->ppe->eth->ct_cpu_fallback))
+		return -EIO;
+	if (!owner->return_path)
+		return owner->txn.phase == NPU_TXN_CLOSED ? 0 : -EBUSY;
+	error = owner->txn.phase == NPU_TXN_OPEN ?
+		airoha_npu_owner_open_check(owner, id, NPU_TXN_OPEN) :
+		airoha_npu_owner_return_state(owner, id, owner->txn.phase);
+	if (error || owner->txn.phase != NPU_TXN_OPEN)
+		return error;
+	error = airoha_npu_owner_gate(owner, &gate);
+	if (error)
+		return error;
+	if (gate.w[GM_STATE_EPOCH] != id->epoch ||
+	    gate.w[GM_STATE_GENERATION] != id->generation ||
+	    gate.w[GM_MASK] != id->open_mask || gate.w[GM_CLOSED] ||
+	    gate.w[GM_QUIET_ACK] || gate.w[GM_FAULT] ||
+	    gate.w[GM_FE_ENABLED] != 1 || gate.w[GM_FE_QUIESCED] ||
+	    gate.w[GM_ER_STATE] == ER_FAULT || !(gate.w[GM_ER_FLAGS] & GATE_ER_BOUND) ||
+	    gate.w[GM_AUTH_EPOCH] != id->epoch ||
+	    gate.w[GM_AUTH_GENERATION] != id->generation || gate.w[GM_AUTH_ENABLED] != 1)
+		return -ESTALE;
+	error = airoha_npu_owner_auth(owner, &auth);
+	if (error)
+		return error;
+	if (auth.w[AM_STATE_EPOCH] != id->epoch ||
+	    auth.w[AM_STATE_GENERATION] != id->generation ||
+	    auth.w[AM_COUNT] != owner->auth_count || auth.w[AM_ENABLED] != 1)
+		return -ESTALE;
+	return airoha_npu_owner_open_check(owner, id, NPU_TXN_OPEN);
+}
+
+static void airoha_npu_owner_health_work(struct work_struct *work)
+{
+	struct airoha_npu_owner *owner =
+		container_of(to_delayed_work(work), struct airoha_npu_owner, health_work);
+	struct airoha_ppe *ppe = owner->ppe;
+	u64 invalidation_seq;
+	bool invalidated, close_pending;
+	int error, route_error;
+
+	if (!mutex_trylock(&flow_offload_mutex))
+		goto requeue;
+	if (READ_ONCE(ppe->eth->ct_cpu_fallback) &&
+	    (!READ_ONCE(ppe->eth->ct_cpu_routes_ready) ||
+	     !READ_ONCE(ppe->eth->ct_cpu_ifc_disabled)))
+		airoha_ct_cpu_fallback(ppe->eth);
+	spin_lock_bh(&ppe_lock);
+	invalidated = owner->invalidated;
+	close_pending = owner->close_pending;
+	spin_unlock_bh(&ppe_lock);
+	if (invalidated)
+		error = close_pending ? -ESTALE : 0;
+	else
+		error = airoha_npu_owner_health_check(owner);
+	if (error) {
+		spin_lock_bh(&ppe_lock);
+		if (!owner->invalidated)
+			airoha_npu_owner_invalidate(ppe);
+		invalidation_seq = owner->invalidation_seq;
+		spin_unlock_bh(&ppe_lock);
+		error = airoha_ppe_npu_owner_close_locked(ppe->eth);
+		route_error = airoha_bank1_routes_revoke(ppe->eth, owner);
+		if (!error)
+			error = route_error;
+		owner->txn.last_error = error;
+		spin_lock_bh(&ppe_lock);
+		if (!error && owner->invalidation_seq == invalidation_seq)
+			owner->close_pending = false;
+		spin_unlock_bh(&ppe_lock);
+	}
+	mutex_unlock(&flow_offload_mutex);
+requeue:
+	spin_lock_bh(&ppe_lock);
+	if (!owner->retiring)
+		schedule_delayed_work(&owner->health_work, msecs_to_jiffies(100));
+	spin_unlock_bh(&ppe_lock);
+}
+
+#endif
