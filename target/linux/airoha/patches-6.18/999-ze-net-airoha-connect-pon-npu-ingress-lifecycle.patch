+#ifndef AIROHA_NPU_INGRESS_OWNER_H
+#define AIROHA_NPU_INGRESS_OWNER_H
+
+static int airoha_npu_owner_ingress_read(void *ctx, unsigned int bank,
+					 unsigned int row, unsigned int page,
+					 u32 *words, unsigned int count)
+{
+	struct airoha_npu_owner *owner = ctx;
+	int error;
+
+	error = airoha_ct_fe_table(owner->ppe, bank, row, page, false, words, count);
+	if (error)
+		owner->ingress.pending = true;
+	return error;
+}
+
+static int airoha_npu_owner_ingress_put(void *ctx, unsigned int bank,
+					unsigned int row, unsigned int page,
+					const u32 *words, unsigned int count)
+{
+	struct airoha_npu_owner *owner = ctx;
+	u32 copy[3], actual[3];
+	int error;
+
+	if (!count || count > ARRAY_SIZE(copy))
+		return -EINVAL;
+	memcpy(copy, words, count * sizeof(*words));
+	error = airoha_ct_fe_table(owner->ppe, bank, row, page, true, copy, count);
+	if (!error)
+		error = airoha_npu_owner_ingress_read(ctx, bank, row, page, actual, count);
+	if (!error && memcmp(actual, words, count * sizeof(*words)))
+		error = -EIO;
+	if (error)
+		owner->ingress.pending = true;
+	return error;
+}
+
+static int airoha_npu_owner_ingress_drain(void *ctx)
+{
+	struct airoha_npu_owner *owner = ctx;
+
+	return airoha_ct_ifc_command_drain(owner->ppe->eth);
+}
+
+static struct airoha_ct_pon_ifc_io airoha_npu_owner_ingress_io(struct airoha_npu_owner *owner)
+{
+	return (struct airoha_ct_pon_ifc_io) {
+		.ctx = owner,
+		.read = airoha_npu_owner_ingress_read,
+		.put = airoha_npu_owner_ingress_put,
+		.drain = airoha_npu_owner_ingress_drain,
+	};
+}
+
+static int airoha_npu_owner_ingress_dependencies(struct airoha_npu_owner *owner,
+						const struct airoha_ct_pon_ifc_io *io,
+						unsigned int short_lut[2])
+{
+	struct airoha_ppe *ppe = owner->ppe;
+	unsigned int family;
+	int error;
+
+	lockdep_assert_held(&ppe_lock);
+	if (ppe->ct_npu_owner != owner || owner->invalidated || !ppe->ct_ifc.cfg_owned ||
+	    !ppe->ct_host_ppe || ppe->ct_stopping || ppe->eth->ct_cpu_fallback ||
+	    ppe->eth->ct_ifc_cpu_port_failed || airoha_ct_pon_ifc_busy(ppe) ||
+	    !airoha_ct_pon_ifc_route_ready(ppe))
+		return -ESHUTDOWN;
+	error = airoha_ct_pon_ifc_sync(&owner->ingress, io);
+	if (error)
+		return error;
+	for (family = 0; family < 2; ++family)
+		short_lut[family] = ppe->ct_ifc.rule[family].lut_index;
+	if (short_lut[0] == short_lut[1])
+		return -EUCLEAN;
+	return airoha_ct_pon_ifc_dependencies_io(ppe, io);
+}
+
+static int airoha_npu_owner_ingress_prepare(struct airoha_npu_owner *owner)
+{
+	struct airoha_ct_pon_ifc_io io = airoha_npu_owner_ingress_io(owner);
+	unsigned int short_lut[2];
+	int error;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	error = airoha_bank1_routes_check(owner->ppe->eth, owner, false);
+	if (error)
+		return error;
+	spin_lock_bh(&ppe_lock);
+	error = airoha_npu_owner_ingress_dependencies(owner, &io, short_lut);
+	if (!error)
+		error = airoha_npu_ingress_prepare(&owner->ingress, &io, short_lut);
+	spin_unlock_bh(&ppe_lock);
+	return error;
+}
+
+static int airoha_npu_owner_ingress_check(struct airoha_npu_owner *owner)
+{
+	struct airoha_ct_pon_ifc_io io = airoha_npu_owner_ingress_io(owner);
+	unsigned int short_lut[2];
+	int error;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	spin_lock_bh(&ppe_lock);
