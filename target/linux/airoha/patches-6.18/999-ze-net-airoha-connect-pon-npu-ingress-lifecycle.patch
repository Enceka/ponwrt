+static int airoha_bank1_scope_locked(struct airoha_eth *eth, bool enable)
+{
+	u32 scope, ports;
+	int error = 0;
+
+	lockdep_assert_held(&eth->ct_route_lock);
+	spin_lock_bh(&eth->ifc_port_lock);
+	scope = eth->ct_ifc_port_mask;
+	if (enable) {
+		if (scope != XSI_ETH_VIP_PORT_MASK || !eth->ppe->ct_ifc.cfg_owned ||
+		    !(airoha_fe_rr(eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK) ||
+		    (eth->ifc_port_desired & (XSI_ETH_VIP_PORT_MASK | BIT(2))) !=
+		    (XSI_ETH_VIP_PORT_MASK | BIT(2)) || eth->ct_ifc_cpu_port_failed) {
+			error = -ESHUTDOWN;
+			goto unlock;
+		}
+		if (airoha_fe_rr(eth, REG_FE_IFC_PORT_EN) != (eth->ifc_port_desired & scope)) {
+			error = -EUCLEAN;
+			goto unlock;
+		}
+		scope |= BIT(2);
+	} else {
+		eth->ct_bank1_routes.ingress_ready = false;
+		eth->ct_ifc_pon_ready = false;
+		if (!scope) {
+			error = (airoha_fe_rr(eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK) ? -EIO : 0;
+			goto unlock;
+		}
+		scope &= XSI_ETH_VIP_PORT_MASK;
+		eth->ct_ifc_port_mask = scope;
+	}
+	ports = eth->ifc_port_desired & scope;
+	airoha_fe_wr(eth, REG_FE_IFC_PORT_EN, ports);
+	if (airoha_fe_rr(eth, REG_FE_IFC_PORT_EN) != ports) {
+		error = -EIO;
+		goto unlock;
+	}
+	eth->ct_ifc_port_mask = scope;
+	eth->ct_ifc_pon_ready = enable;
+unlock:
+	spin_unlock_bh(&eth->ifc_port_lock);
+	return error;
+}
 
