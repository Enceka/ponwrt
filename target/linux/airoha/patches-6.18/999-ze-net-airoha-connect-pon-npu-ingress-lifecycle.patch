+int airoha_bank1_routes_check(struct airoha_eth *eth, const void *owner, bool opened)
+{
+	struct airoha_bank1_routes *routes;
+	u32 scope, ports;
+	int error = 0;
+
+	if (!eth || !eth->ppe || !owner)
+		return -EINVAL;
+	spin_lock_bh(&eth->ct_route_lock);
+	routes = &eth->ct_bank1_routes;
+	if (routes->owner != owner || !routes->ready || routes->revoked ||
+	    routes->pon_open != opened) {
+		error = -ESTALE;
+		goto unlock;
+	}
+	if ((airoha_fe_rr(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX)) & GENMASK(15, 0)) !=
+	    FE_PSE_PORT_CDM2 * 0x1111 ||
+	    airoha_ct_gdm_cpu_locked(eth, AIROHA_GDM2_IDX) != FE_PSE_PORT_CDM2) {
+		error = -EXDEV;
+		goto unlock;
+	}
+	spin_lock_bh(&eth->ifc_port_lock);
+	scope = XSI_ETH_VIP_PORT_MASK | (opened ? BIT(2) : 0);
+	ports = eth->ifc_port_desired & scope;
+	if (eth->ct_ifc_port_mask != scope ||
+	    airoha_fe_rr(eth, REG_FE_IFC_PORT_EN) != ports ||
+	    (opened && (!routes->ingress_ready || !eth->ct_ifc_pon_ready ||
+			(ports & scope) != scope || !eth->ppe->ct_ifc.cfg_owned ||
+			!(airoha_fe_rr(eth, REG_FE_CSR_IFC_CFG) & FE_IFC_EN_MASK))))
+		error = -EUCLEAN;
+	spin_unlock_bh(&eth->ifc_port_lock);
+unlock:
+	spin_unlock_bh(&eth->ct_route_lock);
+	return error;
+}
+
+int airoha_bank1_routes_ingress_ready(struct airoha_eth *eth, const void *owner)
+{
+	int error;
+
+	if (!eth || !owner)
+		return -EINVAL;
+	lockdep_assert_held(&flow_offload_mutex);
+	error = airoha_bank1_routes_check(eth, owner, false);
+	if (error)
+		return error;
+	spin_lock_bh(&eth->ct_route_lock);
+	if (eth->ct_bank1_routes.owner != owner || !eth->ct_bank1_routes.ready ||
+	    eth->ct_bank1_routes.revoked || eth->ct_bank1_routes.pon_open)
+		error = -ESTALE;
+	else
+		eth->ct_bank1_routes.ingress_ready = true;
+	spin_unlock_bh(&eth->ct_route_lock);
+	return error;
+}
