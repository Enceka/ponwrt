--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_npu_diag.h
@@ -0,0 +1,263 @@
+#ifndef AIROHA_NPU_DIAG_H
+#define AIROHA_NPU_DIAG_H
+
+static bool airoha_npu_diag_platform(struct airoha_ppe *ppe)
+{
+	static const char * const disabled[] = {
+		"/soc/nand-controller@1fa11000", "/soc/ethernet@1fb64000",
+	};
+	struct device_node *node;
+	unsigned int index;
+	u32 gpios[2];
+	bool valid;
+
+	if (!of_machine_is_compatible("fiberhome,hg5585f-ct") ||
+	    !of_property_read_bool(ppe->eth->dev->of_node, "airoha,connac2-pon-er-diagnostic") ||
+	    !of_property_read_bool(ppe->eth->dev->of_node, "airoha,connac2-ram-native-pairs") ||
+	    ppe->eth->ct_ordinary_full_test || ppe->ct_pon_qualified || ppe->ct_pair_policy_allowed)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(disabled); ++index) {
+		node = of_find_node_by_path(disabled[index]);
+		valid = node && !of_device_is_available(node);
+		of_node_put(node);
+		if (!valid)
+			return false;
+	}
+	node = of_find_node_by_path("/soc/system-controller@1fbf0200/pinctrl/ram-tx-disable-hog");
+	valid = node && of_device_is_available(node) && of_property_read_bool(node, "gpio-hog") &&
+		of_property_read_bool(node, "output-high") &&
+		of_property_count_u32_elems(node, "gpios") == 2 &&
+		!of_property_read_u32_array(node, "gpios", gpios, ARRAY_SIZE(gpios)) &&
+		gpios[0] == 38 && !gpios[1];
+	of_node_put(node);
+	if (!valid)
+		return false;
+	for_each_compatible_node(node, NULL, "airoha,en7581-snand") {
+		if (of_device_is_available(node)) {
+			of_node_put(node);
+			return false;
+		}
+	}
+	return true;
+}
+
+static int airoha_npu_diag_start(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+	struct airoha_npu_owner *owner;
+	struct airoha_gdm_dev *dev;
+	struct net_device *lower;
+	int error;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!airoha_npu_diag_platform(ppe))
+		return -EPERM;
+	if (ppe->ct_npu_owner || ppe->ct_pair_failed || ppe->ct_stopping ||
+	    eth->ct_cpu_fallback || eth->ct_ifc_cpu_port_failed ||
+	    eth->pon_update_owner || airoha_ct_pon_ifc_busy(ppe))
+		return -EBUSY;
+	lower = dev_get_by_name(&init_net, "pon0");
+	if (!lower)
+		return -ENODEV;
+	if (lower->dev.parent != eth->dev) {
+		error = -EXDEV;
+		goto put;
+	}
+	dev = netdev_priv(lower);
+	if (!airoha_is_valid_gdm_dev(eth, dev) || dev->port->id != AIROHA_GDM2_IDX || dev->nbq ||
+	    !test_bit(AIROHA_DEV_F_PON, &dev->flags) || !dev->pon_link_ops || !dev->pon_link_priv ||
+	    !netif_running(lower) || !netif_carrier_ok(lower) || dev->pon_update_blocked ||
+	    dev->pon_qdma_tag || !rcu_access_pointer(dev->pon_flow_table) ||
+	    rcu_access_pointer(dev->qdma) != &eth->qdma[1] || atomic_read(&dev->pon_tx_pending) ||
+	    !(airoha_fe_rr(eth, REG_GDM_LPBK_CFG(2)) & LPBK_EN_MASK)) {
+		error = -EBUSY;
+		goto put;
+	}
+	error = airoha_ppe_npu_owner_claim_locked(eth, br_flow_offload_generation());
+	owner = ppe->ct_npu_owner;
+	if (!owner)
+		goto put;
+	owner->diag_lower = lower;
+	owner->diag_controller = dev->pon_link_ops;
+	owner->diag_priv = dev->pon_link_priv;
+	if (error)
+		goto out;
+	error = airoha_ppe_npu_return_prepare_locked(eth, dev, 8);
+	if (error)
+		goto out;
+	airoha_er_enable_observation(owner->return_path->ring);
+	error = airoha_npu_owner_return_ready(owner, &owner->txn.id);
+	if (error)
+		goto out;
+	if (!airoha_ppe_npu_diag_active(ppe, owner)) {
+		error = -ESTALE;
+		goto out;
+	}
+	owner->auth_attempted = true;
+	owner->epoch_dirty = true;
+	error = airoha_npu_auth_publish_step(owner->txn.id.epoch, owner->txn.id.generation,
+			AUTH_MBOX_BEGIN, NULL, 0, airoha_npu_owner_auth, owner);
+	if (!error)
+		error = airoha_npu_auth_publish_step(owner->txn.id.epoch, owner->txn.id.generation,
+				AUTH_MBOX_ARM, NULL, 0, airoha_npu_owner_auth, owner);
+	if (!error)
+		error = airoha_ppe_npu_owner_open_locked(eth);
+out:
+	owner->txn.last_error = error;
+	return error;
+put:
+	dev_put(lower);
+	return error;
+}
+
+static void airoha_npu_diag_snapshot(struct airoha_npu_owner *owner)
+{
+	if (!owner->return_path || !owner->return_path->ring)
+		return;
+	airoha_er_get_stats(owner->return_path->ring, &owner->diag_stats);
+	airoha_er_observe(owner->return_path->ring, &owner->diag_observation);
+}
+
+static int airoha_npu_diag_close(struct airoha_ppe *ppe, bool release)
+{
+	struct airoha_npu_owner *owner = ppe->ct_npu_owner;
+	struct airoha_eth *eth = ppe->eth;
+	int error;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!owner)
+		return 0;
+	if (!owner->diag_lower)
+		return -EBUSY;
+	airoha_npu_diag_snapshot(owner);
+	error = airoha_ppe_npu_owner_close_locked(eth);
+	if (error || !release)
+		return error;
+	if (owner->return_path || !owner->closed_ack || !owner->bank1_saved ||
+	    !owner->bank1_host_retired || owner->bank1_next_row != PPE_SRAM_NUM_ENTRIES ||
+	    owner->ingress.saved_valid || owner->ingress.dirty ||
+	    owner->ingress.active || owner->ingress.pending)
+		return -EBUSY;
+	if (eth->ct_bank1_routes.owner) {
+		error = airoha_bank1_routes_release(eth, owner);
+		if (error)
+			return error;
+	}
+	spin_lock_bh(&ppe_lock);
+	airoha_fe_wr(eth, REG_PPE_TB_CFG(1), owner->bank1_tb);
+	if (airoha_fe_rr(eth, REG_PPE_TB_CFG(1)) != owner->bank1_tb) {
+		error = -EIO;
+	} else {
+		airoha_fe_wr(eth, REG_PPE_PPE_FLOW_CFG(1), owner->bank1_flow);
+		error = airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1)) == owner->bank1_flow ? 0 : -EIO;
+	}
+	spin_unlock_bh(&ppe_lock);
+	return error ?: airoha_npu_owner_retire_locked(ppe);
+}
+
+static int airoha_npu_diag_show(struct seq_file *stream, void *unused)
+{
+	struct airoha_ppe *ppe = stream->private;
+	struct airoha_eth *eth = ppe->eth;
+	struct airoha_npu_owner *owner;
+	struct airoha_npu *npu;
+	struct npu_gate_message gate = { .w = {
+		[GM_MAGIC] = GATE_MAGIC, [GM_ABI_OP] = GATE_ABI | GATE_QUERY << 16,
+		[GM_BYTES] = GATE_BYTES, [GM_STATUS] = (u32)-EINPROGRESS } };
+	struct npu_auth_message auth = { .w = {
+		[AM_MAGIC] = AUTH_MBOX_MAGIC, [AM_ABI_OP] = AUTH_MBOX_ABI | AUTH_MBOX_QUERY << 16,
+		[AM_BYTES] = AUTH_MBOX_BYTES, [AM_STATUS] = (u32)-EINPROGRESS } };
+	struct er_message er = { .w = { ER_MAGIC, ER_ABI | ER_QUERY << 16,
+		0, 0, 0, 0, 0, 0, (u32)-EINPROGRESS } };
+	int gate_error, auth_error, er_error;
+	unsigned int index;
+
+	mutex_lock(&flow_offload_mutex);
+	owner = ppe->ct_npu_owner;
+	seq_printf(stream, "owner=%u diagnostic=%u qualified=%u policy=%u fallback=%u route_owner=%u fe_owner=%u\n",
+		!!owner, owner && !!owner->diag_lower, ppe->ct_pon_qualified,
+		ppe->ct_pair_policy_allowed, eth->ct_cpu_fallback, !!eth->ct_bank1_routes.owner,
+		!!ppe->ct_fe.owner);
+	seq_printf(stream, "flow=%08x tb=%08x gdm2=%08x scope=%08x ports=%08x ingress=%u\n",
+		airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1)), airoha_fe_rr(eth, REG_PPE_TB_CFG(1)),
+		airoha_fe_rr(eth, REG_GDM_FWD_CFG(2)), eth->ct_ifc_port_mask,
+		airoha_fe_rr(eth, REG_FE_IFC_PORT_EN), eth->ct_ifc_pon_ready);
+	npu = rcu_dereference_protected(eth->npu, lockdep_is_held(&flow_offload_mutex));
+	gate_error = npu ? airoha_npu_gate_command(npu, &gate) : -ENODEV;
+	auth_error = npu ? airoha_npu_auth_command(npu, &auth) : -ENODEV;
+	er_error = npu ? airoha_npu_er_command(npu, &er) : -ENODEV;
+	seq_printf(stream, "gate_error=%d gate_caps=%u gate_epoch=%u gate_generation=%u gate_mask=%u gate_closed=%u gate_quiet=%u gate_fault=%u\n",
+		gate_error, gate.w[GM_CAPS], gate.w[GM_STATE_EPOCH], gate.w[GM_STATE_GENERATION],
+		gate.w[GM_MASK], gate.w[GM_CLOSED], gate.w[GM_QUIET_ACK], gate.w[GM_FAULT]);
+	seq_printf(stream, "auth_error=%d auth_caps=%u auth_epoch=%u auth_generation=%u auth_count=%u auth_enabled=%u auth_inflight=%u er_error=%d er_caps=%u er_state=%u er_fault=%u\n",
+		auth_error, auth.w[AM_CAPS], auth.w[AM_STATE_EPOCH], auth.w[AM_STATE_GENERATION],
+		auth.w[AM_COUNT], auth.w[AM_ENABLED], auth.w[AM_INFLIGHT],
+		er_error, er.w[9], er.w[10], er.w[12]);
+	if (owner && owner->diag_lower) {
+		struct airoha_er_observation *observation = &owner->diag_observation;
+		struct airoha_er_stats *stats = &owner->diag_stats;
+
+		airoha_npu_diag_snapshot(owner);
+		seq_printf(stream, "phase=%u error=%d epoch=%u generation=%u invalidated=%u closed_ack=%u saved_flow=%08x saved_tb=%08x ring=%u\n",
+			owner->txn.phase, owner->txn.last_error, owner->txn.id.epoch, owner->txn.id.generation,
+			owner->invalidated, owner->closed_ack, owner->bank1_flow, owner->bank1_tb,
+			owner->return_path && !!owner->return_path->ring);
+		seq_printf(stream, "packets=%llu bytes=%llu dropped=%llu consumed=%u fault=%u observed_produced=%u observed_consumed=%u frame_bytes=%u\n",
+			stats->packets, stats->bytes, stats->dropped, stats->consumed, stats->fault,
+			observation->produced, observation->consumed, observation->frame_bytes);
+		seq_puts(stream, "er_desc=");
+		for (index = 0; index < ARRAY_SIZE(observation->descriptor); ++index)
+			seq_printf(stream, "%s%08x", index ? "/" : "", observation->descriptor[index]);
+		seq_puts(stream, "\ner_frame=");
+		for (index = 0; index < observation->frame_bytes; ++index)
+			seq_printf(stream, "%02x", observation->frame[index]);
+		seq_puts(stream, "\n");
+	}
+	mutex_unlock(&flow_offload_mutex);
+	return 0;
+}
+
+static int airoha_npu_diag_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, airoha_npu_diag_show, inode->i_private);
+}
+
+static ssize_t airoha_npu_diag_write(struct file *file, const char __user *buffer,
+				   size_t count, loff_t *offset)
+{
+	struct airoha_ppe *ppe = ((struct seq_file *)file->private_data)->private;
+	char command[16];
+	int error;
+
+	if (!count || count >= sizeof(command) || copy_from_user(command, buffer, count))
+		return -EINVAL;
+	command[count] = 0;
+	mutex_lock(&flow_offload_mutex);
+	if (sysfs_streq(command, "start"))
+		error = airoha_npu_diag_start(ppe);
+	else if (sysfs_streq(command, "close"))
+		error = airoha_npu_diag_close(ppe, false);
+	else if (sysfs_streq(command, "release"))
+		error = airoha_npu_diag_close(ppe, true);
+	else
+		error = -EINVAL;
+	mutex_unlock(&flow_offload_mutex);
+	return error ?: count;
+}
+
+static const struct file_operations airoha_npu_diag_fops = {
+	.owner = THIS_MODULE,
+	.open = airoha_npu_diag_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+	.write = airoha_npu_diag_write,
+};
+
+static void airoha_npu_diag_init(struct airoha_ppe *ppe)
+{
+	if (of_property_read_bool(ppe->eth->dev->of_node, "airoha,connac2-pon-er-diagnostic"))
+		debugfs_create_file("pon_npu_diag", 0600, ppe->debugfs_dir, ppe, &airoha_npu_diag_fops);
+}
+
