@@ -176,8 +178,8 @@
 	}
 	if (!(airoha_fe_rr(eth, REG_PPE_GLO_CFG(1)) & PPE_GLO_CFG_EN_MASK) ||
 	    (diagnostic ?
-	     airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1)) ||
-	     FIELD_GET(PPE_TB_CFG_SEARCH_MISS_MASK, airoha_fe_rr(eth, REG_PPE_TB_CFG(1))) != 2 ||
+	     airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1)) != diagnostic_flow ||
+	     FIELD_GET(PPE_TB_CFG_SEARCH_MISS_MASK, airoha_fe_rr(eth, REG_PPE_TB_CFG(1))) != (diagnostic_flow ? 3 : 2) ||
 	     (airoha_fe_rr(eth, REG_PPE_GLO_CFG(1)) & PPE_GLO_CFG_BUSY_MASK) :
 	     !airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1)))) {
 		error = -EIO;
