 	int err = 0;
 
-	if (ppe->ct_npu_owner && hash >= PPE_SRAM_NUM_ENTRIES &&
-	    hash < 2 * PPE_SRAM_NUM_ENTRIES &&
+	if (ppe->ct_npu_owner &&
+	    ((hash >= PPE_SRAM_NUM_ENTRIES && hash < 2 * PPE_SRAM_NUM_ENTRIES) ||
+	     (hash < PPE_SRAM_NUM_ENTRIES &&
+	      airoha_ppe_npu_diag_flow(ppe, ppe->ct_npu_owner))) &&
 	    FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, e->ib1) == AIROHA_FOE_STATE_BIND)
 		return -EBUSY;
 
@@ -1697,7 +1699,9 @@
 
 	if (ppe->ct_host_ppe &&
 	    (hash >= airoha_ppe_get_total_sram_num_entries(ppe) ||
-	     (ppe->ct_npu_owner && hash >= PPE_SRAM_NUM_ENTRIES)))
+	     (ppe->ct_npu_owner &&
+	      (hash >= PPE_SRAM_NUM_ENTRIES ||
+	       airoha_ppe_npu_diag_flow(ppe, ppe->ct_npu_owner)))))
 		goto unlock;
 	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
 	if (!hwe)
