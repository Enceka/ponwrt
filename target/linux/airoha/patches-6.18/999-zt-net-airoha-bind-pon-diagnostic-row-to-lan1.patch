+static int airoha_npu_diag_bank0_drain(struct airoha_npu_owner *owner)
+{
+	struct airoha_eth *eth = owner->ppe->eth;
+	u32 status, no_foe = FIELD_PREP(PPE_TB_CFG_SEARCH_MISS_MASK, 2);
+	int error;
+
+	spin_lock_bh(&ppe_lock);
+	if (!owner->bank0_saved) {
+		owner->bank0_flow = airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(0));
+		owner->bank0_tb = airoha_fe_rr(eth, REG_PPE_TB_CFG(0));
+		owner->bank0_saved = true;
+	}
+	airoha_fe_rmw(eth, REG_PPE_TB_CFG(0), PPE_TB_CFG_SEARCH_MISS_MASK, no_foe);
+	airoha_fe_wr(eth, REG_PPE_PPE_FLOW_CFG(0), 0);
+	if (airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(0)) ||
+	    (airoha_fe_rr(eth, REG_PPE_TB_CFG(0)) & PPE_TB_CFG_SEARCH_MISS_MASK) != no_foe) {
+		error = -EIO;
+		goto unlock;
+	}
+	error = read_poll_timeout_atomic(airoha_fe_rr, status,
+					 !(status & PPE_GLO_CFG_BUSY_MASK),
+					 10, 100000, false, eth, REG_PPE_GLO_CFG(0));
+	if (!error && !(status & PPE_GLO_CFG_EN_MASK))
+		error = -EIO;
+unlock:
+	spin_unlock_bh(&ppe_lock);
+	if (!error)
+		error = airoha_ppe_bank0_clear_rows(owner->ppe, &owner->bank0_next_row);
+	return error;
+}
+
