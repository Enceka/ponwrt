+static int airoha_npu_diag_bind(struct airoha_ppe *ppe, u32 hash,
+			      __be32 destination, const u8 *address)
+{
+	struct airoha_npu_owner *owner = ppe->ct_npu_owner;
+	struct airoha_eth *eth = ppe->eth;
+	struct airoha_flow_data data = {};
+	struct airoha_foe_entry bound, *learned;
+	struct airoha_gdm_dev *egress;
+	struct net_device *netdev;
+	u32 ip = ntohl(destination);
+	int error;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!owner || !owner->diag_auth || !owner->diag_learn || owner->diag_bound ||
+	    owner->diag_egress || owner->txn.phase != NPU_TXN_OPEN ||
+	    !airoha_ppe_npu_diag_active(ppe, owner) || !airoha_npu_diag_platform(ppe))
+		return -EBUSY;
+	if (!airoha_ppe_bank0_hash(hash) || !is_valid_ether_addr(address) ||
+	    !(ip >> 24) || ip >> 24 == 127 || ip >= 0xe0000000)
+		return -EINVAL;
+	error = airoha_npu_owner_open_check(owner, &owner->txn.id, NPU_TXN_OPEN);
+	if (error)
+		return error;
+	netdev = dev_get_by_name(&init_net, "lan1");
+	if (!netdev)
+		return -ENODEV;
+	egress = netdev_priv(netdev);
+	if (netdev->dev.parent != eth->dev || !airoha_is_valid_gdm_dev(eth, egress) ||
+	    egress->port->id != 4 || egress->nbq ||
+	    !netif_running(netdev) || !netif_carrier_ok(netdev)) {
+		error = -ENETDOWN;
+		goto put;
+	}
+	ether_addr_copy(data.eth.h_source, netdev->dev_addr);
+	ether_addr_copy(data.eth.h_dest, address);
+	data.v4.src_addr = htonl(0xc0000201);
+	data.v4.dst_addr = htonl(0xc0000202);
+	data.src_port = htons(49152);
+	data.dst_port = htons(49153);
+	error = airoha_ppe_foe_entry_prepare(eth, &bound, netdev, PPE_PKT_TYPE_IPV4_HNAPT,
+					   &data, IPPROTO_UDP, 0, &egress);
+	if (error)
+		goto put;
+	error = airoha_ppe_foe_entry_set_ipv4_tuple(&bound, &data, false);
+	if (error)
+		goto put;
+	data.v4.dst_addr = destination;
+	error = airoha_ppe_foe_entry_set_ipv4_tuple(&bound, &data, true);
+	if (error)
+		goto put;
+	bound.ib1 |= AIROHA_FOE_IB1_BIND_STATIC |
+		FIELD_PREP(AIROHA_FOE_IB1_BIND_TIMESTAMP, airoha_ppe_get_timestamp(ppe));
+	spin_lock_bh(&ppe_lock);
+	learned = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!learned)
+		error = -ETIMEDOUT;
+	else if (!airoha_ppe_ct_sram_ack(eth, hash, false))
+		error = -EIO;
+	else if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, learned->ib1) != AIROHA_FOE_STATE_UNBIND ||
+		 ((learned->ib1 ^ bound.ib1) &
+		  (AIROHA_FOE_IB1_BIND_PACKET_TYPE | AIROHA_FOE_IB1_BIND_UDP)) ||
+		 memcmp(&learned->ipv4.orig_tuple, &bound.ipv4.orig_tuple,
+			sizeof(bound.ipv4.orig_tuple)))
+		error = -ESTALE;
+	spin_unlock_bh(&ppe_lock);
+	if (error)
+		goto put;
+	error = airoha_npu_diag_close(ppe, false);
+	if (error)
+		goto put;
+	owner->diag_egress = netdev;
+	owner->diag_hash = hash;
+	owner->diag_entry = bound;
+	owner->diag_bound = true;
+	error = airoha_ppe_npu_return_prepare_locked(eth, netdev_priv(owner->diag_lower), 8);
+	if (!error) {
+		airoha_er_enable_observation(owner->return_path->ring);
+		error = airoha_npu_diag_authorize(owner, owner->diag_service);
+	}
+	if (!error)
+		error = airoha_ppe_npu_owner_open_locked(eth);
+	owner->txn.last_error = error;
+	return error;
+put:
+	dev_put(netdev);
+	return error;
+}
+
+static int airoha_npu_diag_bind_command(struct airoha_ppe *ppe, char *command)
+{
+	char *hash_text = strsep(&command, " ");
+	char *ip_text = strsep(&command, " ");
+	char *mac_text = strsep(&command, " ");
+	const char *end;
+	u8 address[ETH_ALEN];
+	__be32 destination;
+	u32 hash;
+
+	if (!hash_text || !ip_text || !mac_text || command ||
+	    kstrtou32(hash_text, 0, &hash) || strlen(mac_text) != 17 ||
+	    !mac_pton(mac_text, address) ||
+	    !in4_pton(ip_text, -1, (u8 *)&destination, 0, &end) || *end)
+		return -EINVAL;
+	return airoha_npu_diag_bind(ppe, hash, destination, address);
+}
+
