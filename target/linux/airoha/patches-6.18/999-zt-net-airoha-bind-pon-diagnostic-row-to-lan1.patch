+static int airoha_npu_diag_install(struct airoha_npu_owner *owner)
+{
+	const struct airoha_foe_entry invalid = {};
+	struct airoha_ppe *ppe = owner->ppe;
+	struct airoha_foe_entry *entry;
+	int error = 0;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!owner->diag_bound || !owner->diag_auth || !owner->diag_learn ||
+	    !owner->bank0_saved ||
+	    !airoha_ppe_npu_diag_active(ppe, owner) ||
+	    !airoha_ppe_bank0_hash(owner->diag_hash) ||
+	    owner->txn.phase != NPU_TXN_PPE_RESTORE ||
+	    owner->bank0_next_row != PPE_SRAM_NUM_ENTRIES ||
+	    FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, owner->diag_entry.ib1) != AIROHA_FOE_STATE_BIND)
+		return -EINVAL;
+	spin_lock_bh(&ppe_lock);
+	if (owner->invalidated) {
+		spin_unlock_bh(&ppe_lock);
+		return -ESTALE;
+	}
+	entry = airoha_ppe_foe_get_entry_locked(ppe, owner->diag_hash);
+	if (!entry)
+		error = -ETIMEDOUT;
+	else if (!airoha_ppe_ct_sram_ack(ppe->eth, owner->diag_hash, false) ||
+		 memcmp(entry, &invalid, sizeof(invalid)))
+		error = -EIO;
+	if (!error) {
+		owner->bank0_next_row = 0;
+		*entry = owner->diag_entry;
+		error = airoha_ppe_foe_commit_sram_entry(ppe, owner->diag_hash);
+		if (!error && !airoha_ppe_ct_sram_ack(ppe->eth, owner->diag_hash, true))
+			error = -EIO;
+	}
+	if (!error) {
+		entry = airoha_ppe_foe_get_entry_locked(ppe, owner->diag_hash);
+		if (!entry)
+			error = -ETIMEDOUT;
+		else if (!airoha_ppe_ct_sram_ack(ppe->eth, owner->diag_hash, false) ||
+			 memcmp(entry, &owner->diag_entry, sizeof(*entry)))
+			error = -EIO;
+	}
+	spin_unlock_bh(&ppe_lock);
+	return error;
+}
 
