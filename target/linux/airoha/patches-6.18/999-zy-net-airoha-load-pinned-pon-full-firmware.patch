From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: load pinned PON full-image firmware

Select the dualbank-owner payload with an independent PON full-image
profile. Reject mixed rebuilt profiles before probe resources or firmware
requests. Extend native and transaction transport admission, resident
supplier checks and deferred startup to the pinned profile. Keep ordinary
startup and its native-only transport policy, and leave PON qualification
to the Ethernet owner lifecycle.

--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -279,6 +279,46 @@
 					"connac2-pkt") >= 0;
 }
 
+enum airoha_npu_profile {
+	AIROHA_NPU_PROFILE_STOCK,
+	AIROHA_NPU_PROFILE_RAM,
+	AIROHA_NPU_PROFILE_ORDINARY,
+	AIROHA_NPU_PROFILE_PON_FULL,
+};
+
+static int airoha_npu_profile(struct device_node *node)
+{
+	bool ram = of_property_read_bool(node, "airoha,connac2-rebuilt-ram-lab");
+	bool ordinary = of_property_read_bool(node, "airoha,connac2-ordinary-full-test");
+	bool pon = of_property_read_bool(node, "airoha,connac2-pon-full");
+
+	if (ram + ordinary + pon > 1)
+		return -EINVAL;
+	if (pon)
+		return AIROHA_NPU_PROFILE_PON_FULL;
+	if (ordinary)
+		return AIROHA_NPU_PROFILE_ORDINARY;
+	return ram ? AIROHA_NPU_PROFILE_RAM : AIROHA_NPU_PROFILE_STOCK;
+}
+
+static bool airoha_npu_deferred_profile(struct device_node *node)
+{
+	int profile = airoha_npu_profile(node);
+
+	return profile == AIROHA_NPU_PROFILE_RAM || profile == AIROHA_NPU_PROFILE_PON_FULL;
+}
+
+static bool airoha_npu_native_profile(struct device *dev)
+{
+	return airoha_npu_is_connac2_ct(dev) &&
+	       airoha_npu_profile(dev->of_node) > AIROHA_NPU_PROFILE_STOCK;
+}
+
+static bool airoha_npu_transaction_profile(struct device *dev)
+{
+	return airoha_npu_is_connac2_ct(dev) && airoha_npu_deferred_profile(dev->of_node);
+}
