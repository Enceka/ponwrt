+void airoha_ppe_pon_observe_unbound(struct airoha_gdm_dev *dev,
+				    const unsigned char *frame, u32 bytes,
+				    u32 hardware_hash, u32 service)
+{
+	struct airoha_ppe *ppe = dev->eth->ppe;
+	struct airoha_npu_ipv4_identity identity;
+	struct airoha_npu_auth_rule rule;
+	struct airoha_flow_table_entry *entry;
+	struct airoha_pon_flow_table *table;
+	struct airoha_foe_entry tuple = {};
+	unsigned int index, matches = 0;
+	u32 bucket;
+
+	RCU_LOCKDEP_WARN(!rcu_read_lock_held(), "PON event requires RCU");
+	if (!ppe || !ppe->foe_flow || !READ_ONCE(dev->eth->ct_pon_full) ||
+	    READ_ONCE(dev->eth->ct_ordinary_full_test) || READ_ONCE(dev->eth->ct_cpu_fallback) ||
+	    of_property_read_bool(dev->eth->dev->of_node, "airoha,connac2-pon-er-diagnostic") ||
+	    hardware_hash >= PPE_SRAM_NUM_ENTRIES ||
+	    !test_bit(AIROHA_DEV_F_PON, &dev->flags) ||
+	    dev->port->id != AIROHA_GDM2_IDX || dev->nbq ||
+	    rcu_access_pointer(dev->qdma) != &dev->eth->qdma[1] ||
+	    !READ_ONCE(dev->pon_link_ops) || !READ_ONCE(dev->pon_link_priv) ||
+	    (READ_ONCE(dev->pon_qdma_tag) & AIROHA_PON_QDMA_EPON) ||
+	    airoha_npu_ingress_parse_ipv4(frame, bytes, service, &identity) ||
+	    airoha_npu_auth_encode_ipv4(&rule, 1, 1, 1, 0, &identity))
+		return;
+	table = rcu_dereference(dev->pon_flow_table);
+	for (index = 0; table && index < table->count; index++) {
+		u32 tag = table->entries[index].tag;
+
+		if ((tag & AIROHA_PON_QDMA_VALID) && !(tag & AIROHA_PON_QDMA_EPON) &&
+		    FIELD_GET(AIROHA_PON_QDMA_GEM_MASK, tag) == service)
+			matches++;
+	}
+	if (matches != 1)
+		return;
+	tuple.ib1 = FIELD_PREP(AIROHA_FOE_IB1_BIND_PACKET_TYPE, PPE_PKT_TYPE_IPV4_HNAPT);
+	if (identity.protocol == IPPROTO_UDP)
+		tuple.ib1 |= AIROHA_FOE_IB1_BIND_UDP;
+	tuple.ipv4.orig_tuple.src_ip = identity.source_ip;
+	tuple.ipv4.orig_tuple.dest_ip = identity.destination_ip;
+	tuple.ipv4.orig_tuple.src_port = identity.source_port;
+	tuple.ipv4.orig_tuple.dest_port = identity.destination_port;
+	bucket = airoha_ppe_foe_get_entry_hash(ppe, &tuple);
+	spin_lock_bh(&ppe_lock);
+	if (!ppe->ct_host_ppe || !ppe->ct_native_pairs || ppe->ct_stopping ||
+	    !airoha_ppe_ct_pon_dev_ready(dev))
+		goto unlock;
+	hlist_for_each_entry(entry, &ppe->foe_flow[bucket], list) {
+		if (!entry->pon_candidate || !entry->pon_candidate_serial ||
+		    entry->type != FLOW_TYPE_L4 || entry->ct_bridge || entry->hash != 0xffff ||
+		    entry->pon_ingress_dev != dev || !entry->pon_ingress_seen ||
+		    entry->pon_ingress_conflict || entry->pon_ingress_service != service ||
+		    memcmp(entry->pon_ingress_key, rule.raw + 9, sizeof(entry->pon_ingress_key)) ||
+		    !airoha_ppe_foe_compare_entry(entry, &tuple))
+			continue;
+		entry->pon_unbound_event = (struct airoha_pon_unbound_event) {
+			.serial = entry->pon_candidate_serial,
+			.generation = br_flow_offload_generation(),
+			.hardware_hash = hardware_hash,
+			.service = service,
+		};
+		memcpy(entry->pon_unbound_event.key, rule.raw + 9, sizeof(entry->pon_unbound_event.key));
+		break;
+	}
+unlock:
+	spin_unlock_bh(&ppe_lock);
+}
+
+int airoha_ppe_pon_take_unbound(struct airoha_ppe *ppe, unsigned long cookie,
+			      u64 serial, struct airoha_pon_unbound_event *event)
+{
+	struct airoha_pon_candidate_snapshot observed = {};
+	struct airoha_flow_table_entry *entry;
+	int error;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!event || !serial)
+		return -EINVAL;
+	entry = rhashtable_lookup_fast(&ppe->eth->flow_table, &cookie, airoha_flow_table_params);
+	if (!entry)
+		return -ENOENT;
+	spin_lock_bh(&ppe_lock);
+	if (entry->pon_candidate_serial != serial) {
+		error = -ESTALE;
+		goto unlock;
+	}
+	error = airoha_ppe_pon_candidate_read_locked(ppe, entry, &observed);
+	if (error)
+		goto clear;
+	if (!entry->pon_unbound_event.serial) {
+		error = -EAGAIN;
+		goto unlock;
+	}
+	if (entry->pon_unbound_event.serial != serial ||
+	    entry->pon_unbound_event.generation != observed.generation ||
+	    entry->pon_unbound_event.hardware_hash >= PPE_SRAM_NUM_ENTRIES ||
+	    entry->pon_unbound_event.service != observed.service ||
+	    memcmp(entry->pon_unbound_event.key, observed.key, sizeof(observed.key))) {
+		error = -ESTALE;
+		goto clear;
+	}
+	*event = entry->pon_unbound_event;
+clear:
+	memset(&entry->pon_unbound_event, 0, sizeof(entry->pon_unbound_event));
+unlock:
+	spin_unlock_bh(&ppe_lock);
+	return error;
+}
+
 static bool airoha_ppe_ct_flow_bank_matches(struct airoha_ppe *ppe,
 					  struct airoha_flow_table_entry *entry,
 					  u32 hash, bool rx_wlan)
@@ -2023,8 +2135,10 @@
 		}
 		list_add_tail(&e->ct_bridge_node, &ppe->ct_bridge_flows);
 	}
-	if (e->pon_candidate)
+	if (e->pon_candidate) {
+		memset(&e->pon_unbound_event, 0, sizeof(e->pon_unbound_event));
 		e->pon_candidate_serial = ++ppe->pon_candidate_serial;
+	}
 	hlist_add_head(&e->list, &ppe->foe_flow[hash]);
 	spin_unlock_bh(&ppe_lock);
 
