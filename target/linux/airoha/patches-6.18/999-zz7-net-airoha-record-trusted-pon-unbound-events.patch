+static void airoha_qdma_pon_unbound_event(struct airoha_gdm_dev *dev,
+					  struct airoha_queue *queue,
+					  struct sk_buff *skb, u32 msg0, u32 msg1)
+{
+	const unsigned char *frame;
+	u32 hardware_hash = FIELD_GET(AIROHA_RXD4_FOE_ENTRY, msg1);
+	u32 service = FIELD_GET(QDMA_ETH_RXMSG_GEM_MASK, msg0);
+
+	if (FIELD_GET(AIROHA_RXD4_PPE_CPU_REASON, msg1) != PPE_CPU_REASON_HIT_UNBIND_RATE_REACHED ||
+	    hardware_hash >= PPE_SRAM_NUM_ENTRIES ||
+	    FIELD_GET(QDMA_ETH_RXMSG_SPORT_MASK, msg1) != AIROHA_GDM2_IDX ||
+	    (msg1 & (QDMA_ETH_RXMSG_IP4F_MASK | QDMA_ETH_RXMSG_L4F_MASK)) ||
+	    !test_bit(AIROHA_DEV_F_PON, &dev->flags) ||
+	    dev->port->id != AIROHA_GDM2_IDX || dev->nbq ||
+	    queue->qdma != &dev->eth->qdma[1] || airoha_qdma_is_lro_queue(queue) ||
+	    skb->dev != netdev_from_priv(dev) || skb_is_nonlinear(skb) ||
+	    skb_is_gso(skb) || skb_vlan_tag_present(skb) || !skb_mac_header_was_set(skb))
+		return;
+	frame = skb_mac_header(skb);
+	if (frame < skb->head || frame + ETH_HLEN != skb->data)
+		return;
+	rcu_read_lock();
+	if (!(READ_ONCE(dev->pon_qdma_tag) & AIROHA_PON_QDMA_EPON) &&
+	    airoha_qdma_pon_learnable(dev, msg0))
+		airoha_ppe_pon_observe_unbound(dev, frame, skb->len + ETH_HLEN,
+					       hardware_hash, service);
+	rcu_read_unlock();
+}
+
 static void airoha_qdma_learn_skb(struct airoha_gdm_dev *dev,
 				 struct airoha_qdma *rx_qdma,
 				 struct sk_buff *skb, u32 hash, u32 msg0)
@@ -1335,8 +1364,10 @@
 
 		reason = FIELD_GET(AIROHA_RXD4_PPE_CPU_REASON, msg1);
 		airoha_qdma_observe_pon_skb(dev, q->qdma, q->skb, msg0);
-		if (reason == PPE_CPU_REASON_HIT_UNBIND_RATE_REACHED)
+		if (reason == PPE_CPU_REASON_HIT_UNBIND_RATE_REACHED) {
+			airoha_qdma_pon_unbound_event(dev, q, q->skb, msg0, msg1);
 			airoha_qdma_learn_skb(dev, q->qdma, q->skb, hash, msg0);
+		}
 
 		done++;
 		if (test_bit(AIROHA_DEV_F_PON, &dev->flags)) {
