@@ -73,7 +73,7 @@
 	owner = eth->ppe->ct_npu_owner;
 	if (!owner || owner->txn.phase != NPU_TXN_CLOSED || owner->auth_attempted)
 		return -EBUSY;
-	if (owner->diag_lower)
+	if (owner->diag_lower || owner->production.serial)
 		return -EOPNOTSUPP;
 	error = airoha_npu_auth_rules_validate(owner->txn.id.epoch,
 					      owner->txn.id.generation, rules, count);
@@ -123,8 +123,14 @@
 	int error;
 
 	if (!owner->ppe->ct_pon_qualified &&
-	    !airoha_ppe_npu_diag_active(owner->ppe, owner))
+	    !airoha_ppe_npu_diag_active(owner->ppe, owner) &&
+	    !airoha_ppe_npu_production_active(owner->ppe, owner))
 		return -EOPNOTSUPP;
+	if (owner->production.serial) {
+		error = airoha_npu_production_validate(owner);
