--- a/drivers/net/ethernet/airoha/airoha_npu_health.h
+++ b/drivers/net/ethernet/airoha/airoha_npu_health.h
@@ -82,7 +82,13 @@
 		error = close_pending ? -ESTALE : 0;
 	else
 		error = airoha_npu_owner_health_check(owner);
+	if (!error && !invalidated && owner->production.serial &&
