@@ -1036,6 +1036,7 @@
 int airoha_bank1_routes_check(struct airoha_eth *eth, const void *owner, bool opened);
 int airoha_ct_cpu_fallback(struct airoha_eth *eth);
 bool airoha_ppe_npu_diag_active(struct airoha_ppe *ppe, const void *token);
+bool airoha_ppe_npu_production_active(struct airoha_ppe *ppe, const void *token);
 u32 airoha_ppe_npu_diag_flow(struct airoha_ppe *ppe, const void *token);
 int airoha_ppe_npu_owner_claim_locked(struct airoha_eth *eth, u64 generation);
 int airoha_ppe_npu_owner_close_locked(struct airoha_eth *eth);
