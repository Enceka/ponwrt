From: Enceka <enceka@yeah.net>
Subject: [PATCH] net: airoha: run a selected GPON candidate session

Connect trusted downstream learning to the checked Bank0 transaction.
Keep the session explicit and exclusive, and retain cleanup ownership on
failures until withdrawal and register restoration complete.

--- a/drivers/net/ethernet/airoha/airoha_bank1_routes.h
+++ b/drivers/net/ethernet/airoha/airoha_bank1_routes.h
@@ -143,15 +143,17 @@
 int airoha_bank1_routes_open(struct airoha_eth *eth, const void *owner)
 {
 	struct airoha_bank1_routes *routes;
-	u32 diagnostic_flow;
-	bool diagnostic;
+	u32 exclusive_flow;
+	bool exclusive, production;
 	int error;
 
 	if (!eth || !eth->ppe || !owner)
 		return -EINVAL;
 	lockdep_assert_held(&flow_offload_mutex);
-	diagnostic = airoha_ppe_npu_diag_active(eth->ppe, owner);
-	diagnostic_flow = airoha_ppe_npu_diag_flow(eth->ppe, owner);
+	production = airoha_ppe_npu_production_active(eth->ppe, owner);
+	exclusive = production || airoha_ppe_npu_diag_active(eth->ppe, owner);
+	exclusive_flow = production ? PPE_FLOW_CFG_IP4_NAPT_MASK :
+		airoha_ppe_npu_diag_flow(eth->ppe, owner);
 	routes = &eth->ct_bank1_routes;
 	spin_lock_bh(&eth->ct_route_lock);
 	if (routes->owner != owner || !routes->ready || routes->revoked) {
@@ -162,7 +164,7 @@
 		error = -EACCES;
 		goto unlock;
 	}
-	if ((!eth->ppe->ct_pon_qualified && !diagnostic) || eth->ct_ordinary_full_test) {
+	if ((!eth->ppe->ct_pon_qualified && !exclusive) || eth->ct_ordinary_full_test) {
 		error = -EOPNOTSUPP;
 		goto unlock;
 	}
@@ -177,15 +179,15 @@
 		goto unlock;
 	}
 	if (!(airoha_fe_rr(eth, REG_PPE_GLO_CFG(1)) & PPE_GLO_CFG_EN_MASK) ||
-	    (diagnostic ?
+	    (exclusive ?
 	     airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1)) ||
 	     FIELD_GET(PPE_TB_CFG_SEARCH_MISS_MASK, airoha_fe_rr(eth, REG_PPE_TB_CFG(1))) != 2 ||
 	     (airoha_fe_rr(eth, REG_PPE_GLO_CFG(1)) & PPE_GLO_CFG_BUSY_MASK) :
 	     !airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(1))) ||
-	    (diagnostic && diagnostic_flow &&
+	    (exclusive && exclusive_flow &&
 	     (!(airoha_fe_rr(eth, REG_PPE_GLO_CFG(0)) & PPE_GLO_CFG_EN_MASK) ||
 	      (airoha_fe_rr(eth, REG_PPE_GLO_CFG(0)) & PPE_GLO_CFG_BUSY_MASK) ||
-	      airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(0)) != diagnostic_flow ||
+	      airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(0)) != exclusive_flow ||
 	      FIELD_GET(PPE_TB_CFG_SEARCH_MISS_MASK, airoha_fe_rr(eth, REG_PPE_TB_CFG(0))) != 3))) {
 		error = -EIO;
 		goto unlock;
--- a/drivers/net/ethernet/airoha/airoha_ct_cpu_fallback.h
+++ b/drivers/net/ethernet/airoha/airoha_ct_cpu_fallback.h
@@ -152,7 +152,9 @@
 	 */
 	if (id == AIROHA_GDM2_IDX &&
 	    (eth->ct_ordinary_full_test ||
-	     (eth->ct_pon_full && (!eth->ppe || !eth->ppe->ct_pon_qualified))))
+	     (eth->ct_pon_full && (!eth->ppe || (!eth->ppe->ct_pon_qualified &&
+	      !(pon_classify && airoha_ppe_npu_production_active(eth->ppe,
+							      eth->ct_bank1_routes.owner)))))))
 		cfg = airoha_ct_cpu_selectors(cfg, airoha_ct_ppe_selectors(cfg), FE_PSE_PORT_CDM2);
 	airoha_fe_wr(eth, REG_GDM_FWD_CFG(id), cfg);
 	if (airoha_fe_rr(eth, REG_GDM_FWD_CFG(id)) != cfg)
--- a/drivers/net/ethernet/airoha/airoha_eth.h
